#!/usr/bin/env bash
#
# Mirror one package file: read its tag, and unless the tag already holds it,
# download it, check it against the database, push it with its signature, and
# read the push back.
#
#   scripts/mirror-file SHARD.tsv LINE
#
# LINE is a line number of SHARD.tsv, a work line from scripts/plan:
#   target filename tag sha256 csize name action builddate pgpsig
#
# One result line is written to $RESULTS/LINE.tsv as soon as the item ends,
# whatever happens, by the EXIT trap when nothing else wrote it, so an item
# that is killed is still counted, and a shard that runs out of time keeps
# the results of every item that ended:
#   target filename status seconds detail
#
#   pushed    pushed now, and read back holding this file and its signature
#   present   the tag already held them; nothing written
#   replaced  the tag holds other bytes under this name; never overwritten
#   failed    anything else
# A file that the tag now holds with no signature, because upstream publishes
# none for it, is pushed or present with a detail that starts "unsigned: ".
# scripts/stage lists these files in the staged manifest, and scripts/plan
# asks upstream for their .sig again on each run.
#
# ⛔ A package tag is written once (lib.sh decide_push). The promoted database
# or an older snapshot may name the bytes a tag holds, and a consumer handed new
# bytes under an old name gets a file pacman refuses, with no other Server
# tried. A signature that is missing or wrong next to the right package bytes is
# repaired, by pushing again with the same package blob.
#
# ⭐ The signature layer is the database's own %PGPSIG%, decoded, whenever the
# database carries one: pacman checks against that copy, and asks for the .sig
# of the server that served the package and of no other. Without %PGPSIG% the
# detached .sig is downloaded from the target's servers in their own order,
# the db_servers first, as scripts/verify-batch reads it: the layer is the
# signature verify compares it with. It is absent only when every server
# answers 404 for it, and then the file is mirrored unsigned, as upstream
# ships it.
#
# The package file comes from the servers in an order rotated by shard, so
# shards spread across mirrors. A server that fails (lib.sh down_mark) is
# asked last by every file of the shard after it. A .sig read ends within
# 30 s, and a package download within 120 s plus the time at 64 KiB/s.
#
# ⭐ The manifest is the same bytes whoever pushes it: its created annotation is
# the package's %BUILDDATE%, and no annotation names the server the bytes came
# from (the result line does). Two writers of one file push one manifest.
#
# Environment: RESULTS, WORK, ORAS, ORAS_CONFIG, SHARD_INDEX, MIRROR_NAMESPACE,
# REGISTRY_USER, REGISTRY_TOKEN, REGISTRY_TOKEN_CACHE (lib.sh), MIRROR_MIN_RATE
# (bytes per second a push may not fall below; default 2097152). A push
# attempt gets 300 s plus the time at that rate, and never more than 600 s,
# GHCR's limit for one upload. MIRROR_RATE_WAIT (seconds; default 1800) bounds
# the pauses one file takes after a 429 from the registry (below).
#
# Exit status: 0 pushed or present, 1 anything else.
set -euo pipefail
SCRIPT_NAME=mirror-file
# shellcheck source=lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

shard="${1:-}"
line="${2:-}"
[ -f "$shard" ] || die "usage: scripts/mirror-file SHARD.tsv LINE"
case "$line" in
  '' | *[!0-9]* | 0) die "LINE must be a line number, not '$line'" ;;
esac
: "${RESULTS:?}" "${WORK:?}" "${ORAS:?}" "${ORAS_CONFIG:?}"
MIN_RATE="${MIRROR_MIN_RATE:-2097152}"

started="$(date -u +%s)"
result_file="$RESULTS/$line.tsv"
target="unknown"
file="line-$line"

# result STATUS DETAIL: the one line this item leaves behind, keyed by target
# and filename, since two targets can hold files of the same name
result() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$target" "$file" "$1" "$(($(date -u +%s) - started))" "$2" > "$result_file.tmp"
  mv -f -- "$result_file.tmp" "$result_file"
}
# shellcheck disable=SC2329 # run by the EXIT trap
on_exit() {
  local rc=$?
  if [ ! -f "$result_file" ]; then
    result failed "ended with status $rc before recording a result"
  fi
  rm -rf -- "$WORK/items/$line"
}
trap on_exit EXIT

IFS=$'\t' read -r target file tag sha256 csize name _ builddate pgpsig < <(sed -n "${line}p" "$shard")
[ -n "${target:-}" ] && [ -n "${file:-}" ] || die "line $line of $shard is empty"
created="$(iso_of_epoch "${builddate:-}")" || die "line $line of $shard has build date '${builddate:-}', not seconds since the epoch"

conf="$TARGETS_DIR/$target.conf"
target_check "$conf"
arch="$(target_get "$conf" arch)"
repo="$(target_get "$conf" repo)"
repo_path="$(target_repository "$conf")"
ref="$MIRROR_REGISTRY/$repo_path:$tag"

dir="$WORK/items/$line"
rm -rf -- "$dir"
mkdir -p -- "$dir"

#---------------------------------------------------------------------------#
# The servers: the db_servers first. Package files are read in an order
# rotated by shard; in both orders a server that failed comes last.
#---------------------------------------------------------------------------#
mapfile -t servers < <(target_sources "$conf")
n="${#servers[@]}"
[ "$n" -gt 0 ] || die "$conf names no server"
start=$((${SHARD_INDEX:-0} % n))
order=()
for ((i = 0; i < n; i++)); do
  order+=("${servers[$(((start + i) % n))]}")
done
down_dir="$WORK/down"
SIG_MAX_TIME=30

# failed SERVER RC: the server answered with an error, not with the file or a
# 404. Every file of the shard asks it last from now on.
failed() {
  if [ ! -e "$down_dir/$(down_key "$1")" ]; then
    log "$1 failed for $file (status $2); every file of this shard asks it last from now on"
  fi
  down_mark "$down_dir" "$1"
}

# fetch_sig: the detached signature, from every server in the target's order.
# Sets sig_sha, or unsigned=1 when every one answers 404; returns 1 when a
# server failed some other way, because an error is not an absence.
unsigned=0
fetch_sig() {
  local server size rc missing=0 errors=0 sig_order=()
  mapfile -t sig_order < <(down_last "$down_dir" "${servers[@]}")
  for server in "${sig_order[@]}"; do
    rc=0
    fetch_upstream "$server/$file.sig" "$dir/$file.sig" "$SIG_MAX_TIME" || rc=$?
    case "$rc" in
      0)
        if sig_packet "$dir/$file.sig"; then
          sig_sha="$(sha256sum -- "$dir/$file.sig" | cut -d ' ' -f 1)"
          return 0
        fi
        size="$(wc -c < "$dir/$file.sig" | tr -d ' ')"
        warn "$file.sig from $server is not an OpenPGP signature packet ($size bytes)"
        rm -f -- "$dir/$file.sig"
        errors=$((errors + 1))
        ;;
      4) missing=$((missing + 1)) ;;
      *)
        failed "$server" "$rc"
        errors=$((errors + 1))
        ;;
    esac
  done
  if [ "$errors" -gt 0 ]; then
    sig_error="$errors server(s) failed, $missing answered 404"
    return 1
  fi
  unsigned=1
  return 0
}

#---------------------------------------------------------------------------#
# The signature this file must carry, when the database has one.
#---------------------------------------------------------------------------#
sig_sha=""
if [ -n "$pgpsig" ]; then
  if ! printf '%s' "$pgpsig" | base64 -d > "$dir/$file.sig"; then
    result failed "its %PGPSIG% does not decode as base64"
    exit 1
  fi
  sig_sha="$(sha256sum -- "$dir/$file.sig" | cut -d ' ' -f 1)"
fi

#---------------------------------------------------------------------------#
# With no %PGPSIG%, the signature this file must carry is upstream's detached
# .sig as it is now, read before deciding: a layer that differs from it is
# repaired, rather than kept as present while verify refuses it run after run.
#---------------------------------------------------------------------------#
if [ -z "$sig_sha" ]; then
  sig_error=""
  if ! fetch_sig; then
    result failed "its .sig could not be read ($sig_error)"
    exit 1
  fi
fi

#---------------------------------------------------------------------------#
# What the tag holds now decides everything that follows.
#---------------------------------------------------------------------------#
rc=0
registry_manifest "$repo_path" "$tag" "$dir/existing.json" || rc=$?
case "$rc" in
  "$REG_STATUS_ABSENT") decision=push ;;
  "$REG_STATUS_OK") decision="$(decide_push "$dir/existing.json" "$file" "$sha256" "$csize" "$sig_sha")" ;;
  *)
    result failed "could not read $ref"
    exit 1
    ;;
esac
case "$decision" in
  present)
    result present "$ref already holds it"
    exit 0
    ;;
  replaced)
    existing="$(manifest_layer "$dir/existing.json" "$file" | cut -d ' ' -f 1)"
    result replaced "$ref holds ${existing:-another file} under this name; the database says sha256:$sha256; a package tag is never overwritten"
    exit 1
    ;;
  needsig)
    # Only reached with no signature known: upstream publishes none for it.
    result present "unsigned: $ref holds it with no signature, and upstream publishes none for it"
    exit 0
    ;;
esac

#---------------------------------------------------------------------------#
# Download, in the shard's order, a server that failed last. A server that
# answers 200 with other bytes is behind, not down: it is not marked.
#---------------------------------------------------------------------------#
got_from=""
dl_order=()
mapfile -t dl_order < <(down_last "$down_dir" "${order[@]}")
for server in "${dl_order[@]}"; do
  rc=0
  fetch_upstream "$server/$file" "$dir/$file" "$((120 + csize / 65536))" || rc=$?
  case "$rc" in
    0) ;;
    4) continue ;;
    *)
      failed "$server" "$rc"
      continue
      ;;
  esac
  size="$(wc -c < "$dir/$file" | tr -d ' ')"
  got="$(sha256sum -- "$dir/$file" | cut -d ' ' -f 1)"
  if [ "$size" = "$csize" ] && [ "$got" = "$sha256" ]; then
    got_from="$server"
    break
  fi
  warn "$file from $server is $size bytes with sha256 $got; the database says $csize bytes, $sha256"
  rm -f -- "$dir/$file"
done
if [ -z "$got_from" ]; then
  result failed "no server answered with these bytes (tried $n); a file upstream superseded during the run clears on the next run's plan"
  exit 1
fi

if [ "$unsigned" -eq 1 ]; then
  warn "$file has no %PGPSIG% and every server answers 404 for $file.sig; it is mirrored unsigned, as upstream ships it"
fi

#---------------------------------------------------------------------------#
# Push, from the file's directory with ./NAME:TYPE: oras then records the bare
# filename as the layer title, which is what the wrapper looks up, and splits
# the media type at the last colon, after any : in the version.
#---------------------------------------------------------------------------#
deadline=$((300 + csize / MIN_RATE))
if [ "$deadline" -gt 600 ]; then
  deadline=600
fi
source_url="${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY:-pkgforge-dev/mirror-archlinux}"
mapfile -t oargs < <(oras_args)
push_args=(
  push "${oargs[@]}"
  --artifact-type application/vnd.pkgforge.archlinux.package.v1
  --annotation "org.opencontainers.image.created=$created"
  --annotation "org.opencontainers.image.source=$source_url"
  --annotation "org.opencontainers.image.title=$file"
  --annotation "dev.pkgforge.mirror.arch=$arch"
  --annotation "dev.pkgforge.mirror.repo=$repo"
  --annotation "dev.pkgforge.mirror.pkgname=$name"
  --annotation "dev.pkgforge.mirror.sha256=$sha256"
  "$ref"
  "./$file:$PKG_MEDIA_TYPE"
)
if [ -n "$sig_sha" ]; then
  push_args+=("./$file.sig:$SIG_MEDIA_TYPE")
fi

pushed=0
push_started="$(date -u +%s)"
# GHCR limits the requests of one token (measured: "toomanyrequests ...
# allowed: 2000/minute", run 38570044665), and every push of every job shares
# the workflow's token. A 429 costs no attempt. The first push of the shard
# that meets one writes $WORK/throttle, the time its pause ends, and every
# push of the shard waits for that time first. The pauses of one file may
# add up to MIRROR_RATE_WAIT seconds (default 1800).
RATE_WAIT="${MIRROR_RATE_WAIT:-1800}"
throttle_wait() {
  local until now
  [ -f "$WORK/throttle" ] || return 0
  until="$(cat "$WORK/throttle")"
  now="$(date -u +%s)"
  case "$until" in
    '' | *[!0-9]*) return 0 ;;
  esac
  if [ "$until" -gt "$now" ]; then
    sleep "$((until - now))"
  fi
}
attempt=0
waited=0
while :; do
  throttle_wait
  rc=0
  (cd -- "$dir" && timeout --kill-after=30 "$deadline" "$ORAS" "${push_args[@]}" > "$dir/push.log" 2>&1) || rc=$?
  if [ "$rc" -eq 0 ]; then
    pushed=1
    break
  fi
  if grep -qiE 'toomanyrequests|429 Too Many' "$dir/push.log"; then
    pause=$((20 + RANDOM % 41))
    waited=$((waited + pause))
    if [ "$waited" -gt "$RATE_WAIT" ]; then
      warn "$file: the registry still limits pushes after ${waited}s of pauses"
      break
    fi
    tmp="$(mktemp "$WORK/.throttle.XXXXXX")"
    printf '%s\n' "$(($(date -u +%s) + pause))" > "$tmp"
    mv -f -- "$tmp" "$WORK/throttle"
    log "$file: the registry limits pushes (429); every push of the shard waits ${pause}s"
    sleep "$pause"
    continue
  fi
  attempt=$((attempt + 1))
  warn "$file: push attempt $attempt ended $rc" "$(tail -n 3 "$dir/push.log")"
  [ "$attempt" -lt 3 ] || break
  sleep $((attempt * attempt * 5))
done
if [ "$pushed" -ne 1 ]; then
  result failed "oras push failed ($attempt attempt(s), ${waited}s of 429 pauses), last: $(tail -n 1 "$dir/push.log")"
  exit 1
fi
push_seconds=$(($(date -u +%s) - push_started))
rate=$((csize / (push_seconds > 0 ? push_seconds : 1)))

#---------------------------------------------------------------------------#
# Read it back: the tag must now decide present. A registry may answer a read
# before the write shows, so a few tries.
#---------------------------------------------------------------------------#
for attempt in 1 2 3 4 5; do
  rc=0
  registry_manifest "$repo_path" "$tag" "$dir/pushed.json" || rc=$?
  got_decision=""
  if [ "$rc" -eq "$REG_STATUS_OK" ]; then
    got_decision="$(decide_push "$dir/pushed.json" "$file" "$sha256" "$csize" "$sig_sha")"
  fi
  if [ "$got_decision" = present ]; then
    result pushed "from $got_from, pushed in ${push_seconds}s ($((rate / 1024)) KiB/s), read back on try $attempt"
    exit 0
  fi
  # Pushed unsigned on purpose, the tag reads back as "needs a signature",
  # which for a file upstream signs nowhere is what present means.
  if [ "$unsigned" -eq 1 ] && [ "$got_decision" = needsig ]; then
    result pushed "unsigned: from $got_from, pushed in ${push_seconds}s ($((rate / 1024)) KiB/s) with no signature, read back on try $attempt"
    exit 0
  fi
  sleep $((attempt + 1))
done
result failed "pushed, but $ref does not read back holding this file and its signature"
exit 1
