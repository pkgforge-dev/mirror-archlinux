#!/usr/bin/env bash
#
# Install the pinned oras into a directory, checked against its sha256.
#
#   scripts/install-oras DIR
#
# Prints the path of the installed binary. DIR is created when missing.
#
# ⛔ The version and both checksums are written here, not fetched. A checksum
# read from the same release it checks proves only that the release is
# self-consistent. These were read from the v1.3.4 release's checksums.txt on
# 2026-10-13, as docs/measurements.md records.
#
# ⭐ oras is stable and nothing here follows its releases. A newer version is a
# deliberate edit of the three lines below and nothing else.
#
# Environment: ORAS_CACHE, a directory that keeps the release archive between
# calls, so a test suite that installs oras for every step downloads it once.
# The archive in it is checked against the pinned sha256 on every use, the
# same as a fresh download, and one that differs is not used.
#
# Exit status: 0 installed, 1 could not.
set -euo pipefail

ORAS_VERSION=1.3.4
ORAS_SHA256_AMD64=f27adb935022d94df8dc77719c322dda592c78a0d57a6f7dcdd8d900b248c454
ORAS_SHA256_ARM64=15702c6e3a4a56a8bd8ac5c17efdbcab56d9bada661ccbcf017f5b10c1d89399

die() {
  echo "install-oras: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

dest="${1:-}"
[ -n "$dest" ] || die "usage: scripts/install-oras DIR"

case "$(uname -m)" in
  x86_64) arch=amd64 want="$ORAS_SHA256_AMD64" ;;
  aarch64 | arm64) arch=arm64 want="$ORAS_SHA256_ARM64" ;;
  *) die "no pinned oras for $(uname -m)" "add its checksum from the release's oras_${ORAS_VERSION}_checksums.txt" ;;
esac

if [ -x "$dest/oras" ]; then
  have="$("$dest/oras" version | awk '/^Version:/ && v == "" { v = $2 } END { print v }')"
  if [ "$have" = "$ORAS_VERSION" ]; then
    printf '%s\n' "$dest/oras"
    exit 0
  fi
fi

mkdir -p "$dest"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

asset="oras_${ORAS_VERSION}_linux_${arch}.tar.gz"
url="https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/${asset}"
cached=""
if [ -n "${ORAS_CACHE:-}" ] && [ -f "$ORAS_CACHE/$asset" ]; then
  if [ "$(sha256sum "$ORAS_CACHE/$asset" | cut -d ' ' -f 1)" = "$want" ]; then
    cp "$ORAS_CACHE/$asset" "$work/$asset"
    cached=1
  else
    echo "install-oras: $ORAS_CACHE/$asset does not hash to the pinned $want; downloading again" >&2
  fi
fi
if [ -z "$cached" ]; then
  rc=0
  curl -q --fail --location --silent --show-error --connect-timeout 20 --max-time 300 \
    --retry 3 --retry-connrefused --retry-delay 2 --output "$work/$asset" "$url" || rc=$?
  [ "$rc" -eq 0 ] || die "could not download $url (curl $rc)" "reproduce: curl -fLO $url"
fi

got="$(sha256sum "$work/$asset" | cut -d ' ' -f 1)"
[ "$got" = "$want" ] || die "$asset has sha256 $got, pinned $want" \
  "a release asset that changed after it was published is not installed" \
  "reproduce: curl -fsSL $url | sha256sum"
if [ -n "${ORAS_CACHE:-}" ] && [ -z "$cached" ]; then
  mkdir -p "$ORAS_CACHE"
  cp "$work/$asset" "$ORAS_CACHE/$asset.tmp.$$"
  mv -f "$ORAS_CACHE/$asset.tmp.$$" "$ORAS_CACHE/$asset"
fi

tar -xzf "$work/$asset" -C "$work" oras
install -m 0755 "$work/oras" "$dest/oras"
have="$("$dest/oras" version | awk '/^Version:/ && v == "" { v = $2 } END { print v }')"
[ "$have" = "$ORAS_VERSION" ] || die "the installed oras reports version '$have', expected $ORAS_VERSION"
printf '%s\n' "$dest/oras"
