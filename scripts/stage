#!/usr/bin/env bash
#
# Stage one target's database: check that every file it names is on the
# registry, push the database under a staging tag, read it back, and split the
# files new since the promoted database into verification batches.
#
#   scripts/stage PLAN RESULTS OUT TARGET
#
# PLAN is scripts/plan's output (at least PLAN/TARGET). RESULTS holds the
# target's mirror shard outputs, at any depth: every results.tsv under it is
# read, and every lines/*.tsv, which a shard killed before its results.tsv
# leaves behind.
#
# ⛔ Only the results of this plan are read: a shard's directory must hold a
# plan-id that is PLAN/TARGET/plan-id (scripts/mirror-shard). A "Re-run all
# jobs" plans again, and the download of results-<target>-* still returns the
# earlier attempt's artifacts for every name this attempt did not upload
# again. Their lines are about another plan; read, a stale "failed" could
# hold the target, or a stale "pushed" could count a file that is not there.
# Each directory left out is named in a warning.
#
# OUT/TARGET/state   staged held replaced private error, or the plan's own
#                    state for a target that was not pending
# OUT/TARGET/why     what was measured
# OUT/TARGET/plan-id the plan this stage comes from, for scripts/report
# OUT/TARGET/staged.env  DIGEST, DB_SHA256, FILES_SHA256, TAG of the staged manifest
# OUT/TARGET/batches/<n>.txt  package names, one per line
# OUT/TARGET/canaries.txt     the names verify reads first, through the
#                             wrapper's single-file path; all in batch 0
# OUT/TARGET/records.tsv      the database's records, for verify's account of
#                             a package pacman refuses
# OUT/verify-matrix.json  {"include":[{"target":..,"batch":..},..]}
# OUT/summary.tsv         target, state, why
#
# ⛔ A database is staged only when every file new since the promoted one has a
# result of pushed or present. A file with no result or a failure holds the
# target for this run; the next run plans again, from upstream's database of
# that moment, so a file upstream superseded while this run went clears by
# itself. A file whose tag holds other bytes (replaced) holds the target until
# a person decides, and stage says so at once.
#
# The staged manifest names the files whose tag holds no signature, because
# upstream publishes none for them, in its dev.pkgforge.mirror.unsigned
# annotation, space separated: those plan carried over (PLAN/TARGET/
# unsigned.txt), and those mirror-file left unsigned in this run (a result
# detail that starts "unsigned: "). scripts/plan asks upstream for their .sig
# on every run, and plans a file again once upstream signs it. The list stops
# at 16 KiB, so the manifest stays far below the 64 KiB the wrapper reads.
#
# Verification batches: every file new since the promoted database, plus the
# canaries, which are always present: the smallest package and every keyring
# package of the target, so a run with nothing new still proves the path a
# consumer takes. The number of batches is the larger of ceil(bytes /
# VERIFY_BATCH_BYTES) and ceil(files / VERIFY_BATCH_FILES); when that is more
# than VERIFY_MAX_BATCHES, both limits grow until it is not (lib.sh
# batch_count), and the log says so.
#
# Environment: STAGING_TAG (default staging), VERIFY_BATCH_FILES (400),
# VERIFY_BATCH_BYTES (2147483648), VERIFY_MAX_BATCHES (40), MIRROR_NAMESPACE,
# REGISTRY_USER, REGISTRY_TOKEN.
#
# Exit status: 0 the target has a state, 1 the step itself could not run.
set -euo pipefail
SCRIPT_NAME=stage
# shellcheck source=lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need curl jq awk sha256sum timeout

plan="${1:-}"
results="${2:-}"
out="${3:-}"
target="${4:-}"
if [ ! -d "$plan" ] || [ -z "$results" ] || [ -z "$out" ] || [ -z "$target" ]; then
  die "usage: scripts/stage PLAN RESULTS OUT TARGET"
fi
case "$target" in
  *[!a-z0-9_.-]*) die "TARGET is a target name, not '$target'" ;;
esac
[ -f "$plan/$target/state" ] || die "the plan has no state for $target" "reproduce: ls $plan/$target"
[ -n "$MIRROR_NAMESPACE" ] || die "MIRROR_NAMESPACE is not set"
if [ "$MIRROR_REGISTRY_AUTH" != none ] && [ -z "${REGISTRY_TOKEN:-}" ]; then
  die "REGISTRY_TOKEN is not set; staging pushes"
fi
STAGING_TAG="${STAGING_TAG:-staging}"
[[ "$STAGING_TAG" =~ ^staging(-[a-z0-9]+(-[a-z0-9]+)*)?$ ]] ||
  die "STAGING_TAG must be staging or staging-<slug>, not '$STAGING_TAG'"
BATCH_FILES="${VERIFY_BATCH_FILES:-400}"
BATCH_BYTES="${VERIFY_BATCH_BYTES:-2147483648}"
MAX_BATCHES="${VERIFY_MAX_BATCHES:-40}"
for v in BATCH_FILES BATCH_BYTES MAX_BATCHES; do
  case "${!v}" in
    '' | *[!0-9]* | 0) die "$v must be a positive integer, not '${!v}'" ;;
  esac
done
mkdir -p "$out"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin"
REGISTRY_TOKEN_CACHE="$work/tokens"
mkdir -m 0700 "$REGISTRY_TOKEN_CACHE"
ORAS="$("$REPO_ROOT/scripts/install-oras" "$work/bin")"
ORAS_CONFIG="$work/oras-auth.json"
oras_login "$ORAS" "$ORAS_CONFIG"

# Every result line from every shard of this plan: target filename status
# seconds detail. No results at all is ordinary: a database that changed by
# dropping packages names no new file. A results.tsv and the lines/ beside it
# say the same.
plan_id=""
if [ -f "$plan/$target/plan-id" ]; then
  plan_id="$(cat "$plan/$target/plan-id")"
else
  warn "$plan/$target/plan-id does not exist: this plan names no plan id, so only results that name none are read"
fi
: > "$work/results.tsv"
: > "$work/result-dirs.txt"
if [ -d "$results" ]; then
  find "$results" \( -name results.tsv -type f \) -o \( -name lines -type d \) > "$work/result-paths.txt"
  sed 's|/[^/]*$||' "$work/result-paths.txt" | sort -u > "$work/result-dirs.txt"
fi
while IFS= read -r d; do
  got=""
  if [ -f "$d/plan-id" ]; then
    got="$(cat "$d/plan-id")"
  fi
  if [ "$got" != "$plan_id" ]; then
    warn "$d holds the results of plan '$got', not of this plan '$plan_id'; they are not read" \
      "an earlier attempt of the run left them: Re-run all jobs plans again, and the artifacts of the earlier attempt stay"
    continue
  fi
  if [ -f "$d/results.tsv" ]; then
    cat "$d/results.tsv" >> "$work/results.tsv"
  fi
  if [ -d "$d/lines" ]; then
    find "$d/lines" -maxdepth 1 -name '[0-9]*.tsv' -type f -exec cat {} + >> "$work/results.tsv"
  fi
done < "$work/result-dirs.txt"

set_state() {
  printf '%s\n' "$2" > "$1/state"
  printf '%s\n' "$3" > "$1/why"
  log "$(basename "$1"): $2: $3"
}

stage_target() {
  local pdir="$1" name dir state conf repo repo_path
  name="$(basename "$pdir")"
  dir="$out/$name"
  rm -rf "$dir"
  mkdir -p "$dir/batches"
  state="$(cat "$pdir/state")"
  if [ "$state" != pending ]; then
    set_state "$dir" "$state" "$(cat "$pdir/why")"
    return 0
  fi
  conf="$TARGETS_DIR/$name.conf"
  target_check "$conf"
  repo="$(target_get "$conf" repo)"
  repo_path="$(target_repository "$conf")"

  #-------------------------------------------------------------------------#
  # Every new file accounted for
  #-------------------------------------------------------------------------#
  awk -F '\t' -v OFS='\t' '
    FILENAME == ARGV[1] { k = $1 SUBSEP $2; st[k] = $3; det[k] = $5; next }
    { k = $1 SUBSEP $2; s = (k in st) ? st[k] : "missing"; print $2, s, (k in det) ? det[k] : "no shard reported it" }
  ' "$work/results.tsv" "$pdir/todo.tsv" > "$dir/accounted.tsv"

  local n_replaced n_bad
  n_replaced="$(awk -F '\t' '$2 == "replaced" { n++ } END { print n + 0 }' "$dir/accounted.tsv")"
  n_bad="$(awk -F '\t' '$2 != "pushed" && $2 != "present" { n++ } END { print n + 0 }' "$dir/accounted.tsv")"
  if [ "$n_replaced" -gt 0 ]; then
    awk -F '\t' '$2 == "replaced"' "$dir/accounted.tsv" > "$dir/replaced.tsv"
    set_state "$dir" replaced "$n_replaced file(s) have a tag holding other bytes under the same name, first: $(awk -F '\t' '$2 == "replaced" && !f { print $1 ": " $3; f = 1 }' "$dir/accounted.tsv")"
    return 0
  fi
  if [ "$n_bad" -gt 0 ]; then
    awk -F '\t' '$2 != "pushed" && $2 != "present"' "$dir/accounted.tsv" > "$dir/failing.tsv"
    set_state "$dir" held "$n_bad file(s) are not on the registry, first: $(awk -F '\t' '$2 != "pushed" && $2 != "present" && !f { print $1 ": " $2 ", " $3; f = 1 }' "$dir/accounted.tsv")"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # Push the database under the staging tag
  #-------------------------------------------------------------------------#
  local sd="$work/$name" db_sha files_sha f
  rm -rf "$sd"
  mkdir -p "$sd"
  cp "$pdir/upstream.db" "$sd/$repo.db"
  cp "$pdir/upstream.files" "$sd/$repo.files"
  db_sha="$(sha256sum "$sd/$repo.db" | cut -d ' ' -f 1)"
  files_sha="$(sha256sum "$sd/$repo.files" | cut -d ' ' -f 1)"
  local layers=("./$repo.db:application/vnd.pkgforge.archlinux.db.v1" "./$repo.files:application/vnd.pkgforge.archlinux.files.v1")
  for f in db files; do
    if [ -f "$pdir/upstream.$f.sig" ]; then
      cp "$pdir/upstream.$f.sig" "$sd/$repo.$f.sig"
      layers+=("./$repo.$f.sig:application/pgp-signature")
    fi
  done

  # shellcheck source=/dev/null # written by scripts/plan
  . "$pdir/meta.env"
  : "${PRIVATE:=0}" "${ARCH:?}" "${REPO:?}" "${UPSTREAM:?}" "${PACKAGES:?}" "${BYTES:?}" "${NEWEST_BUILDDATE:?}" "${FETCHED:?}"
  local source_url
  source_url="${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY:-pkgforge-dev/mirror-archlinux}"

  # The files whose tag holds no signature, as far as the database names them
  local unsigned_list="" unsigned_n unsigned_cut
  {
    if [ -f "$pdir/unsigned.txt" ]; then
      cat "$pdir/unsigned.txt"
    fi
    awk -F '\t' -v t="$name" '$1 == t && ($3 == "pushed" || $3 == "present") && index($5, "unsigned: ") == 1 { print $2 }' "$work/results.tsv"
  } | sort -u > "$work/unsigned-all.txt"
  awk -F '\t' 'FILENAME == ARGV[1] { r[$1] = 1; next } ($0 in r)' "$pdir/records.tsv" "$work/unsigned-all.txt" > "$work/unsigned-named.txt"
  awk -v max=16384 '{ n += length($0) + 1; if (n <= max) print }' "$work/unsigned-named.txt" > "$work/unsigned.txt"
  unsigned_n="$(awk 'END { print NR + 0 }' "$work/unsigned.txt")"
  unsigned_cut=$(($(awk 'END { print NR + 0 }' "$work/unsigned-named.txt") - unsigned_n))
  if [ "$unsigned_n" -gt 0 ]; then
    unsigned_list="$(tr '\n' ' ' < "$work/unsigned.txt" | sed 's/ $//')"
    log "$name: $unsigned_n file(s) have no signature, as upstream ships them; the manifest names them, and plan asks for their .sig again on each run"
  fi
  if [ "$unsigned_cut" -gt 0 ]; then
    warn "$name: $unsigned_cut more file(s) have no signature and are not named: the list stops at 16 KiB" \
      "plan does not ask for their .sig again until upstream changes their database record"
  fi
  local oargs=()
  mapfile -t oargs < <(oras_args)
  local args=(
    push
    "${oargs[@]}"
    --artifact-type application/vnd.pkgforge.archlinux.db.v1
    --annotation "org.opencontainers.image.source=$source_url"
    --annotation "org.opencontainers.image.title=$repo.db"
    --annotation "org.opencontainers.image.revision=${GITHUB_SHA:-unknown}"
    --annotation "dev.pkgforge.mirror.arch=$ARCH"
    --annotation "dev.pkgforge.mirror.repo=$REPO"
    --annotation "dev.pkgforge.mirror.upstream=$UPSTREAM"
    --annotation "dev.pkgforge.mirror.db-sha256=$db_sha"
    --annotation "dev.pkgforge.mirror.files-sha256=$files_sha"
    --annotation "dev.pkgforge.mirror.packages=$PACKAGES"
    --annotation "dev.pkgforge.mirror.bytes=$BYTES"
    --annotation "dev.pkgforge.mirror.newest-builddate=$NEWEST_BUILDDATE"
    --annotation "dev.pkgforge.mirror.fetched=$FETCHED"
    --annotation "dev.pkgforge.mirror.run=${GITHUB_RUN_ID:-local}"
  )
  if [ -n "$unsigned_list" ]; then
    args+=(--annotation "dev.pkgforge.mirror.unsigned=$unsigned_list")
  fi
  args+=("$MIRROR_REGISTRY/$repo_path:$STAGING_TAG" "${layers[@]}")
  local rc=0 attempt
  for attempt in 1 2 3; do
    rc=0
    (cd "$sd" && timeout --kill-after=30 300 "$ORAS" "${args[@]}" > "$sd/push.log" 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || break
    warn "$name: staging push attempt $attempt ended $rc" "$(tail -n 3 "$sd/push.log")"
    sleep $((attempt * attempt * 5))
  done
  if [ "$rc" -ne 0 ]; then
    set_state "$dir" error "could not push $repo_path:$STAGING_TAG: $(tail -n 1 "$sd/push.log")"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # Read it back, and pin it by digest from here on
  #-------------------------------------------------------------------------#
  local digest="" d
  for attempt in 1 2 3 4 5; do
    rc=0
    registry_manifest "$repo_path" "$STAGING_TAG" "$sd/staged.json" || rc=$?
    if [ "$rc" -eq "$REG_STATUS_OK" ]; then
      read -r d _ _ <<< "$(manifest_layer "$sd/staged.json" "$repo.db")"
      if [ "$d" = "sha256:$db_sha" ]; then
        digest="sha256:$(sha256sum "$sd/staged.json" | cut -d ' ' -f 1)"
        break
      fi
    fi
    sleep $((attempt * 2))
  done
  if [ -z "$digest" ]; then
    set_state "$dir" error "$repo_path:$STAGING_TAG does not read back with $repo.db $db_sha"
    return 0
  fi
  {
    printf 'DIGEST=%s\nTAG=%s\nDB_SHA256=%s\nFILES_SHA256=%s\nFETCHED=%s\nNEWEST_BUILDDATE=%s\n' \
      "$digest" "$STAGING_TAG" "$db_sha" "$files_sha" "$FETCHED" "$NEWEST_BUILDDATE"
  } > "$dir/staged.env"

  #-------------------------------------------------------------------------#
  # What a consumer sees: the same manifest, read with no credential at all.
  # GitHub creates a package private and offers no API to change that, so the
  # first push of a new target needs one click, and this is where it shows.
  #-------------------------------------------------------------------------#
  rc=0
  REGISTRY_TOKEN='' registry_manifest "$repo_path" "$digest" "$sd/anon.json" || rc=$?
  # This read is the authority: plan's own flag may come from a transient
  # failure of its anonymous read, and is only a hint.
  if [ "$rc" -ne "$REG_STATUS_OK" ]; then
    printf 'https://github.com/orgs/%s/packages/container/%s/settings\n' "${MIRROR_NAMESPACE%%/*}" \
      "$(printf '%s' "${repo_path#*/}" | sed 's|/|%2F|g')" > "$dir/settings-url"
    set_state "$dir" private "$repo_path reads back with the workflow's token and not without one: the package is not public; $(cat "$dir/settings-url")"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # Verification batches. The canaries go to batch 0; the rest, largest first
  # onto the lightest batch.
  #-------------------------------------------------------------------------#
  cp "$pdir/records.tsv" "$dir/records.tsv"
  target_keyrings "$conf" > "$work/keyrings.txt"
  {
    awk -F '\t' 'FILENAME == ARGV[1] { want[$1] = 1; next } ($2 in want) { print $2 }' "$work/keyrings.txt" "$pdir/records.tsv"
    sort -t $'\t' -k6,6n -k2,2 "$pdir/records.tsv" | awk -F '\t' 'NR == 1 { print $2 }'
  } | awk '!seen[$0]++' > "$dir/canaries.txt"
  {
    awk -F '\t' 'FILENAME == ARGV[1] { c[$1] = 1; next } ($2 in c) { print $2 "\t" $6 }' "$dir/canaries.txt" "$pdir/records.tsv"
    awk -F '\t' '{ print $6 "\t" $5 }' "$pdir/todo.tsv"
  } | awk -F '\t' '!seen[$1]++' > "$dir/verify.tsv"

  local nfiles nbytes k flimit blimit wanted
  nfiles="$(awk 'END { print NR + 0 }' "$dir/verify.tsv")"
  nbytes="$(awk -F '\t' '{ s += $2 } END { printf "%.0f\n", s }' "$dir/verify.tsv")"
  read -r k flimit blimit wanted <<< "$(batch_count "$nfiles" "$nbytes" "$BATCH_FILES" "$BATCH_BYTES" "$MAX_BATCHES")"
  if [ "$wanted" -gt "$k" ]; then
    log "$name: $nfiles file(s) and $((nbytes / 1048576)) MiB want $wanted batch(es) at $BATCH_FILES files and $((BATCH_BYTES / 1048576)) MiB; VERIFY_MAX_BATCHES=$MAX_BATCHES grows the limits to $flimit files and $((blimit / 1048576)) MiB: $k batch(es)"
  fi
  local canary_bytes
  canary_bytes="$(awk -F '\t' 'FILENAME == ARGV[1] { c[$1] = 1; next } ($1 in c) { s += $2 } END { printf "%.0f\n", s }' "$dir/canaries.txt" "$dir/verify.tsv")"
  cp "$dir/canaries.txt" "$dir/batches/0.txt"
  awk -F '\t' 'FILENAME == ARGV[1] { c[$1] = 1; next } !($1 in c)' "$dir/canaries.txt" "$dir/verify.tsv" |
    sort -t $'\t' -k2,2nr -k1,1 | awk -F '\t' -v k="$k" -v d="$dir/batches" -v c="$canary_bytes" '
      BEGIN { load[0] = c + 0 }
      {
        best = 0
        for (i = 1; i < k; i++) if (load[i] < load[best]) best = i
        load[best] += $2
        print $1 >> (d "/" best ".txt")
      }
    '

  set_state "$dir" staged "$repo_path@$digest, $nfiles package(s) to verify in $(find "$dir/batches" -name '*.txt' | awk 'END { print NR + 0 }') batch(es), canaries: $(tr '\n' ' ' < "$dir/canaries.txt" | sed 's/ $//')"
}

stage_target "$plan/$target"
printf '%s\n' "$plan_id" > "$out/$target/plan-id"

#---------------------------------------------------------------------------#
# The verify matrix
#---------------------------------------------------------------------------#
{
  dir="$out/$target"
  if [ "$(cat "$dir/state")" = staged ]; then
    for b in "$dir"/batches/*.txt; do
      [ -e "$b" ] || continue
      basename "$b" .txt
    done | sort -n | while IFS= read -r n; do
      jq -cn --arg t "$target" --arg b "$n" '{target: $t, batch: $b}'
    done
  fi
} | jq -cs '{include: .}' > "$out/verify-matrix.json"

{
  printf 'target\tstate\twhy\n'
  printf '%s\t%s\t%s\n' "$target" "$(cat "$out/$target/state")" "$(cat "$out/$target/why")"
} > "$out/summary.tsv"

if [ -n "${GITHUB_OUTPUT:-}" ]; then
  {
    printf 'verify_matrix=%s\n' "$(cat "$out/verify-matrix.json")"
    if [ "$(jq '.include | length' "$out/verify-matrix.json")" -gt 0 ]; then
      echo "has_batches=true"
    else
      echo "has_batches=false"
    fi
  } >> "$GITHUB_OUTPUT"
fi
