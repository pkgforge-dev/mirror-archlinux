#!/usr/bin/env bash
#
# Decide what one sync run has to do, per target, and split each target's work
# into shards of its own.
#
#   scripts/plan OUT [TARGET.conf ...]
#
# No TARGET means every enabled target in $TARGETS_DIR. For each target:
#
#   1. Read the database from every db_server, the distribution's own hosts,
#      each fetch with a deadline; a db_server that fails gives way to the next.
#      Refuse one that is not whole and well formed: every field checked
#      against its grammar, one record per package directory (lib.sh db_check;
#      a directory whose desc holds only NUL bytes is counted and named, not
#      refused).
#   2. Read the promoted database the way a consumer does: anonymously, through
#      client/pacman-oci. None on a first run. A package that answers only with
#      the workflow's token is private, and is planned with that token.
#   3. Drop every candidate that is behind the promoted database, or behind
#      another candidate: some package in it was built before the same package
#      in the other. Take the first one left, in db_server order, unless it
#      differs from the promoted database only by packages added or dropped
#      while a db_server still serves the promoted one. ALLOW_OLDER (target
#      names, comma separated) skips the promoted comparison for a deliberate
#      upstream downgrade.
#   4. The same bytes as the promoted database: the target is current.
#   5. Otherwise every file is skip, when the promoted database names it with
#      the same sha256 and the same %PGPSIG% (no request made), or todo.
#      scripts/mirror-file reads each todo file's tag before writing it: it
#      never overwrites a package layer, and it repairs a signature layer that
#      upstream signed again.
#   6. The todo files of the target go into its own shards: k = the larger of
#      ceil(bytes / SHARD_BYTES) and ceil(files / SHARD_FILES), at least 1, at
#      most MAX_SHARDS and the file count; largest file first onto the lightest
#      shard. A target never waits for another target's shards.
#
# OUT/<target>/state        current pending behind held error
# OUT/<target>/why          one line saying what was measured
# OUT/<target>/upstream.db  the chosen database, byte for byte, and .files and
#                           any .sig the upstream publishes beside them
# OUT/<target>/records.tsv  its records (lib.sh db_records)
# OUT/<target>/nul.txt      its package directories whose desc is NUL bytes only
# OUT/<target>/todo.tsv     the files this run mirrors
# OUT/<target>/shards/<n>.tsv  the work lines of shard n, for scripts/mirror-shard
# OUT/<target>/meta.env     KEY=VALUE facts stage writes into the manifest
# OUT/targets.json          {"include":[{"target":T,"shards":[0,1,..]},..]}: the
#                           pending targets with files to mirror
# OUT/pending.json          the same shape, "shards":[], for the pending targets
#                           with no file to mirror (a database that only
#                           dropped packages): they still stage and verify
# OUT/summary.tsv           target, state, files, MiB, why
#
# Work line: target filename tag sha256 csize name action builddate pgpsig, tab
# separated. pgpsig is last because it may be empty.
#
# In Actions, GITHUB_OUTPUT gets targets (targets.json and pending.json as one
# matrix), has_targets, and slotN=TARGET for each pending target, which the
# workflow's upload steps read to upload OUT/<target> as plan-<target>.
#
# Environment: SHARD_BYTES (default 536870912), SHARD_FILES (400), MAX_SHARDS
# (32, per target), ALLOW_OLDER, MIRROR_NAMESPACE, REGISTRY_USER and
# REGISTRY_TOKEN (used only to tell a private package from an absent one).
#
# Exit status: 0 planned, whatever state each target is in; 1 no plan could be
# made at all.
set -euo pipefail
SCRIPT_NAME=plan
# shellcheck source=lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need curl jq awk tar sha256sum

out="${1:-}"
[ -n "$out" ] || die "usage: scripts/plan OUT [TARGET.conf ...]"
shift
[ -n "$MIRROR_NAMESPACE" ] || die "MIRROR_NAMESPACE is not set and GITHUB_REPOSITORY gives none"

SHARD_BYTES="${SHARD_BYTES:-536870912}"
SHARD_FILES="${SHARD_FILES:-400}"
MAX_SHARDS="${MAX_SHARDS:-32}"
for v in SHARD_BYTES SHARD_FILES MAX_SHARDS; do
  case "${!v}" in
    '' | *[!0-9]* | 0) die "$v must be a positive integer, not '${!v}'" ;;
  esac
done
# Whole-transfer deadlines for what plan reads from upstream, in seconds. The
# largest measured (2026-10-14): x86_64 extra.files, 51452041 bytes.
DB_MAX_TIME=300
FILES_MAX_TIME=900
SIG_MAX_TIME=60

if [ "$#" -eq 0 ]; then
  for conf in "$TARGETS_DIR"/*.conf; do
    [ -e "$conf" ] || continue
    if target_enabled "$conf"; then
      set -- "$@" "$conf"
    fi
  done
fi
[ "$#" -gt 0 ] || die "no enabled target" "reproduce: ls $TARGETS_DIR"

mkdir -p "$out"
fetched="$(iso_now)"

# set_state DIR STATE WHY
set_state() {
  printf '%s\n' "$2" > "$1/state"
  printf '%s\n' "$3" > "$1/why"
  log "$(basename "$1"): $2: $3"
}

allowed_older() {
  case ",${ALLOW_OLDER:-}," in
    *",$1,"*) return 0 ;;
    *) return 1 ;;
  esac
}

# nul_note DIR -> " (N package directory(ies) hold only NUL bytes: a b)", or nothing
nul_note() {
  local n
  n="$(awk 'END { print NR + 0 }' "$1/nul.txt")"
  [ "$n" -gt 0 ] || return 0
  printf '; %s package directory(ies) whose desc holds only NUL bytes, passed over: %s' "$n" "$(tr '\n' ' ' < "$1/nul.txt" | sed 's/ $//')"
}

# shard_target DIR NAME: OUT/<target>/shards/<n>.tsv from its todo.tsv
shard_target() {
  local dir="$1" name="$2" files bytes k wanted
  mkdir -p "$dir/shards"
  files="$(awk 'END { print NR + 0 }' "$dir/todo.tsv")"
  bytes="$(awk -F '\t' '{ s += $5 } END { printf "%.0f\n", s }' "$dir/todo.tsv")"
  read -r k wanted <<< "$(shard_count "$files" "$bytes" "$SHARD_FILES" "$SHARD_BYTES" "$MAX_SHARDS")"
  if [ "$wanted" -gt "$MAX_SHARDS" ] && [ "$k" -gt 0 ]; then
    log "$name: $files file(s) and $((bytes / 1048576)) MiB want $wanted shard(s); MAX_SHARDS=$MAX_SHARDS caps them at $k: $(awk -v b="$bytes" -v k="$k" 'BEGIN { printf "%.2f", b / k / 1073741824 }') GiB and $(((files + k - 1) / k)) file(s) per shard"
  fi
  [ "$k" -gt 0 ] || return 0
  sort -t $'\t' -k5,5nr -k2,2 "$dir/todo.tsv" | awk -F '\t' -v k="$k" -v d="$dir/shards" '
    {
      best = 0
      for (i = 1; i < k; i++) if (load[i] < load[best]) best = i
      load[best] += $5
      print > (d "/" best ".tsv")
    }
  '
}

# prune DIR: drop what only plan reads, so the target's artifact holds what
# stage and mirror read and nothing else
prune() {
  local dir="$1" f
  for f in "$dir"/cand/*.db "$dir"/cand/*.tsv "$dir"/cand/*.tsv.*; do
    [ -e "$f" ] || continue
    case "$f" in
      */cand/list.tsv | */cand/kept.tsv) ;;
      *) rm -f -- "$f" ;;
    esac
  done
  rm -f -- "$dir/promoted.db" "$dir/promoted.db.part" "$dir/promoted.tsv" "$dir/pairs.tsv" \
    "$dir/files.tsv" "$dir"/files.tsv.* "$dir/latest.json"
}

plan_target() {
  local conf="$1" arch repo name dir repo_path server rc why i
  target_check "$conf"
  arch="$(target_get "$conf" arch)"
  repo="$(target_get "$conf" repo)"
  name="$arch-$repo"
  dir="$out/$name"
  repo_path="$(target_repository "$conf")"
  rm -rf "$dir"
  mkdir -p "$dir/cand"
  : > "$dir/todo.tsv"
  : > "$dir/meta.env"
  : > "$dir/nul.txt"

  #-------------------------------------------------------------------------#
  # 1. Candidates, from the distribution's own servers only
  #-------------------------------------------------------------------------#
  i=0
  : > "$dir/cand/list.tsv"
  while IFS= read -r server; do
    [ -n "$server" ] || continue
    i=$((i + 1))
    rc=0
    fetch_upstream "$server/$repo.db" "$dir/cand/$i.db" "$DB_MAX_TIME" || rc=$?
    if [ "$rc" -ne 0 ]; then
      log "$name: $server/$repo.db did not answer within ${DB_MAX_TIME}s (status $rc); the next db_server is tried"
      continue
    fi
    rc=0
    why="$(db_check "$dir/cand/$i.db" "$dir/cand/$i.tsv")" || rc=$?
    if [ "$rc" -ne 0 ]; then
      warn "$name: refused the database from $server: $why" \
        "reproduce: curl -fsSLO $server/$repo.db && bash -c '. scripts/lib.sh; db_check $repo.db /tmp/records.tsv'"
      continue
    fi
    if [ -s "$dir/cand/$i.tsv.nul" ]; then
      log "$name: $server/$repo.db: $(awk 'END { print NR + 0 }' "$dir/cand/$i.tsv.nul") package directory(ies) whose desc holds only NUL bytes: $(tr '\n' ' ' < "$dir/cand/$i.tsv.nul")"
    fi
    printf '%s\t%s\t%s\n' "$i" "$server" "$(sha256sum "$dir/cand/$i.db" | cut -d ' ' -f 1)" >> "$dir/cand/list.tsv"
  done <<< "$(target_all "$conf" db_server)"

  if [ ! -s "$dir/cand/list.tsv" ]; then
    set_state "$dir" error "no db_server answered with a whole, well-formed database"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # 2. The promoted database, read as a consumer reads it
  #-------------------------------------------------------------------------#
  local promoted_sha="" private=0 anon_rc auth_rc="" layer_digest=""
  : > "$dir/promoted.tsv"
  anon_rc=0
  REGISTRY_TOKEN='' registry_manifest "$repo_path" latest "$dir/latest.json" || anon_rc=$?
  if [ "$anon_rc" -ne "$REG_STATUS_OK" ] && { [ -n "${REGISTRY_TOKEN:-}" ] || [ "$MIRROR_REGISTRY_AUTH" = none ]; }; then
    auth_rc=0
    registry_manifest "$repo_path" latest "$dir/latest.json" || auth_rc=$?
    if [ "$auth_rc" -eq "$REG_STATUS_OK" ]; then
      private=1
      warn "$name: $repo_path:latest reads only with the workflow's token; the package is private"
    fi
  fi
  if [ "$anon_rc" -eq "$REG_STATUS_OK" ] || [ "$private" -eq 1 ]; then
    read -r layer_digest _ _ <<< "$(manifest_layer "$dir/latest.json" "$repo.db")"
    if [ -z "$layer_digest" ]; then
      set_state "$dir" error "$repo_path:latest holds no single $repo.db layer"
      return 0
    fi
    if [ "$private" -eq 0 ]; then
      # The consumer's own path: the wrapper, no credential. This is promote's
      # read-back, repeated by every run.
      rc=0
      REGISTRY_TOKEN='' "$WRAPPER" "$dir/promoted.db.part" "$OCI_SCHEME://$MIRROR_REGISTRY/$repo_path/$repo.db" || rc=$?
      if [ "$rc" -ne 0 ]; then
        set_state "$dir" error "client/pacman-oci could not read $repo_path/$repo.db (exit $rc)"
        return 0
      fi
      mv -f "$dir/promoted.db.part" "$dir/promoted.db"
    elif ! registry_blob "$repo_path" "$layer_digest" "$dir/promoted.db"; then
      set_state "$dir" error "could not read the promoted $repo.db ($layer_digest)"
      return 0
    fi
    promoted_sha="$(sha256sum "$dir/promoted.db" | cut -d ' ' -f 1)"
    if [ "sha256:$promoted_sha" != "$layer_digest" ]; then
      set_state "$dir" error "$repo_path:latest names $layer_digest and serves $promoted_sha"
      return 0
    fi
    db_records "$dir/promoted.db" "$dir/promoted.tsv"
  elif [ "$anon_rc" -eq "$REG_STATUS_ABSENT" ] && [ "$auth_rc" != "$REG_STATUS_ERROR" ]; then
    log "$name: nothing promoted yet in $repo_path"
  else
    set_state "$dir" error "could not read $repo_path:latest, and an unreadable promotion is not a first run"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # 3. Nothing behind the promoted database, nothing behind another candidate
  #-------------------------------------------------------------------------#
  local idx srv sha newer older behind_promoted=0 other kept=0 chosen="" o_idx p_newer chosen_newer=1 promoted_kept=""
  : > "$dir/cand/kept.tsv"
  while IFS=$'\t' read -r idx srv sha; do
    p_newer=1
    if [ -s "$dir/promoted.tsv" ] && ! allowed_older "$name"; then
      read -r newer older <<< "$(behind "$dir/promoted.tsv" "$dir/cand/$idx.tsv")"
      p_newer="$newer"
      if [ "$older" -gt 0 ]; then
        behind_promoted=$((behind_promoted + 1))
        log "$name: $srv is behind what is promoted: $older package(s) older, $newer newer"
        awk -F '\t' 'FILENAME == ARGV[1] { b[$2] = $7; next } ($2 in b) && $7 + 0 < b[$2] + 0 { print "  " $2 " " b[$2] " -> " $7 }' \
          "$dir/promoted.tsv" "$dir/cand/$idx.tsv" | sed -n 1,5p >&2
        continue
      fi
    fi
    other=0
    while IFS=$'\t' read -r o_idx _ _; do
      [ "$o_idx" != "$idx" ] || continue
      read -r newer older <<< "$(behind "$dir/cand/$o_idx.tsv" "$dir/cand/$idx.tsv")"
      if [ "$older" -gt 0 ]; then
        other=1
        log "$name: $srv is behind another db_server: $older package(s) older"
        break
      fi
    done < "$dir/cand/list.tsv"
    [ "$other" -eq 0 ] || continue
    kept=$((kept + 1))
    printf '%s\t%s\t%s\n' "$idx" "$srv" "$sha" >> "$dir/cand/kept.tsv"
    if [ -n "$promoted_sha" ] && [ "$sha" = "$promoted_sha" ] && [ -z "$promoted_kept" ]; then
      promoted_kept="$idx"$'\t'"$srv"$'\t'"$sha"
    fi
    if [ -z "$chosen" ]; then
      chosen="$idx"$'\t'"$srv"$'\t'"$sha"
      chosen_newer="$p_newer"
    fi
  done < "$dir/cand/list.tsv"

  # A database that only adds or drops packages is not shown to be newer by
  # any build date: it may be an older copy from a server that lags. While a
  # db_server still serves the promoted database, that one is kept, and the
  # change is taken once every db_server agrees.
  if [ -n "$promoted_kept" ] && [ "$chosen_newer" -eq 0 ]; then
    chosen="$promoted_kept"
  fi

  if [ -z "$chosen" ]; then
    if [ "$behind_promoted" -eq "$(awk 'END { print NR + 0 }' "$dir/cand/list.tsv")" ]; then
      set_state "$dir" behind "every db_server answered a database older than the promoted one; ALLOW_OLDER=$name takes it anyway"
    else
      set_state "$dir" held "the db_servers disagree: each answered a database with some package older than another's"
    fi
    return 0
  fi

  local best chosen_server chosen_sha
  IFS=$'\t' read -r best chosen_server chosen_sha <<< "$chosen"
  cp "$dir/cand/$best.db" "$dir/upstream.db"
  cp "$dir/cand/$best.tsv" "$dir/records.tsv"
  cp "$dir/cand/$best.tsv.nul" "$dir/nul.txt"

  #-------------------------------------------------------------------------#
  # 4. Current?
  #-------------------------------------------------------------------------#
  local packages bytes newest
  packages="$(awk 'END { print NR + 0 }' "$dir/records.tsv")"
  bytes="$(awk -F '\t' '{ s += $6 } END { printf "%.0f\n", s }' "$dir/records.tsv")"
  newest="$(awk -F '\t' '$7 + 0 > m { m = $7 + 0 } END { print m + 0 }' "$dir/records.tsv")"
  {
    printf 'TARGET=%s\nARCH=%s\nREPO=%s\nREPOSITORY=%s\n' "$name" "$arch" "$repo" "$repo_path"
    printf 'UPSTREAM=%s\nDB_SHA256=%s\nPROMOTED_DB_SHA256=%s\n' "$chosen_server" "$chosen_sha" "$promoted_sha"
    printf 'PACKAGES=%s\nBYTES=%s\nNEWEST_BUILDDATE=%s\nFETCHED=%s\nPRIVATE=%s\n' "$packages" "$bytes" "$newest" "$fetched" "$private"
    printf 'NUL_MEMBERS=%s\n' "$(awk 'END { print NR + 0 }' "$dir/nul.txt")"
  } > "$dir/meta.env"

  if [ "$chosen_sha" = "$promoted_sha" ]; then
    set_state "$dir" current "the promoted $repo.db is upstream's ($chosen_sha)$(nul_note "$dir")"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # The files database and any signatures, from a db_server that served these
  # very database bytes. The files database must name the same packages with
  # the same sha256, or pacman -F would describe other packages. A server that
  # fails gives way to the next one with the same bytes.
  #-------------------------------------------------------------------------#
  local files_ok=0 s sig_rc sig_done
  while IFS=$'\t' read -r idx srv sha; do
    [ "$sha" = "$chosen_sha" ] || continue
    rc=0
    fetch_upstream "$srv/$repo.files" "$dir/upstream.files" "$FILES_MAX_TIME" || rc=$?
    if [ "$rc" -ne 0 ]; then
      log "$name: $srv/$repo.files did not answer within ${FILES_MAX_TIME}s (status $rc)"
      continue
    fi
    if ! db_records "$dir/upstream.files" "$dir/files.tsv"; then
      warn "$name: $srv/$repo.files does not read as a tar archive"
      continue
    fi
    # Every (file, sha256) of the files database must be in the database. A
    # files database that leaves packages out is accepted and the packages are
    # named: upstream serves it so to its own users too (Arch Linux ARM
    # aarch64 aur.files left out localepurge, 2026-10-14), and pacman -F only
    # knows less. One that names a package the database does not is refused.
    cut -f 1,5 "$dir/files.tsv" | sort -u > "$dir/files-pairs.txt"
    cut -f 1,5 "$dir/records.tsv" | sort -u > "$dir/db-pairs.txt"
    comm -23 "$dir/files-pairs.txt" "$dir/db-pairs.txt" > "$dir/files-extra.txt"
    comm -13 "$dir/files-pairs.txt" "$dir/db-pairs.txt" | cut -f 1 > "$dir/files-missing.txt"
    if [ -s "$dir/files-extra.txt" ]; then
      warn "$name: $srv/$repo.files names $(awk 'END { print NR + 0 }' "$dir/files-extra.txt") package file(s) that $repo.db does not, e.g. $(awk -F '\t' 'NR == 1 { print $1 " sha256 " $2 }' "$dir/files-extra.txt")"
      continue
    fi
    if [ -s "$dir/files-missing.txt" ]; then
      warn "$name: $srv/$repo.files leaves out $(awk 'END { print NR + 0 }' "$dir/files-missing.txt") package(s) of $repo.db, as upstream serves it: $(tr '\n' ' ' < "$dir/files-missing.txt")"
    fi
    # A signature is absent only when the server says so with a 404; any other
    # failure would otherwise turn a signed database into an unsigned one.
    sig_done=1
    for s in db files; do
      rm -f "$dir/upstream.$s.sig"
      sig_rc=0
      fetch_upstream "$srv/$repo.$s.sig" "$dir/upstream.$s.sig" "$SIG_MAX_TIME" || sig_rc=$?
      case "$sig_rc" in
        0) log "$name: upstream signs $repo.$s" ;;
        4) ;;
        *)
          log "$name: $srv/$repo.$s.sig did not answer (status $sig_rc)"
          sig_done=0
          ;;
      esac
    done
    [ "$sig_done" -eq 1 ] || continue
    files_ok=1
    break
  done < "$dir/cand/list.tsv"
  if [ "$files_ok" -ne 1 ]; then
    set_state "$dir" error "no db_server that served $repo.db $chosen_sha also served a $repo.files that matches it, and an answer for its signatures"
    return 0
  fi
  if [ "$(target_get "$conf" db_signed)" = yes ]; then
    for s in db files; do
      if [ ! -f "$dir/upstream.$s.sig" ]; then
        set_state "$dir" error "db_signed = yes and $repo.$s.sig answered 404"
        return 0
      fi
    done
  fi

  #-------------------------------------------------------------------------#
  # 5. Skip or todo
  #-------------------------------------------------------------------------#
  cut -f 1 "$dir/records.tsv" | "$WRAPPER" --tags > "$dir/pairs.tsv"
  awk -F '\t' -v OFS='\t' -v target="$name" '
    FILENAME == ARGV[1] { promoted[$1] = $5; psig[$1] = $8; next }
    FILENAME == ARGV[2] { tag[$1] = $2; next }
    ($1 in promoted) && promoted[$1] == $5 && psig[$1] == $8 { next }
    { print target, $1, tag[$1], $5, $6, $2, "todo", $7, $8 }
  ' "$dir/promoted.tsv" "$dir/pairs.tsv" "$dir/records.tsv" > "$dir/todo.tsv"
  local resigned
  resigned="$(awk -F '\t' 'FILENAME == ARGV[1] { p[$1] = $5; s[$1] = $8; next } ($2 in p) && p[$2] == $4 && s[$2] != $9 { n++ } END { print n + 0 }' \
    "$dir/promoted.tsv" "$dir/todo.tsv")"
  if [ "$resigned" -gt 0 ]; then
    log "$name: $resigned file(s) keep their bytes and carry a new %PGPSIG%; mirror-file repairs their signature layers"
  fi

  #-------------------------------------------------------------------------#
  # 6. This target's shards
  #-------------------------------------------------------------------------#
  shard_target "$dir" "$name"

  set_state "$dir" pending "$(awk 'END { print NR + 0 }' "$dir/todo.tsv") file(s) to mirror, $(awk -F '\t' '{ s += $5 } END { printf "%.0f", s / 1048576 }' "$dir/todo.tsv") MiB, in $(find "$dir/shards" -name '*.tsv' | awk 'END { print NR + 0 }') shard(s), database from $chosen_server$(nul_note "$dir")"
}

for conf in "$@"; do
  plan_target "$conf"
  prune "$out/$(target_get "$conf" arch)-$(target_get "$conf" repo)"
done

#---------------------------------------------------------------------------#
# The matrices: one entry per pending target, with its shards
#---------------------------------------------------------------------------#
: > "$out/with-files.jsonl"
: > "$out/no-files.jsonl"
for d in "$out"/*/; do
  d="${d%/}"
  [ -f "$d/state" ] || continue
  [ "$(cat "$d/state")" = pending ] || continue
  t="$(basename "$d")"
  shards="$(find "$d/shards" -name '*.tsv' -type f | sed 's|.*/||; s|\.tsv$||' | sort -n | jq -R 'tonumber' | jq -cs .)"
  if [ "$shards" = '[]' ]; then
    jq -cn --arg t "$t" '{target: $t, shards: []}' >> "$out/no-files.jsonl"
  else
    jq -cn --arg t "$t" --argjson s "$shards" '{target: $t, shards: $s}' >> "$out/with-files.jsonl"
  fi
done
jq -cs '{include: .}' "$out/with-files.jsonl" > "$out/targets.json"
jq -cs '{include: .}' "$out/no-files.jsonl" > "$out/pending.json"
rm -f "$out/with-files.jsonl" "$out/no-files.jsonl"

{
  printf 'target\tstate\tfiles\tMiB\twhy\n'
  for d in "$out"/*/; do
    d="${d%/}"
    [ -f "$d/state" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$(basename "$d")" "$(cat "$d/state")" \
      "$(awk 'END { print NR + 0 }' "$d/todo.tsv")" \
      "$(awk -F '\t' '{ s += $5 } END { printf "%.0f", s / 1048576 }' "$d/todo.tsv")" \
      "$(cat "$d/why")"
  done
} > "$out/summary.tsv"

pending="$(jq -s '[.[].include[]] | length' "$out/targets.json" "$out/pending.json")"
log "$pending target(s) pending: $(jq -r '[.include[] | "\(.target) (\(.shards | length) shard(s))"] | join(", ")' "$out/targets.json")$(jq -r '[.include[].target] | if length > 0 then "; with no file to mirror: " + join(", ") else "" end' "$out/pending.json")"
if [ -n "${GITHUB_OUTPUT:-}" ]; then
  {
    printf 'targets=%s\n' "$(jq -cs '{include: [.[].include[]]}' "$out/targets.json" "$out/pending.json")"
    if [ "$pending" -gt 0 ]; then echo "has_targets=true"; else echo "has_targets=false"; fi
    jq -r -s '[.[].include[].target] | to_entries[] | "slot\(.key)=\(.value)"' "$out/targets.json" "$out/pending.json"
  } >> "$GITHUB_OUTPUT"
fi
