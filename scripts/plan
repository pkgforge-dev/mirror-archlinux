#!/usr/bin/env bash
#
# Decide what one sync run has to do, per target, and split each target's work
# into shards of its own.
#
#   scripts/plan OUT [TARGET.conf ...]
#
# No TARGET means every enabled target in $TARGETS_DIR. For each target:
#
#   1. Read the database from every db_server, the distribution's own hosts,
#      each fetch with a deadline; a db_server that fails gives way to the next.
#      Refuse one that is not whole and well formed: every field checked
#      against its grammar, one record per package directory (lib.sh db_check;
#      a directory whose desc holds only NUL bytes is counted and named, not
#      refused).
#   2. Read the promoted database the way a consumer does: anonymously, through
#      client/pacman-oci. None on a first run. A package that answers only with
#      the workflow's token is private, and is planned with that token.
#   3. Drop every candidate that is behind the promoted database, or behind
#      another candidate: some package in it was built before the same package
#      in the other. Take the first one left, in db_server order, unless it
#      differs from the promoted database only by packages added or dropped
#      while a db_server still serves the promoted one. ALLOW_OLDER (target
#      names, comma separated) skips the promoted comparison for a deliberate
#      upstream downgrade.
#   3b. Read the index of this ref (lib.sh index_read, the tag INDEX_TAG),
#      as step 2 reads latest: anonymously, then with the workflow's token.
#      A file is "indexed" when the index lists it with state m and its
#      ref.db record has the same sha256 and %PGPSIG% as the chosen record:
#      an earlier run of the ref left it on the registry. INDEX_STATE is ok,
#      absent, invalid (not used), unread (no answer that decides, or
#      REGISTRY_READ_BUDGET is spent; a warning, and the target plans as with
#      no index), or ignored (INDEX_READ=0: its rows are not read, and the
#      run writes a new index). With ignored, plan reads the manifest of the
#      tag alone (index_seen): its digest, or that there is no tag, tells
#      scripts/index-write which index the new one replaces.
#   4. The files promoted or indexed with no signature (the
#      dev.pkgforge.mirror.unsigned annotation of latest, scripts/stage, and
#      the indexed files with unsigned 1): each one's .sig is asked for again.
#      One that upstream signs now is planned again, so mirror-file adds its
#      signature layer.
#   4b. The files with the promoted or indexed sha256 and no %PGPSIG% on
#      either side, which step 6 would skip: SIGCHECK_SAMPLE of them, sorted
#      by name, from an offset that moves on each 3-hour run (MIRROR_NOW fixes
#      the clock). For each, upstream's .sig (the first server in the
#      target's order that answers with a signature packet) is compared with
#      the signature layer of its tag. One that differs is planned again, so
#      mirror-file pushes it again with the same package blob. When more than
#      SIGCHECK_ESCALATE of one sample differ, every such file of the target
#      is planned, and the plan warns. A file whose tag or .sig did not read
#      waits for a later run.
#   Steps 4 and 4b run when there is a promoted database or the index reads
#   ok.
#   5. The same bytes as the promoted database, and no file planned again by
#      step 4 or 4b: the target is current.
#   6. Otherwise every file is skip, when the promoted database or the index
#      names it with the same sha256 and the same %PGPSIG% (no request made),
#      or todo. A file is todo also when the index lists it as absent
#      upstream (state a) and the promoted database does not name it, or
#      when step 4 or 4b plans it again.
#      scripts/mirror-file reads each todo file's tag before writing it: it
#      never overwrites a package layer, and it repairs a signature layer that
#      upstream signed again. The files to verify (new.tsv) are the todo
#      files and every file that is not promoted and not indexed as verified
#      under this run's verify context (lib.sh verify_context).
#   6b. Before any tag is written: plan withdraws from the index every row
#      (state m) of a todo file. It pushes the index again without them, with
#      the same ref.db and annotations, and reads it back. The annotation
#      dev.pkgforge.mirror.withdrawn-by names this plan. A push or read back
#      that fails puts the target in error. oras is installed only for this.
#   6c. Registry sources: the todo files whose bytes a sibling holds. A
#      sibling is an enabled target of TARGETS_DIR with a db_server of the
#      same URL. It holds what its latest database names, and what its index
#      lists with state m.
#   7. The todo files of the target go into its own shards: k = the larger of
#      ceil(bytes / SHARD_BYTES) and ceil(files / SHARD_FILES), at least 1, at
#      most MAX_SHARDS and the file count; largest file first onto the lightest
#      shard. A target never waits for another target's shards.
#
# ⛔ The plan ends within PLAN_BUDGET seconds of upstream reads (default 1200),
# below the plan job's timeout-minutes (40). Each target gets a share: what is
# left of the budget, divided by the targets not yet read. A fast target
# leaves its unused share to the targets after it; a slow one cannot take
# theirs. Each upstream read ends within its own deadline, or within a part of
# what is left of the share when that is less: a db_server gets 1/(n + 1) of
# it, with n the db_servers not yet read, so a slow first db_server leaves
# time for the next one and for the files database. A target whose reads do
# not fit is in error for this run, and its why names PLAN_BUDGET.
#
# ⛔ The registry reads of steps 3b, 6 (the latest database of keyring_from,
# for the verify context) and 6c share one budget for the whole plan,
# REGISTRY_READ_BUDGET seconds (default 240). The budget stops each new read:
# a read is not made when the reads before it took the whole budget. Each
# blob and token read has a deadline of 60 s, or what is left of the budget
# when that is less. A manifest read has its own deadline (lib.sh
# registry_get_manifest: 60 s, 3 retries), so one read in progress can run
# past the budget by up to about 4 minutes. A read that is not made costs work:
# the index is unread, the verify context is not known, or a sibling gives no
# source. An unread index is safe because scripts/mirror-file writes no
# repush for it, and a push goes only to an absent tag.
#
# Each upstream read of a .files database, a database signature or a package
# .sig that answers is kept for the rest of the plan (OUT/.fetch-cache,
# removed at the end). The three base-any targets read the same URLs once.
# A <repo>.db is never kept.
#
# OUT/plan-id               this plan's id: the run, its attempt and a random
#                           number, also in OUT/<target>/plan-id. Every
#                           artifact a chain makes from this plan carries it
#                           (scripts/mirror-shard, stage, report), and stage
#                           and report read nothing of another plan.
# OUT/<target>/state        current pending behind held error
# OUT/<target>/why          one line saying what was measured
# OUT/<target>/upstream.db  the chosen database, byte for byte, and .files and
#                           any .sig the upstream publishes beside them
# OUT/<target>/records.tsv  its records (lib.sh db_records)
# OUT/<target>/nul.txt      its package directories whose desc is NUL bytes only
# OUT/<target>/todo.tsv     the files this run mirrors
# OUT/<target>/new.tsv      the files this run verifies, work lines too: each
#                           todo file (action todo), and each other file that
#                           is not promoted and not indexed as verified under
#                           VERIFY_CONTEXT (action verify)
# OUT/<target>/vouched.tsv  filename, verified, unsigned: each indexed file
#                           that is not todo, for scripts/index-write. verified
#                           is the index's flag when VERIFY_CONTEXT is not known
#                           or equals INDEX_CONTEXT, else 0. unsigned is the
#                           index's flag, or 1 when unsigned.txt names the file.
# OUT/<target>/sources.tsv  filename, repository: a sibling repository that
#                           holds the bytes of a todo file (step 6c)
# OUT/<target>/unsigned.txt the files promoted or indexed with no signature
#                           that are not planned again: upstream still has no
#                           .sig for them, or did not answer. scripts/stage
#                           lists them again.
# OUT/<target>/shards/<n>.tsv  the work lines of shard n, for scripts/mirror-shard
# OUT/<target>/meta.env     KEY=VALUE facts stage writes into the manifest; for
#                           a pending target also INDEX_TAG, INDEX_STATE,
#                           INDEX_DIGEST (sha256:<hex> of the index manifest
#                           read, or pushed by step 6b; empty unless the state
#                           is ok or invalid, or ignored and the tag read),
#                           INDEX_PRIOR (absent when the state is ignored and
#                           the registry has no such tag, else empty),
#                           INDEX_CONTEXT (the
#                           verify-context of that index), VERIFY_CONTEXT (this
#                           run's, empty when not known) and INDEX_CONTEXT_OUT
#                           (VERIFY_CONTEXT, or INDEX_CONTEXT when that is
#                           empty: the verify-context of the index this run
#                           writes)
# OUT/targets.json          {"include":[{"target":T,"shards":[0,1,..]},..]}: the
#                           pending targets with files to mirror
# OUT/pending.json          the same shape, "shards":[], for the pending targets
#                           with no file to mirror (a database that only
#                           dropped packages, or whose new files the index
#                           names): they still stage and verify
# OUT/summary.tsv           target, state, files, MiB, why
#
# Work line: target filename tag sha256 csize name action builddate pgpsig, tab
# separated. pgpsig is last because it may be empty.
#
# In Actions, GITHUB_OUTPUT gets targets (targets.json and pending.json as one
# matrix), has_targets, and slotN=TARGET for each pending target, which the
# workflow's upload steps read to upload OUT/<target> as plan-<target>.
#
# Environment: SHARD_BYTES (default 536870912), SHARD_FILES (400), MAX_SHARDS
# (32, per target), PLAN_BUDGET (1200 s), REGISTRY_READ_BUDGET (240 s),
# SIGCHECK_SAMPLE (64, per target), SIGCHECK_ESCALATE (8), ALLOW_OLDER,
# INDEX_READ (1; 0 does not read the index), INDEX_TAG and STAGING_TAG (lib.sh
# index_tag), INDEX_RATE_WAIT (lib.sh index_push), MIRROR_NAMESPACE,
# REGISTRY_USER and REGISTRY_TOKEN (to tell a private package from an absent
# one, and to push the index in step 6b).
#
# Exit status: 0 planned, whatever state each target is in; 1 no plan could be
# made at all.
set -euo pipefail
SCRIPT_NAME=plan
# shellcheck source=lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need curl jq awk tar sha256sum timeout

out="${1:-}"
[ -n "$out" ] || die "usage: scripts/plan OUT [TARGET.conf ...]"
shift
[ -n "$MIRROR_NAMESPACE" ] || die "MIRROR_NAMESPACE is not set and GITHUB_REPOSITORY gives none"

SHARD_BYTES="${SHARD_BYTES:-536870912}"
SHARD_FILES="${SHARD_FILES:-400}"
MAX_SHARDS="${MAX_SHARDS:-32}"
PLAN_BUDGET="${PLAN_BUDGET:-1200}"
REGISTRY_READ_BUDGET="${REGISTRY_READ_BUDGET:-240}"
SIGCHECK_SAMPLE="${SIGCHECK_SAMPLE:-64}"
SIGCHECK_ESCALATE="${SIGCHECK_ESCALATE:-8}"
for v in SHARD_BYTES SHARD_FILES MAX_SHARDS PLAN_BUDGET REGISTRY_READ_BUDGET SIGCHECK_SAMPLE SIGCHECK_ESCALATE; do
  case "${!v}" in
    '' | *[!0-9]* | 0) die "$v must be a positive integer, not '${!v}'" ;;
  esac
done
INDEX_READ="${INDEX_READ:-1}"
case "$INDEX_READ" in
  0 | 1) ;;
  *) die "INDEX_READ must be 0 or 1, not '$INDEX_READ'" ;;
esac
INDEX_TAG="$(index_tag)"
# Whole-transfer deadlines for what plan reads from upstream, in seconds. The
# largest measured (2026-10-14): x86_64 extra.files, 51452041 bytes.
DB_MAX_TIME=300
FILES_MAX_TIME=900
SIG_MAX_TIME=60
# The deadline of each registry read that REGISTRY_READ_BUDGET bounds.
REG_READ_MAX_TIME=60
run_deadline=$((SECONDS + PLAN_BUDGET))
# The seconds the registry reads of REGISTRY_READ_BUDGET took so far
reg_spent=0
# oras, installed when step 6b first needs it
oras_bin=""
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/registry"

if [ -n "${GITHUB_RUN_ID:-}" ]; then
  plan_id="$GITHUB_RUN_ID.${GITHUB_RUN_ATTEMPT:-1}.$RANDOM"
else
  plan_id="local.$(date -u +%s).$$.$RANDOM"
fi

if [ "$#" -eq 0 ]; then
  for conf in "$TARGETS_DIR"/*.conf; do
    [ -e "$conf" ] || continue
    if target_enabled "$conf"; then
      set -- "$@" "$conf"
    fi
  done
fi
[ "$#" -gt 0 ] || die "no enabled target" "reproduce: ls $TARGETS_DIR"

mkdir -p "$out"
rm -rf "$out/.fetch-cache"
mkdir -p "$out/.fetch-cache"
fetched="$(iso_now)"
printf '%s\n' "$plan_id" > "$out/plan-id"
log "plan $plan_id: $# target(s), PLAN_BUDGET=${PLAN_BUDGET}s, REGISTRY_READ_BUDGET=${REGISTRY_READ_BUDGET}s, index tag $INDEX_TAG"

# set_state DIR STATE WHY
set_state() {
  printf '%s\n' "$2" > "$1/state"
  printf '%s\n' "$3" > "$1/why"
  log "$(basename "$1"): $2: $3"
}

#---------------------------------------------------------------------------#
# The budget
#---------------------------------------------------------------------------#
# share_start TARGETS_LEFT: this target's share of what is left of PLAN_BUDGET
share_start() {
  local left=$((run_deadline - SECONDS))
  if [ "$left" -lt 0 ]; then
    left=0
  fi
  share=$((left / $1))
  share_deadline=$((SECONDS + share))
  budget_cut=0
}

# fetch_within URL OUT MAX PARTS [KEY] -> fetch_upstream's status. The
# deadline is MAX, or what is left of the share divided by PARTS when that is
# less; with nothing left, status 1 and no request. Sets fetch_max to the
# deadline used, and budget_cut when a read failed with less time than MAX,
# or was not made. KEY, when given, keeps a read that answers (status 0) in
# OUT/.fetch-cache: a later read with the same KEY copies it, with no request
# and no time of the share, and sets fetch_max to 0.
fetch_within() {
  local url="$1" outfile="$2" own="$3" parts="$4" key="${5:-}" rc=0 cached=""
  if [ -n "$key" ]; then
    cached="$out/.fetch-cache/$(printf '%s' "$key" | sha256sum | cut -d ' ' -f 1)"
    if [ -f "$cached" ] && cp "$cached" "$outfile"; then
      fetch_max=0
      log "$url: read earlier in this plan; that copy is used"
      return 0
    fi
  fi
  fetch_max=$(((share_deadline - SECONDS) / parts))
  if [ "$fetch_max" -gt "$own" ]; then
    fetch_max="$own"
  fi
  if [ "$fetch_max" -lt 1 ]; then
    fetch_max=0
    budget_cut=1
    log "$url: not read, nothing is left of the target's share of PLAN_BUDGET (${share}s)"
    return 1
  fi
  fetch_upstream "$url" "$outfile" "$fetch_max" || rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 4 ] && [ "$fetch_max" -lt "$own" ]; then
    budget_cut=1
  fi
  if [ "$rc" -eq 0 ] && [ -n "$cached" ] && ! cp "$outfile" "$cached"; then
    log "$url: the copy for later reads of this plan could not be kept"
    rm -f -- "$cached"
  fi
  return "$rc"
}

# budget_note -> "; ..." when a read of this target failed for want of time
budget_note() {
  [ "$budget_cut" -eq 1 ] || return 0
  printf '; a read had less time than its own deadline, to fit the target'\''s share (%ss) of PLAN_BUDGET=%ss' "$share" "$PLAN_BUDGET"
}

allowed_older() {
  case ",${ALLOW_OLDER:-}," in
    *",$1,"*) return 0 ;;
    *) return 1 ;;
  esac
}

# nul_note DIR -> " (N package directory(ies) hold only NUL bytes: a b)", or nothing
nul_note() {
  local n
  n="$(awk 'END { print NR + 0 }' "$1/nul.txt")"
  [ "$n" -gt 0 ] || return 0
  printf '; %s package directory(ies) whose desc holds only NUL bytes, passed over: %s' "$n" "$(tr '\n' ' ' < "$1/nul.txt" | sed 's/ $//')"
}

#---------------------------------------------------------------------------#
# Registry reads: the index, the keyring of keyring_from, the siblings
#---------------------------------------------------------------------------#
# reg_time -> the deadline of the next registry read that REGISTRY_READ_BUDGET
# bounds: REG_READ_MAX_TIME, or what is left of the budget when that is less;
# 0 when nothing is left
reg_time() {
  local left=$((REGISTRY_READ_BUDGET - reg_spent))
  if [ "$left" -gt "$REG_READ_MAX_TIME" ]; then
    left="$REG_READ_MAX_TIME"
  fi
  if [ "$left" -lt 1 ]; then
    left=0
  fi
  printf '%s\n' "$left"
}

# index_of REPO DIR DB...: REPO:$INDEX_TAG into DIR (lib.sh index_read),
# anonymously first, then with the workflow's token when that is not ok or
# invalid, as step 2 reads latest. Sets reg_state, and reg_private to 1 only
# when the anonymous read is absent and the token read is ok: an anonymous
# read that got no answer that decides says nothing about the package. The
# time it takes counts in REGISTRY_READ_BUDGET.
index_of() {
  local repo="$1" d="$2" t rc=0 started="$SECONDS" anon
  shift 2
  reg_state=unread
  reg_private=0
  t="$(reg_time)"
  if [ "$t" -eq 0 ]; then
    log "$repo:$INDEX_TAG: not read, REGISTRY_READ_BUDGET=${REGISTRY_READ_BUDGET}s is spent"
    return 0
  fi
  reg_state="$(REGISTRY_TOKEN='' REG_BLOB_MAX_TIME="$t" REG_TOKEN_MAX_TIME="$t" index_read "$repo" "$INDEX_TAG" "$d" "$@")" || rc=$?
  reg_spent=$((reg_spent + SECONDS - started))
  if [ "$rc" -ne 0 ]; then
    reg_state=unread
  fi
  case "$reg_state" in
    ok | invalid) return 0 ;;
  esac
  anon="$reg_state"
  if [ -z "${REGISTRY_TOKEN:-}" ] && [ "$MIRROR_REGISTRY_AUTH" != none ]; then
    return 0
  fi
  t="$(reg_time)"
  if [ "$t" -eq 0 ]; then
    log "$repo:$INDEX_TAG: not read with the workflow's token, REGISTRY_READ_BUDGET=${REGISTRY_READ_BUDGET}s is spent"
    reg_state=unread
    return 0
  fi
  rc=0
  started="$SECONDS"
  reg_state="$(REG_BLOB_MAX_TIME="$t" REG_TOKEN_MAX_TIME="$t" index_read "$repo" "$INDEX_TAG" "$d" "$@")" || rc=$?
  reg_spent=$((reg_spent + SECONDS - started))
  if [ "$rc" -ne 0 ]; then
    reg_state=unread
  fi
  if [ "$reg_state" = ok ] && [ "$anon" = absent ]; then
    reg_private=1
  fi
}

# latest_records CONF OUT: the records of the database that latest names in
# the repository of CONF, into OUT. The read is anonymous, as verify-batch
# and a consumer read it. Each database is read once per plan, by its layer
# digest. Sets reg_state: ok, absent (no latest), or unread. The time it
# takes counts in REGISTRY_READ_BUDGET.
latest_records() {
  local started="$SECONDS"
  reg_state=unread
  latest_read "$@"
  reg_spent=$((reg_spent + SECONDS - started))
}

# latest_read CONF OUT: latest_records, with no count of the time
latest_read() {
  local conf="$1" outfile="$2" path frepo t rc=0 d hex m="$tmp/latest.json"
  path="$(target_repository "$conf")"
  frepo="$(target_get "$conf" repo)"
  t="$(reg_time)"
  if [ "$t" -eq 0 ]; then
    log "$path:latest: not read, REGISTRY_READ_BUDGET=${REGISTRY_READ_BUDGET}s is spent"
    return 0
  fi
  REGISTRY_TOKEN='' REG_TOKEN_MAX_TIME="$t" registry_manifest "$path" latest "$m" || rc=$?
  case "$rc" in
    "$REG_STATUS_OK") ;;
    "$REG_STATUS_ABSENT")
      reg_state=absent
      return 0
      ;;
    *)
      log "$path:latest did not read (status $rc)"
      return 0
      ;;
  esac
  read -r d _ _ <<< "$(manifest_layer "$m" "$frepo.db")"
  if [[ ! "$d" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    warn "$path:latest holds no single $frepo.db layer"
    return 0
  fi
  hex="${d#sha256:}"
  if [ ! -f "$tmp/registry/$hex.tsv" ]; then
    t="$(reg_time)"
    if [ "$t" -eq 0 ]; then
      log "$path: $frepo.db ($d) not read, REGISTRY_READ_BUDGET=${REGISTRY_READ_BUDGET}s is spent"
      return 0
    fi
    if ! REGISTRY_TOKEN='' REG_BLOB_MAX_TIME="$t" REG_TOKEN_MAX_TIME="$t" registry_blob "$path" "$d" "$tmp/registry/$hex.db"; then
      return 0
    fi
    # `if !`: db_records must not be called bare (lib.sh).
    if ! db_records "$tmp/registry/$hex.db" "$tmp/registry/$hex.part"; then
      warn "$path:latest names a $frepo.db ($d) that does not read as a tar archive"
      return 0
    fi
    mv -f "$tmp/registry/$hex.part" "$tmp/registry/$hex.tsv"
    rm -f "$tmp/registry/$hex.db"
  fi
  cp "$tmp/registry/$hex.tsv" "$outfile"
  reg_state=ok
}

# keyring_records CONF DIR OUT -> 0, with the records verify installs the
# keyring packages from in OUT (lib.sh verify_context); 1 when they did not
# read. These are the target's own records (DIR/records.tsv), or with
# keyring_from the records of the latest database of that target, or the one
# line none when it has no latest.
keyring_records() {
  local conf="$1" dir="$2" outfile="$3" from from_conf
  from="$(target_get "$conf" keyring_from)"
  if [ -z "$from" ]; then
    cp "$dir/records.tsv" "$outfile"
    return 0
  fi
  from_conf="$(dirname "$conf")/$from.conf"
  target_check "$from_conf"
  latest_records "$from_conf" "$outfile"
  case "$reg_state" in
    ok) return 0 ;;
    absent)
      printf 'none\n' > "$outfile"
      return 0
      ;;
  esac
  return 1
}

# oras_ready -> 0 when oras_bin and ORAS_CONFIG are ready to push: oras is
# installed and logged in once per plan
oras_ready() {
  local bin rc=0
  [ -z "$oras_bin" ] || return 0
  if [ "$MIRROR_REGISTRY_AUTH" != none ] && [ -z "${REGISTRY_TOKEN:-}" ]; then
    warn "REGISTRY_TOKEN is not set, and the index cannot be pushed without it"
    return 1
  fi
  bin="$("$REPO_ROOT/scripts/install-oras" "$tmp/bin")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    warn "could not install oras (scripts/install-oras ended $rc)"
    return 1
  fi
  ORAS_CONFIG="$tmp/oras-auth.json"
  oras_login "$bin" "$ORAS_CONFIG" || rc=$?
  if [ "$rc" -ne 0 ]; then
    warn "oras could not log in to $MIRROR_REGISTRY (status $rc)"
    return 1
  fi
  oras_bin="$bin"
}

# index_seen REPO: with INDEX_READ=0, the manifest of REPO:$INDEX_TAG alone,
# read with the workflow's token as it is set. No blob is read, and no row is
# used. Sets seen_digest to sha256:<hex> of the manifest bytes when the tag
# is there, and seen_prior to absent when the registry has no such tag; both
# stay empty when there is no answer that decides. scripts/index-write then
# replaces only the index plan saw. The time it takes counts in
# REGISTRY_READ_BUDGET.
index_seen() {
  local repo="$1" t rc=0 started="$SECONDS"
  seen_digest=""
  seen_prior=""
  t="$(reg_time)"
  if [ "$t" -eq 0 ]; then
    log "$repo:$INDEX_TAG: not read, REGISTRY_READ_BUDGET=${REGISTRY_READ_BUDGET}s is spent"
    return 0
  fi
  REG_TOKEN_MAX_TIME="$t" registry_manifest "$repo" "$INDEX_TAG" "$tmp/index-seen.json" || rc=$?
  reg_spent=$((reg_spent + SECONDS - started))
  case "$rc" in
    "$REG_STATUS_OK") seen_digest="sha256:$(sha256sum "$tmp/index-seen.json" | cut -d ' ' -f 1)" ;;
    "$REG_STATUS_ABSENT") seen_prior=absent ;;
    *) log "$repo:$INDEX_TAG did not read (status $rc)" ;;
  esac
  rm -f -- "$tmp/index-seen.json"
}

# index_withdraw REPO DIR -> 0 when REPO:$INDEX_TAG is pushed again without
# the rows of the files in DIR/withdraw.txt, with the same ref.db and the same
# annotations (lib.sh index_push), and reads back so. The one annotation
# dev.pkgforge.mirror.withdrawn-by is added, or replaced: it names this plan,
# so that scripts/index-write of the plan that wrote the index does not take
# it for its own. Sets reg_digest to the digest of the manifest read back.
index_withdraw() {
  local repo="$1" d="$2" p="$2/push" rc=0 attempt want got n annotations=()
  rm -rf "$p"
  mkdir -p "$p"
  if ! cp "$d/ref.db" "$p/ref.db"; then
    warn "$repo:$INDEX_TAG: its ref.db could not be copied to $p"
    return 1
  fi
  if ! awk -F '\t' 'FILENAME == ARGV[1] { w[$0] = 1; next } !($1 in w)' "$d/withdraw.txt" "$d/index.tsv" | LC_ALL=C sort > "$p/index.tsv"; then
    warn "$repo:$INDEX_TAG: the index without the withdrawn rows could not be written to $p"
    return 1
  fi
  # The annotations as they are, NUL separated: a value may hold any byte.
  # withdrawn-by is left out here, and added below with this plan's id.
  n="$(jq '[.annotations // {} | to_entries[] | select(.key != "dev.pkgforge.mirror.withdrawn-by")] | length' "$d/manifest.json")"
  mapfile -d '' -t annotations < <(jq -j '.annotations // {} | to_entries[] | select(.key != "dev.pkgforge.mirror.withdrawn-by") | "\(.key)=\(.value)\u0000"' "$d/manifest.json")
  if [ "${#annotations[@]}" != "$n" ]; then
    warn "$repo:$INDEX_TAG: $n annotation(s) in its manifest, and ${#annotations[@]} read"
    return 1
  fi
  annotations+=("dev.pkgforge.mirror.withdrawn-by=$plan_id")
  oras_ready || return 1
  index_push "$oras_bin" "$repo" "$INDEX_TAG" "$p" "${annotations[@]}" || return 1
  want="sha256:$(sha256sum "$p/index.tsv" | cut -d ' ' -f 1)"
  for attempt in 1 2 3 4 5; do
    rc=0
    registry_manifest "$repo" "$INDEX_TAG" "$p/manifest.json" || rc=$?
    if [ "$rc" -eq "$REG_STATUS_OK" ]; then
      read -r got _ _ <<< "$(manifest_layer "$p/manifest.json" index.tsv)"
      if [ "$got" = "$want" ]; then
        reg_digest="sha256:$(sha256sum "$p/manifest.json" | cut -d ' ' -f 1)"
        return 0
      fi
    fi
    if [ "$attempt" -lt 5 ]; then
      sleep $((attempt * 2))
    fi
  done
  warn "$repo:$INDEX_TAG does not read back with the index.tsv just pushed ($want) in 5 tries"
  return 1
}

# sibling_hints CONF DIR: DIR/sources.tsv, filename and repository, for each
# todo file whose filename and sha256 a sibling holds. A sibling is an
# enabled target of TARGETS_DIR, not this one, with a db_server of the same
# URL. It holds what its latest database names, and what its index lists
# with state m.
sibling_hints() {
  local conf="$1" dir="$2" s="$2/sources" c path n
  mkdir -p "$s"
  target_all "$conf" db_server > "$s/servers.txt"
  for c in "$TARGETS_DIR"/*.conf; do
    [ -e "$c" ] || continue
    [ "$(basename "$c")" != "$(basename "$conf")" ] || continue
    target_all "$c" db_server > "$s/other-servers.txt"
    n="$(awk 'FILENAME == ARGV[1] { s[$0] = 1; next } ($0 in s) { n++ } END { print n + 0 }' "$s/servers.txt" "$s/other-servers.txt")"
    [ "$n" -gt 0 ] || continue
    target_enabled "$c" || continue
    target_check "$c"
    path="$(target_repository "$c")"
    : > "$s/held.tsv"
    latest_records "$c" "$s/latest.tsv"
    if [ "$reg_state" = ok ]; then
      cut -f 1,5 "$s/latest.tsv" >> "$s/held.tsv"
    fi
    index_of "$path" "$s/index" "$dir/upstream.db" "$dir"/cand/*.db
    if [ "$reg_state" = ok ]; then
      awk -F '\t' -v OFS='\t' 'FILENAME == ARGV[1] { sha[$1] = $5; next } $2 == "m" && ($1 in sha) { print $1, sha[$1] }' \
        "$s/index/ref.tsv" "$s/index/index.tsv" >> "$s/held.tsv"
    fi
    awk -F '\t' -v OFS='\t' -v repo="$path" 'FILENAME == ARGV[1] { h[$1 "\t" $2] = 1; next } (($2 "\t" $4) in h) { print $2, repo }' \
      "$s/held.tsv" "$dir/todo.tsv" >> "$dir/sources.tsv"
  done
}

# shard_target DIR NAME: OUT/<target>/shards/<n>.tsv from its todo.tsv
shard_target() {
  local dir="$1" name="$2" files bytes k wanted
  mkdir -p "$dir/shards"
  files="$(awk 'END { print NR + 0 }' "$dir/todo.tsv")"
  bytes="$(awk -F '\t' '{ s += $5 } END { printf "%.0f\n", s }' "$dir/todo.tsv")"
  read -r k wanted <<< "$(shard_count "$files" "$bytes" "$SHARD_FILES" "$SHARD_BYTES" "$MAX_SHARDS")"
  if [ "$wanted" -gt "$MAX_SHARDS" ] && [ "$k" -gt 0 ]; then
    log "$name: $files file(s) and $((bytes / 1048576)) MiB want $wanted shard(s); MAX_SHARDS=$MAX_SHARDS caps them at $k: $(awk -v b="$bytes" -v k="$k" 'BEGIN { printf "%.2f", b / k / 1073741824 }') GiB and $(((files + k - 1) / k)) file(s) per shard"
  fi
  [ "$k" -gt 0 ] || return 0
  sort -t $'\t' -k5,5nr -k2,2 "$dir/todo.tsv" | awk -F '\t' -v k="$k" -v d="$dir/shards" '
    {
      best = 0
      for (i = 1; i < k; i++) if (load[i] < load[best]) best = i
      load[best] += $5
      print > (d "/" best ".tsv")
    }
  '
}

# prune DIR: drop what only plan reads, so the target's artifact holds what
# stage and mirror read and nothing else
prune() {
  local dir="$1" f
  for f in "$dir"/cand/*.db "$dir"/cand/*.tsv "$dir"/cand/*.tsv.*; do
    [ -e "$f" ] || continue
    case "$f" in
      */cand/list.tsv | */cand/kept.tsv) ;;
      *) rm -f -- "$f" ;;
    esac
  done
  rm -f -- "$dir/promoted.db" "$dir/promoted.db.part" "$dir/promoted.tsv" "$dir/pairs.tsv" \
    "$dir/files.tsv" "$dir"/files.tsv.* "$dir/latest.json" "$dir/listed.txt" "$dir/recheck.txt" \
    "$dir/recheck.sig" "$dir/signed-now.txt" "$dir/sigcheck-all.txt" "$dir/sigcheck-sample.tsv" \
    "$dir/sigcheck-changed.txt" "$dir/sigcheck.json" "$dir/sigcheck.sig" "$dir/files-lagging.txt" \
    "$dir/indexed.tsv"
  # The reads of the index, the keyring records and the siblings: ref.db is
  # a whole database, and a shard downloads this directory.
  rm -rf -- "$dir/index" "$dir/sources"
}

plan_target() {
  local conf="$1" arch repo name dir repo_path server rc why i dbs=()
  target_check "$conf"
  arch="$(target_get "$conf" arch)"
  repo="$(target_get "$conf" repo)"
  name="$arch-$repo"
  dir="$out/$name"
  repo_path="$(target_repository "$conf")"
  rm -rf "$dir"
  mkdir -p "$dir/cand" "$dir/index"
  : > "$dir/todo.tsv"
  : > "$dir/new.tsv"
  : > "$dir/vouched.tsv"
  : > "$dir/sources.tsv"
  : > "$dir/indexed.tsv"
  : > "$dir/meta.env"
  : > "$dir/nul.txt"
  : > "$dir/unsigned.txt"
  : > "$dir/signed-now.txt"
  printf '%s\n' "$plan_id" > "$dir/plan-id"

  #-------------------------------------------------------------------------#
  # 1. Candidates, from the distribution's own servers only
  #-------------------------------------------------------------------------#
  i=0
  : > "$dir/cand/list.tsv"
  mapfile -t dbs < <(target_all "$conf" db_server)
  for server in "${dbs[@]}"; do
    [ -n "$server" ] || continue
    i=$((i + 1))
    rc=0
    fetch_within "$server/$repo.db" "$dir/cand/$i.db" "$DB_MAX_TIME" "$((${#dbs[@]} - i + 2))" || rc=$?
    if [ "$rc" -ne 0 ]; then
      log "$name: $server/$repo.db did not answer within ${fetch_max}s (status $rc); the next db_server is tried"
      continue
    fi
    rc=0
    why="$(db_check "$dir/cand/$i.db" "$dir/cand/$i.tsv")" || rc=$?
    if [ "$rc" -ne 0 ]; then
      warn "$name: refused the database from $server: $why" \
        "reproduce: curl -fsSLO $server/$repo.db && bash -c '. scripts/lib.sh; db_check $repo.db /tmp/records.tsv'"
      continue
    fi
    if [ -s "$dir/cand/$i.tsv.nul" ]; then
      log "$name: $server/$repo.db: $(awk 'END { print NR + 0 }' "$dir/cand/$i.tsv.nul") package directory(ies) whose desc holds only NUL bytes: $(tr '\n' ' ' < "$dir/cand/$i.tsv.nul")"
    fi
    printf '%s\t%s\t%s\n' "$i" "$server" "$(sha256sum "$dir/cand/$i.db" | cut -d ' ' -f 1)" >> "$dir/cand/list.tsv"
  done

  if [ ! -s "$dir/cand/list.tsv" ]; then
    set_state "$dir" error "no db_server answered with a whole, well-formed database$(budget_note)"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # 2. The promoted database, read as a consumer reads it
  #-------------------------------------------------------------------------#
  local promoted_sha="" private=0 anon_rc auth_rc="" layer_digest=""
  : > "$dir/promoted.tsv"
  anon_rc=0
  REGISTRY_TOKEN='' registry_manifest "$repo_path" latest "$dir/latest.json" || anon_rc=$?
  if [ "$anon_rc" -ne "$REG_STATUS_OK" ] && { [ -n "${REGISTRY_TOKEN:-}" ] || [ "$MIRROR_REGISTRY_AUTH" = none ]; }; then
    auth_rc=0
    registry_manifest "$repo_path" latest "$dir/latest.json" || auth_rc=$?
    if [ "$auth_rc" -eq "$REG_STATUS_OK" ]; then
      private=1
      warn "$name: $repo_path:latest reads only with the workflow's token; the package is private"
    fi
  fi
  if [ "$anon_rc" -eq "$REG_STATUS_OK" ] || [ "$private" -eq 1 ]; then
    read -r layer_digest _ _ <<< "$(manifest_layer "$dir/latest.json" "$repo.db")"
    if [ -z "$layer_digest" ]; then
      set_state "$dir" error "$repo_path:latest holds no single $repo.db layer"
      return 0
    fi
    if [ "$private" -eq 0 ]; then
      # The consumer's own path: the wrapper, no credential. This is promote's
      # read-back, repeated by every run.
      rc=0
      REGISTRY_TOKEN='' "$WRAPPER" "$dir/promoted.db.part" "$OCI_SCHEME://$MIRROR_REGISTRY/$repo_path/$repo.db" || rc=$?
      if [ "$rc" -ne 0 ]; then
        set_state "$dir" error "client/pacman-oci could not read $repo_path/$repo.db (exit $rc)"
        return 0
      fi
      mv -f "$dir/promoted.db.part" "$dir/promoted.db"
    elif ! registry_blob "$repo_path" "$layer_digest" "$dir/promoted.db"; then
      set_state "$dir" error "could not read the promoted $repo.db ($layer_digest)"
      return 0
    fi
    promoted_sha="$(sha256sum "$dir/promoted.db" | cut -d ' ' -f 1)"
    if [ "sha256:$promoted_sha" != "$layer_digest" ]; then
      set_state "$dir" error "$repo_path:latest names $layer_digest and serves $promoted_sha"
      return 0
    fi
    # `if !`, not a bare call: every script here runs set -e, and a promoted
    # database that does not read would end this shell inside db_records
    # instead of putting the target in error with a state file.
    if ! db_records "$dir/promoted.db" "$dir/promoted.tsv"; then
      set_state "$dir" error "the promoted database $repo_path:latest does not read as a tar archive"
      return 0
    fi
  elif [ "$anon_rc" -eq "$REG_STATUS_ABSENT" ] && [ "$auth_rc" != "$REG_STATUS_ERROR" ]; then
    log "$name: nothing promoted yet in $repo_path"
  else
    set_state "$dir" error "could not read $repo_path:latest, and an unreadable promotion is not a first run"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # 3. Nothing behind the promoted database, nothing behind another candidate
  #-------------------------------------------------------------------------#
  local idx srv sha newer older behind_promoted=0 other kept=0 chosen="" o_idx p_newer chosen_newer=1 promoted_kept=""
  : > "$dir/cand/kept.tsv"
  while IFS=$'\t' read -r idx srv sha; do
    p_newer=1
    if [ -s "$dir/promoted.tsv" ] && ! allowed_older "$name"; then
      read -r newer older <<< "$(behind "$dir/promoted.tsv" "$dir/cand/$idx.tsv")"
      p_newer="$newer"
      if [ "$older" -gt 0 ]; then
        behind_promoted=$((behind_promoted + 1))
        log "$name: $srv is behind what is promoted: $older package(s) older, $newer newer"
        awk -F '\t' 'FILENAME == ARGV[1] { b[$2] = $7; next } ($2 in b) && $7 + 0 < b[$2] + 0 { print "  " $2 " " b[$2] " -> " $7 }' \
          "$dir/promoted.tsv" "$dir/cand/$idx.tsv" | sed -n 1,5p >&2
        continue
      fi
    fi
    other=0
    while IFS=$'\t' read -r o_idx _ _; do
      [ "$o_idx" != "$idx" ] || continue
      read -r newer older <<< "$(behind "$dir/cand/$o_idx.tsv" "$dir/cand/$idx.tsv")"
      if [ "$older" -gt 0 ]; then
        other=1
        log "$name: $srv is behind another db_server: $older package(s) older"
        break
      fi
    done < "$dir/cand/list.tsv"
    [ "$other" -eq 0 ] || continue
    kept=$((kept + 1))
    printf '%s\t%s\t%s\n' "$idx" "$srv" "$sha" >> "$dir/cand/kept.tsv"
    if [ -n "$promoted_sha" ] && [ "$sha" = "$promoted_sha" ] && [ -z "$promoted_kept" ]; then
      promoted_kept="$idx"$'\t'"$srv"$'\t'"$sha"
    fi
    if [ -z "$chosen" ]; then
      chosen="$idx"$'\t'"$srv"$'\t'"$sha"
      chosen_newer="$p_newer"
    fi
  done < "$dir/cand/list.tsv"

  # A database that only adds or drops packages is not shown to be newer by
  # any build date: it may be an older copy from a server that lags. While a
  # db_server still serves the promoted database, that one is kept, and the
  # change is taken once every db_server agrees.
  if [ -n "$promoted_kept" ] && [ "$chosen_newer" -eq 0 ]; then
    chosen="$promoted_kept"
  fi

  if [ -z "$chosen" ]; then
    if [ "$behind_promoted" -eq "$(awk 'END { print NR + 0 }' "$dir/cand/list.tsv")" ]; then
      set_state "$dir" behind "every db_server answered a database older than the promoted one; ALLOW_OLDER=$name takes it anyway"
    else
      set_state "$dir" held "the db_servers disagree: each answered a database with some package older than another's"
    fi
    return 0
  fi

  local best chosen_server chosen_sha
  IFS=$'\t' read -r best chosen_server chosen_sha <<< "$chosen"
  cp "$dir/cand/$best.db" "$dir/upstream.db"
  cp "$dir/cand/$best.tsv" "$dir/records.tsv"
  cp "$dir/cand/$best.tsv.nul" "$dir/nul.txt"

  #-------------------------------------------------------------------------#
  # 3b. The index of this ref: the files earlier runs left on the registry.
  #     indexed.tsv: the ref.db record (8 fields), state, verified, unsigned
  #     of each valid row.
  #-------------------------------------------------------------------------#
  local index_state index_digest="" index_context="" index_prior=""
  if [ "$INDEX_READ" = 0 ]; then
    index_state=ignored
    index_seen "$repo_path"
    index_digest="$seen_digest"
    index_prior="$seen_prior"
    if [ -n "$index_digest" ]; then
      log "$name: INDEX_READ=0: the rows of $repo_path:$INDEX_TAG ($index_digest) are not read; this run writes a new index that replaces that one"
    elif [ "$index_prior" = absent ]; then
      log "$name: INDEX_READ=0: there is no $repo_path:$INDEX_TAG yet; this run writes the first one"
    else
      warn "$name: INDEX_READ=0: the manifest of $repo_path:$INDEX_TAG did not read, so the index that this reset replaces is not known, and this run writes no index" \
        "the reset can be run again" \
        "reproduce: curl -s -H 'Authorization: Bearer QQ==' -H 'Accept: application/vnd.oci.image.manifest.v1+json' $REG_URL/v2/$repo_path/manifests/$INDEX_TAG"
    fi
  else
    index_of "$repo_path" "$dir/index" "$dir"/cand/*.db "$dir/promoted.db"
    index_state="$reg_state"
    if [ "$reg_private" -eq 1 ] && [ "$private" -eq 0 ]; then
      private=1
      warn "$name: $repo_path:$INDEX_TAG reads only with the workflow's token; the package is private"
    fi
  fi
  case "$index_state" in
    ok)
      index_digest="sha256:$(sha256sum "$dir/index/manifest.json" | cut -d ' ' -f 1)"
      index_context="$(jq -r '.annotations["dev.pkgforge.mirror.verify-context"] // ""' "$dir/index/manifest.json")"
      awk -F '\t' -v OFS='\t' 'FILENAME == ARGV[1] { r[$1] = $0; next } ($1 in r) { print r[$1], $2, $3, $4 }' \
        "$dir/index/ref.tsv" "$dir/index/index.tsv" > "$dir/indexed.tsv"
      log "$name: $repo_path:$INDEX_TAG ($index_digest) lists $(awk -F '\t' '$9 == "m" { n++ } END { print n + 0 }' "$dir/indexed.tsv") file(s) on the registry, $(awk -F '\t' '$9 == "m" && $10 == "1" { n++ } END { print n + 0 }' "$dir/indexed.tsv") of them verified, and $(awk -F '\t' '$9 == "a" { n++ } END { print n + 0 }' "$dir/indexed.tsv") absent upstream"
      ;;
    invalid)
      index_digest="sha256:$(sha256sum "$dir/index/manifest.json" | cut -d ' ' -f 1)"
      warn "$name: $repo_path:$INDEX_TAG ($index_digest) is not a valid index; it is not used, and this run writes a new one"
      ;;
    absent) log "$name: no index yet at $repo_path:$INDEX_TAG" ;;
    unread)
      warn "$name: $repo_path:$INDEX_TAG did not read; this run plans as with no index, and writes none" \
        "reproduce: curl -s -H 'Authorization: Bearer QQ==' -H 'Accept: application/vnd.oci.image.manifest.v1+json' $REG_URL/v2/$repo_path/manifests/$INDEX_TAG"
      ;;
  esac

  #-------------------------------------------------------------------------#
  # 4. The files promoted or indexed with no signature: does upstream sign
  #    them now? Only a name of a file the plan would skip counts (the same
  #    sha256 as promoted or indexed, no %PGPSIG%); any other is planned
  #    anyway, and mirror-file reads its .sig afresh.
  #-------------------------------------------------------------------------#
  local f src probe_rc answer srcs=()
  mapfile -t srcs < <(target_sources "$conf")
  : > "$dir/listed.txt"
  : > "$dir/recheck.txt"
  if [ -n "$promoted_sha" ] || [ "$index_state" = ok ]; then
    {
      if [ -n "$promoted_sha" ]; then
        jq -r '.annotations["dev.pkgforge.mirror.unsigned"] // empty' "$dir/latest.json" | tr ' ' '\n'
      fi
      awk -F '\t' '
        FILENAME == ARGV[1] { r[$1] = $5 "\t" $8; next }
        $9 == "m" && $11 == "1" && ($1 in r) && r[$1] == $5 "\t" $8 { print $1 }
      ' "$dir/records.tsv" "$dir/indexed.tsv"
    } > "$dir/listed.txt"
    awk -F '\t' '
      FILENAME == ARGV[1] { if ($0 != "") want[$0] = 1; next }
      FILENAME == ARGV[2] { if ($8 == "") p[$1] = $5; next }
      FILENAME == ARGV[3] { if ($9 == "m" && $8 == "") x[$1] = $5; next }
      ($1 in want) && $8 == "" && ((($1 in p) && p[$1] == $5) || (($1 in x) && x[$1] == $5)) { print $1 }
    ' "$dir/listed.txt" "$dir/promoted.tsv" "$dir/indexed.tsv" "$dir/records.tsv" > "$dir/recheck.txt"
    while IFS= read -r f; do
      answer=404
      for src in "${srcs[@]}"; do
        probe_rc=0
        fetch_within "$src/$f.sig" "$dir/recheck.sig" "$SIG_MAX_TIME" 4 "$src/$f.sig" || probe_rc=$?
        case "$probe_rc" in
          0)
            if sig_packet "$dir/recheck.sig"; then
              answer=200
            else
              answer="$src answered 200 with no OpenPGP signature packet"
            fi
            break
            ;;
          4) ;;
          *)
            answer="error from $src (status $probe_rc)"
            break
            ;;
        esac
      done
      rm -f "$dir/recheck.sig"
      case "$answer" in
        200)
          log "$name: $f was promoted or indexed with no signature, and upstream has a .sig for it now; it is planned again"
          printf '%s\n' "$f" >> "$dir/signed-now.txt"
          ;;
        404) printf '%s\n' "$f" >> "$dir/unsigned.txt" ;;
        *)
          log "$name: $f was promoted or indexed with no signature, and its .sig is not known this run: $answer"
          printf '%s\n' "$f" >> "$dir/unsigned.txt"
          ;;
      esac
    done < "$dir/recheck.txt"
  fi

  #-------------------------------------------------------------------------#
  # 4b. Detached signatures that upstream made again. A file the plan would
  #     skip with no %PGPSIG% is read only by its sha256, and an unchanged
  #     database makes the target current: a .sig that upstream replaces is
  #     never seen. So each run compares SIGCHECK_SAMPLE of these files: the
  #     .sig upstream serves with the signature layer of the file's tag. The
  #     sample starts at another file on each 3-hour run. A file whose .sig
  #     differs is planned again, and mirror-file pushes it again with the
  #     same package blob. More than SIGCHECK_ESCALATE of one sample that
  #     differ is a new signing key: every such file is planned this run.
  #     These reads count in the target's share, and stop when half of what
  #     was left at the start of this step is used. The files are those
  #     promoted or indexed, and not listed by step 4.
  #-------------------------------------------------------------------------#
  local signed_late sig_all=0 sig_sampled=0 sig_changed=0 sig_unread=0 sig_offset sig_floor tag_rc lay got m_tag bad_srcs=" "
  signed_late="$(awk 'END { print NR + 0 }' "$dir/signed-now.txt")"
  : > "$dir/sigcheck-changed.txt"
  if [ -n "$promoted_sha" ] || [ "$index_state" = ok ]; then
    awk -F '\t' '
      FILENAME == ARGV[1] { if ($0 != "") listed[$0] = 1; next }
      FILENAME == ARGV[2] { if ($8 == "") p[$1] = $5; next }
      FILENAME == ARGV[3] { if ($9 == "m" && $8 == "") x[$1] = $5; next }
      !($1 in listed) && $8 == "" && ((($1 in p) && p[$1] == $5) || (($1 in x) && x[$1] == $5)) { print $1 }
    ' "$dir/listed.txt" "$dir/promoted.tsv" "$dir/indexed.tsv" "$dir/records.tsv" | LC_ALL=C sort > "$dir/sigcheck-all.txt"
    sig_all="$(awk 'END { print NR + 0 }' "$dir/sigcheck-all.txt")"
  fi
  if [ "$sig_all" -gt 0 ]; then
    # The run's 3-hour window, then that many samples on from the first file.
    sig_offset=$(($(now_epoch) / 10800))
    sig_offset=$(((sig_offset * SIGCHECK_SAMPLE) % sig_all))
    awk -v o="$sig_offset" -v k="$SIGCHECK_SAMPLE" '
      { a[NR - 1] = $0 }
      END { m = (k < NR) ? k : NR; for (i = 0; i < m; i++) print a[(o + i) % NR] }
    ' "$dir/sigcheck-all.txt" | "$WRAPPER" --tags > "$dir/sigcheck-sample.tsv"
    sig_floor=$(((share_deadline + SECONDS) / 2))
    while IFS=$'\t' read -r f m_tag; do
      if [ "$SECONDS" -ge "$sig_floor" ]; then
        log "$name: the detached signature check stops at half of what was left of the target's share; the rest of the sample waits for a later run"
        break
      fi
      tag_rc=0
      if [ "$private" -eq 1 ]; then
        registry_manifest "$repo_path" "$m_tag" "$dir/sigcheck.json" || tag_rc=$?
      else
        REGISTRY_TOKEN='' registry_manifest "$repo_path" "$m_tag" "$dir/sigcheck.json" || tag_rc=$?
      fi
      case "$tag_rc" in
        "$REG_STATUS_OK") read -r lay _ _ <<< "$(manifest_layer "$dir/sigcheck.json" "$f.sig")" ;;
        "$REG_STATUS_ABSENT") lay="" ;;
        *)
          log "$name: $repo_path:$m_tag did not read; the .sig of $f is compared on a later run"
          sig_unread=$((sig_unread + 1))
          continue
          ;;
      esac
      # The first server in the target's order that answers with a signature
      # packet gives the .sig, as mirror-file reads it. A server that fails is
      # not asked again in this sample.
      got=""
      for src in "${srcs[@]}"; do
        case "$bad_srcs" in
          *" $src "*) continue ;;
        esac
        probe_rc=0
        fetch_within "$src/$f.sig" "$dir/sigcheck.sig" "$SIG_MAX_TIME" 4 "$src/$f.sig" || probe_rc=$?
        case "$probe_rc" in
          0)
            if sig_packet "$dir/sigcheck.sig"; then
              got="$(sha256sum "$dir/sigcheck.sig" | cut -d ' ' -f 1)"
              break
            fi
            log "$name: $src/$f.sig answered 200 with no OpenPGP signature packet"
            ;;
          4) ;;
          *)
            log "$name: $src/$f.sig did not answer within ${fetch_max}s (status $probe_rc); no other .sig of this sample is asked of it"
            bad_srcs="$bad_srcs$src "
            ;;
        esac
      done
      rm -f "$dir/sigcheck.sig"
      if [ -z "$got" ]; then
        sig_unread=$((sig_unread + 1))
        continue
      fi
      sig_sampled=$((sig_sampled + 1))
      if [ "$lay" != "sha256:$got" ]; then
        sig_changed=$((sig_changed + 1))
        log "$name: upstream's $f.sig is sha256:$got, and $repo_path:$m_tag holds ${lay:-no signature layer}; it is planned again"
        printf '%s\n' "$f" >> "$dir/sigcheck-changed.txt"
      fi
    done < "$dir/sigcheck-sample.tsv"
    log "$name: $sig_sampled of $sig_all file(s) with a detached signature only compared with their tags, $sig_changed changed upstream, $sig_unread not read this run"
    if [ "$sig_changed" -gt "$SIGCHECK_ESCALATE" ]; then
      warn "$name: upstream signed $sig_changed of $sig_sampled sampled files again; every detached signature is checked this run" \
        "SIGCHECK_ESCALATE=$SIGCHECK_ESCALATE; $sig_all file(s) are planned, and mirror-file pushes again each one whose .sig differs"
      cat "$dir/sigcheck-all.txt" >> "$dir/signed-now.txt"
    else
      cat "$dir/sigcheck-changed.txt" >> "$dir/signed-now.txt"
    fi
  fi

  #-------------------------------------------------------------------------#
  # 5. Current?
  #-------------------------------------------------------------------------#
  local packages bytes newest signed_now
  packages="$(awk 'END { print NR + 0 }' "$dir/records.tsv")"
  bytes="$(awk -F '\t' '{ s += $6 } END { printf "%.0f\n", s }' "$dir/records.tsv")"
  newest="$(awk -F '\t' '$7 + 0 > m { m = $7 + 0 } END { print m + 0 }' "$dir/records.tsv")"
  {
    printf 'TARGET=%s\nARCH=%s\nREPO=%s\nREPOSITORY=%s\n' "$name" "$arch" "$repo" "$repo_path"
    printf 'UPSTREAM=%s\nDB_SHA256=%s\nPROMOTED_DB_SHA256=%s\n' "$chosen_server" "$chosen_sha" "$promoted_sha"
    printf 'PACKAGES=%s\nBYTES=%s\nNEWEST_BUILDDATE=%s\nFETCHED=%s\nPRIVATE=%s\n' "$packages" "$bytes" "$newest" "$fetched" "$private"
    printf 'NUL_MEMBERS=%s\n' "$(awk 'END { print NR + 0 }' "$dir/nul.txt")"
  } > "$dir/meta.env"

  signed_now="$(awk 'END { print NR + 0 }' "$dir/signed-now.txt")"
  if [ "$chosen_sha" = "$promoted_sha" ] && [ "$signed_now" -eq 0 ]; then
    set_state "$dir" current "the promoted $repo.db is upstream's ($chosen_sha)$(nul_note "$dir")"
    return 0
  fi

  #-------------------------------------------------------------------------#
  # The files database and any signatures, from a db_server that served these
  # very database bytes. The files database must name the same packages with
  # the same sha256, or pacman -F would describe other packages. A server that
  # fails gives way to the next one with the same bytes.
  #-------------------------------------------------------------------------#
  local files_ok=0 s sig_rc sig_done cands tried=0 drift db_n left_out signed=no verified
  cands="$(awk -F '\t' -v c="$chosen_sha" '$3 == c { n++ } END { print n + 0 }' "$dir/cand/list.tsv")"
  # When the database is signed, prepare the trust root once: the keyring files
  # of keyring_image, under $dir/keyrings. A signature that does not verify
  # against them is refused like a malformed database, and the next db_server
  # is tried. PLAN_KEYRING_DIR gives these files directly, so a test checks the
  # gpgv path with no container pull.
  if [ "$(target_get "$conf" db_signed)" = yes ]; then
    signed=yes
    if [ -n "${PLAN_KEYRING_DIR:-}" ]; then
      mkdir -p "$dir/keyrings"
      rc=0
      cp -r "$PLAN_KEYRING_DIR"/. "$dir/keyrings/" || rc=$?
      if [ "$rc" -ne 0 ]; then
        set_state "$dir" error "PLAN_KEYRING_DIR=$PLAN_KEYRING_DIR could not be read, so the signatures of $repo cannot be checked"
        return 0
      fi
    elif ! keyring_copy "$dir/keyrings" "$conf"; then
      set_state "$dir" error "db_signed = yes and the keyring files of keyring_image could not be read, so the signatures of $repo cannot be checked"
      return 0
    fi
  fi
  while IFS=$'\t' read -r idx srv sha; do
    [ "$sha" = "$chosen_sha" ] || continue
    tried=$((tried + 1))
    rc=0
    fetch_within "$srv/$repo.files" "$dir/upstream.files" "$FILES_MAX_TIME" "$((cands - tried + 2))" "$srv/$repo.files $chosen_sha" || rc=$?
    if [ "$rc" -ne 0 ]; then
      log "$name: $srv/$repo.files did not answer within ${fetch_max}s (status $rc)"
      continue
    fi
    if ! db_records "$dir/upstream.files" "$dir/files.tsv"; then
      warn "$name: $srv/$repo.files does not read as a tar archive"
      continue
    fi
    # The database decides which packages exist; the files database only
    # describes them for pacman -F. A file name both name with other sha256
    # values means the two are of different snapshots: refused. Drift is
    # accepted and named: packages the files database leaves out (Arch Linux
    # ARM aarch64 aur.files left out localepurge, 2026-10-14), packages only
    # the files database names (aarch64 extra.files still names
    # qemu-system-cris 9.1.2-1 that extra.db dropped, and findnewest, whose
    # extra.db desc is NUL bytes, 2026-10-15; Arch Linux RISC-V extra.files
    # left out 934 of 14716, 2026-10-15), and packages both name at other
    # file names: the files database lags, as during a mass rebuild. Upstream
    # serves all of these so to its own users, and a lagging files database
    # must never hold package updates. So drift is counted by package name:
    # the files database is of another repository only when it names fewer
    # than half of the packages of the database, and leaves out 16 or more.
    # FILES_DRIFT_MAX, when set, is a bound on the file names that only one
    # of the two databases names, and replaces that rule.
    cut -f 1,5 "$dir/files.tsv" | sort -u > "$dir/files-pairs.txt"
    cut -f 1,5 "$dir/records.tsv" | sort -u > "$dir/db-pairs.txt"
    awk -F '\t' 'FILENAME == ARGV[1] { sha[$1] = $2; next } ($1 in sha) && sha[$1] != $2' \
      "$dir/db-pairs.txt" "$dir/files-pairs.txt" > "$dir/files-conflict.txt"
    if [ -s "$dir/files-conflict.txt" ]; then
      warn "$name: $srv/$repo.files and $repo.db name $(awk 'END { print NR + 0 }' "$dir/files-conflict.txt") file(s) with other sha256 values, e.g. $(awk -F '\t' 'NR == 1 { print $1 " sha256 " $2 }' "$dir/files-conflict.txt")"
      continue
    fi
    # By package name: the files of packages only the files database names,
    # the files of packages it leaves out, and the packages both name at
    # other file names.
    awk -F '\t' 'FILENAME == ARGV[1] { n[$2] = 1; next } !($2 in n) { print $1 }' \
      "$dir/records.tsv" "$dir/files.tsv" > "$dir/files-extra.txt"
    awk -F '\t' 'FILENAME == ARGV[1] { n[$2] = 1; next } !($2 in n) { print $1 }' \
      "$dir/files.tsv" "$dir/records.tsv" > "$dir/files-missing.txt"
    awk -F '\t' 'FILENAME == ARGV[1] { f[$2] = $1; next } ($2 in f) && f[$2] != $1 { print $2 }' \
      "$dir/files.tsv" "$dir/records.tsv" | LC_ALL=C sort > "$dir/files-lagging.txt"
    if [ -n "${FILES_DRIFT_MAX:-}" ]; then
      drift="$(
        {
          awk -F '\t' 'FILENAME == ARGV[1] { d[$1] = 1; next } !($1 in d) { print $1 }' "$dir/db-pairs.txt" "$dir/files-pairs.txt"
          comm -13 "$dir/files-pairs.txt" "$dir/db-pairs.txt"
        } | awk 'END { print NR + 0 }'
      )"
      if [ "$drift" -gt "$FILES_DRIFT_MAX" ]; then
        warn "$name: $srv/$repo.files differs from $repo.db by $drift package file(s), over FILES_DRIFT_MAX=$FILES_DRIFT_MAX"
        continue
      fi
    else
      db_n="$(awk 'END { print NR + 0 }' "$dir/records.tsv")"
      left_out="$(awk 'END { print NR + 0 }' "$dir/files-missing.txt")"
      if [ "$((2 * (db_n - left_out)))" -lt "$db_n" ] && [ "$left_out" -ge 16 ]; then
        warn "$name: $srv/$repo.files names $((db_n - left_out)) of the $db_n packages of $repo.db: it is the files database of another repository" \
          "a files database is refused when it names fewer than half of the packages, and leaves out 16 or more"
        continue
      fi
    fi
    # first20 FILE: the count, and at most 20 of the names
    first20() {
      awk '{ n++; if (n <= 20) s = s " " $0 } END { printf "%d:%s%s", n, s, (n > 20) ? " ..." : "" }' "$1"
    }
    if [ -s "$dir/files-extra.txt" ]; then
      warn "$name: $srv/$repo.files names package file(s) that $repo.db does not, as upstream serves it: $(first20 "$dir/files-extra.txt")"
    fi
    if [ -s "$dir/files-missing.txt" ]; then
      warn "$name: $srv/$repo.files leaves out package(s) of $repo.db, as upstream serves it: $(first20 "$dir/files-missing.txt")"
    fi
    if [ -s "$dir/files-lagging.txt" ]; then
      warn "$name: $srv/$repo.files names package(s) of $repo.db at another file name, as upstream serves it (the files database lags): $(first20 "$dir/files-lagging.txt")"
    fi
    # A signature is absent only when the server says so with a 404; any other
    # failure would otherwise turn a signed database into an unsigned one.
    sig_done=1
    for s in db files; do
      rm -f "$dir/upstream.$s.sig"
      sig_rc=0
      fetch_within "$srv/$repo.$s.sig" "$dir/upstream.$s.sig" "$SIG_MAX_TIME" "$((cands - tried + 1))" "$srv/$repo.$s.sig $chosen_sha" || sig_rc=$?
      case "$sig_rc" in
        0) log "$name: upstream signs $repo.$s" ;;
        4) ;;
        *)
          log "$name: $srv/$repo.$s.sig did not answer (status $sig_rc)"
          sig_done=0
          ;;
      esac
    done
    [ "$sig_done" -eq 1 ] || continue
    # Check the signatures against the trust root before this server is taken.
    # A .sig that does not verify is worse than none: a consumer with
    # DatabaseRequired refuses the database, and the mirror would serve bytes it
    # cannot vouch for. A server whose .sig does not verify gives way to the
    # next, as a malformed database does.
    if [ "$signed" = yes ]; then
      verified=1
      for s in db files; do
        if ! db_sig_ok "$dir" "$repo" "$s"; then
          warn "$name: $srv/$repo.$s.sig does not verify against the keyring files of keyring_image; the next db_server is tried"
          verified=0
          break
        fi
      done
      [ "$verified" -eq 1 ] || continue
      log "$name: $srv/$repo.db.sig and $srv/$repo.files.sig verify against the keyring files"
    fi
    files_ok=1
    break
  done < "$dir/cand/list.tsv"
  if [ "$files_ok" -ne 1 ]; then
    if [ "$signed" = yes ]; then
      set_state "$dir" error "no db_server served $repo.db $chosen_sha with a matching $repo.files and signatures that verify against the keyring files of keyring_image$(budget_note)"
    else
      set_state "$dir" error "no db_server that served $repo.db $chosen_sha also served a $repo.files that matches it, and an answer for its signatures$(budget_note)"
    fi
    return 0
  fi

  #-------------------------------------------------------------------------#
  # The verify context of this run (lib.sh verify_context). Not known when
  # the latest database of keyring_from did not read: then no indexed file
  # counts as verified, and the verified flags of the index carry over.
  #-------------------------------------------------------------------------#
  local verify_ctx="" ctx_rc=0
  keyring_records "$conf" "$dir" "$dir/index/keyrings.tsv" || ctx_rc=$?
  if [ "$ctx_rc" -eq 0 ]; then
    verify_ctx="$(verify_context "$conf" "$dir/index/keyrings.tsv")" || ctx_rc=$?
  fi
  if [ "$ctx_rc" -ne 0 ]; then
    verify_ctx=""
    log "$name: the verify context is not known this run: no indexed file counts as verified, and the verified flags of the index carry over"
  fi

  #-------------------------------------------------------------------------#
  # 6. Skip, todo or verify. With P promoted (the same sha256 and %PGPSIG%),
  #    I indexed (state m, the same record), A indexed as absent upstream
  #    (state a, the same record), V indexed and verified under this verify
  #    context, and again a file of signed-now.txt (step 4 or 4b):
  #      todo     !(P or I) or again or (A and !P)
  #      new      (!P and !V) or again or (A and !P), so todo is a part of new
  #      vouched  I and not again
  #    A file absent upstream is tried again on each run until a promoted
  #    database names it. After that it is skipped, as a promoted file is.
  #-------------------------------------------------------------------------#
  cut -f 1 "$dir/records.tsv" | "$WRAPPER" --tags > "$dir/pairs.tsv"
  : > "$dir/todo.tsv"
  : > "$dir/new.tsv"
  : > "$dir/vouched.tsv"
  awk -F '\t' -v OFS='\t' -v target="$name" -v vc="$verify_ctx" -v ic="$index_context" \
    -v todo="$dir/todo.tsv" -v new="$dir/new.tsv" -v vouched="$dir/vouched.tsv" '
    BEGIN { vc = vc ""; ic = ic "" }
    FILENAME == ARGV[1] { again[$1] = 1; next }
    FILENAME == ARGV[2] { p[$1] = $5 "\t" $8; next }
    FILENAME == ARGV[3] { x[$1] = $5 "\t" $8; xs[$1] = $9; xv[$1] = $10; xu[$1] = $11; next }
    FILENAME == ARGV[4] { uns[$1] = 1; next }
    FILENAME == ARGV[5] { tag[$1] = $2; next }
    {
      f = $1
      rec = $5 "\t" $8
      P = (f in p) && p[f] == rec
      I = (f in x) && x[f] == rec && xs[f] == "m"
      A = (f in x) && x[f] == rec && xs[f] == "a"
      V = I && xv[f] == "1" && vc != "" && vc == ic
      ag = (f in again)
      if (!(P || I) || ag || (A && !P)) {
        print target, f, tag[f], $5, $6, $2, "todo", $7, $8 > todo
        print target, f, tag[f], $5, $6, $2, "todo", $7, $8 > new
      } else if (!P && !V) {
        print target, f, tag[f], $5, $6, $2, "verify", $7, $8 > new
      }
      if (I && !ag) {
        v = (vc == "" || vc == ic) ? xv[f] : 0
        u = (f in uns) ? 1 : xu[f]
        print f, v, u > vouched
      }
    }
  ' "$dir/signed-now.txt" "$dir/promoted.tsv" "$dir/indexed.tsv" "$dir/unsigned.txt" "$dir/pairs.tsv" "$dir/records.tsv"
  local not_new
  not_new="$(awk -F '\t' 'FILENAME == ARGV[1] { n[$2] = 1; next } !($2 in n) { c++ } END { print c + 0 }' "$dir/new.tsv" "$dir/todo.tsv")"
  if [ "$not_new" -ne 0 ]; then
    set_state "$dir" error "plan's own check failed: $not_new todo file(s) are not in new.tsv, and every todo file must be verified"
    return 0
  fi
  if [ "$index_state" = ok ]; then
    log "$name: the index spares $(awk 'END { print NR + 0 }' "$dir/vouched.tsv") file(s) a mirror, and $(awk -F '\t' 'FILENAME == ARGV[1] { n[$2] = 1; next } !($1 in n) && $2 == "1" { c++ } END { print c + 0 }' "$dir/new.tsv" "$dir/vouched.tsv") a verify; this run mirrors $(awk 'END { print NR + 0 }' "$dir/todo.tsv") and verifies $(awk 'END { print NR + 0 }' "$dir/new.tsv")"
  fi
  local resigned
  resigned="$(awk -F '\t' 'FILENAME == ARGV[1] { p[$1] = $5; s[$1] = $8; next } ($2 in p) && p[$2] == $4 && s[$2] != $9 { n++ } END { print n + 0 }' \
    "$dir/promoted.tsv" "$dir/todo.tsv")"
  if [ "$resigned" -gt 0 ]; then
    log "$name: $resigned file(s) keep their bytes and carry a new %PGPSIG%; mirror-file repairs their signature layers"
  fi
  if [ "$signed_late" -gt 0 ]; then
    log "$name: $signed_late file(s) promoted or indexed with no signature have a .sig upstream now; mirror-file adds their signature layers"
  fi
  if [ "$((signed_now - signed_late))" -gt 0 ]; then
    log "$name: $((signed_now - signed_late)) file(s) with a detached signature only are planned again; mirror-file pushes again each one whose .sig differs"
  fi

  #-------------------------------------------------------------------------#
  # 6b. ⛔ A tag that a row of the index vouches for is not written until
  #     the row is withdrawn: an index row of a todo file (state m) goes
  #     before any shard starts. The same ref.db and the same annotations
  #     stay, so oras uploads only the new index.tsv.
  #-------------------------------------------------------------------------#
  local withdraw=0
  if [ "$index_state" = ok ]; then
    awk -F '\t' 'FILENAME == ARGV[1] { if ($2 == "m") m[$1] = 1; next } ($2 in m) { print $2 }' \
      "$dir/index/index.tsv" "$dir/todo.tsv" > "$dir/index/withdraw.txt"
    withdraw="$(awk 'END { print NR + 0 }' "$dir/index/withdraw.txt")"
  fi
  if [ "$withdraw" -gt 0 ]; then
    if ! index_withdraw "$repo_path" "$dir/index"; then
      set_state "$dir" error "could not withdraw $withdraw index row(s) before their tags are written ($repo_path:$INDEX_TAG)"
      return 0
    fi
    log "$name: $withdraw row(s) withdrawn from $repo_path:$INDEX_TAG, now $reg_digest; mirror-file may write their tags"
    index_digest="$reg_digest"
  fi

  #-------------------------------------------------------------------------#
  # 6c. Registry sources: the siblings that hold a todo file's bytes
  #-------------------------------------------------------------------------#
  : > "$dir/sources.tsv"
  if [ -s "$dir/todo.tsv" ]; then
    sibling_hints "$conf" "$dir"
    if [ -s "$dir/sources.tsv" ]; then
      log "$name: $(cut -f 1 "$dir/sources.tsv" | sort -u | awk 'END { print NR + 0 }') todo file(s) are on a sibling repository: $(cut -f 2 "$dir/sources.tsv" | sort -u | tr '\n' ' ' | sed 's/ $//')"
    fi
  fi

  local ctx_out="$verify_ctx"
  if [ -z "$ctx_out" ]; then
    ctx_out="$index_context"
  fi
  {
    printf 'INDEX_TAG=%s\nINDEX_STATE=%s\nINDEX_DIGEST=%s\nINDEX_PRIOR=%s\n' "$INDEX_TAG" "$index_state" "$index_digest" "$index_prior"
    printf 'INDEX_CONTEXT=%s\nVERIFY_CONTEXT=%s\nINDEX_CONTEXT_OUT=%s\n' "$index_context" "$verify_ctx" "$ctx_out"
  } >> "$dir/meta.env"

  #-------------------------------------------------------------------------#
  # 7. This target's shards
  #-------------------------------------------------------------------------#
  shard_target "$dir" "$name"

  local sig_note=""
  if [ "$sig_changed" -gt 0 ]; then
    sig_note="; $sig_changed detached signature(s) changed upstream"
  fi
  set_state "$dir" pending "$(awk 'END { print NR + 0 }' "$dir/todo.tsv") file(s) to mirror, $(awk 'END { print NR + 0 }' "$dir/new.tsv") to verify, $(awk -F '\t' '{ s += $5 } END { printf "%.0f", s / 1048576 }' "$dir/todo.tsv") MiB, in $(find "$dir/shards" -name '*.tsv' | awk 'END { print NR + 0 }') shard(s), database from $chosen_server$sig_note$(nul_note "$dir")"
}

left="$#"
for conf in "$@"; do
  share_start "$left"
  plan_target "$conf"
  prune "$out/$(target_get "$conf" arch)-$(target_get "$conf" repo)"
  left=$((left - 1))
done
rm -rf "$out/.fetch-cache"
log "the upstream reads took $((SECONDS + PLAN_BUDGET - run_deadline))s of PLAN_BUDGET=${PLAN_BUDGET}s"
log "the registry reads of the index, the keyring records and the siblings took ${reg_spent}s of REGISTRY_READ_BUDGET=${REGISTRY_READ_BUDGET}s"

#---------------------------------------------------------------------------#
# The matrices: one entry per pending target, with its shards
#---------------------------------------------------------------------------#
: > "$out/with-files.jsonl"
: > "$out/no-files.jsonl"
for d in "$out"/*/; do
  d="${d%/}"
  [ -f "$d/state" ] || continue
  [ "$(cat "$d/state")" = pending ] || continue
  t="$(basename "$d")"
  shards="$(find "$d/shards" -name '*.tsv' -type f | sed 's|.*/||; s|\.tsv$||' | sort -n | jq -R 'tonumber' | jq -cs .)"
  if [ "$shards" = '[]' ]; then
    jq -cn --arg t "$t" '{target: $t, shards: []}' >> "$out/no-files.jsonl"
  else
    jq -cn --arg t "$t" --argjson s "$shards" '{target: $t, shards: $s}' >> "$out/with-files.jsonl"
  fi
done
jq -cs '{include: .}' "$out/with-files.jsonl" > "$out/targets.json"
jq -cs '{include: .}' "$out/no-files.jsonl" > "$out/pending.json"
rm -f "$out/with-files.jsonl" "$out/no-files.jsonl"

{
  printf 'target\tstate\tfiles\tMiB\twhy\n'
  for d in "$out"/*/; do
    d="${d%/}"
    [ -f "$d/state" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$(basename "$d")" "$(cat "$d/state")" \
      "$(awk 'END { print NR + 0 }' "$d/todo.tsv")" \
      "$(awk -F '\t' '{ s += $5 } END { printf "%.0f", s / 1048576 }' "$d/todo.tsv")" \
      "$(cat "$d/why")"
  done
} > "$out/summary.tsv"

pending="$(jq -s '[.[].include[]] | length' "$out/targets.json" "$out/pending.json")"
log "$pending target(s) pending: $(jq -r '[.include[] | "\(.target) (\(.shards | length) shard(s))"] | join(", ")' "$out/targets.json")$(jq -r '[.include[].target] | if length > 0 then "; with no file to mirror: " + join(", ") else "" end' "$out/pending.json")"
if [ -n "${GITHUB_OUTPUT:-}" ]; then
  {
    printf 'targets=%s\n' "$(jq -cs '{include: [.[].include[]]}' "$out/targets.json" "$out/pending.json")"
    if [ "$pending" -gt 0 ]; then echo "has_targets=true"; else echo "has_targets=false"; fi
    jq -r -s '[.[].include[].target] | to_entries[] | "slot\(.key)=\(.value)"' "$out/targets.json" "$out/pending.json"
  } >> "$GITHUB_OUTPUT"
fi
