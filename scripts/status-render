#!/usr/bin/env python3
#
# Render the status site from what scripts/status-collect measured.
#
#   python3 -I scripts/status-render IN OUT_SITE
#
# IN holds status.json (required), history.jsonl and bench.json (optional).
# OUT_SITE gets:
#   index.html                   one static page: inline CSS, light and dark,
#                                no JavaScript
#   badges/<target>.svg          coverage and snapshot age of one target
#   badges/<arch>.svg            the same over the targets of one architecture
#   badges/all.svg               the same over every target
#   badges/speed.svg             pacman's time through the oci wrapper and
#                                through the official mirror, from bench.json
#   charts/coverage.svg          share of upstream files in the mirror, per
#                                target, grouped by architecture
#   charts/freshness.svg         snapshot age per target, against the sync
#                                interval
#   charts/size.svg              GiB per target, in the mirror and upstream only
#   charts/history-coverage.svg  coverage per architecture, last 30 days
#   charts/history-age.svg       oldest snapshot age per architecture, last 30
#                                days
#   charts/speed.svg             bench.json: seconds per path and operation
#   charts/narrow/<chart>.svg    the same charts laid out 420 px wide, for a
#                                phone
#   status.json, history.json, bench.json  the data behind the page
#
# A figure over part of the targets says which part. A target that a run
# could not read on both sides has no coverage: the sums, the group badges
# and the page then name how many targets they count ("77.7% · 3.0 h · 2 of
# 3 measured"). A group whose registry did not answer is "unknown", never
# "not mirrored". A bench older than 2 days shows its age in the warning
# colour.
#
# Every SVG has a title, axis labels, a legend and its own style with a dark
# variant. Colours are the validated colour-blind safe categorical slots, and
# an architecture keeps its colour in every chart. A state colour always comes
# with a shape and a word.
#
# Standard library only. Run it with python3 -I, so the script directory and
# the environment cannot change what is imported. Run without -I, the script
# starts itself again with it.
#
# Exit status: 0 rendered, 1 the input could not be read, 2 usage.

import sys
import os

if not sys.flags.isolated:
    os.execv(sys.executable, [sys.executable, "-I"] + sys.argv)

import datetime
import html
import json
import math

PROG = "status-render"

FONT = ('system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", '
        'Arial, "Noto Sans", "Liberation Sans", sans-serif')
MONO = 'ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace'

# The reference categorical slots, light and dark, in their validated order.
SLOTS_LIGHT = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100",
               "#e87ba4", "#008300", "#4a3aa7", "#e34948"]
SLOTS_DARK = ["#3987e5", "#d95926", "#199e70", "#c98500",
              "#d55181", "#008300", "#9085e9", "#e66767"]
# Slot 0 is the de-emphasis grey.
OTHER_LIGHT = "#a3a29c"
OTHER_DARK = "#6b6a65"
# State colours, never used for a series. Each comes with a shape and a word.
STATE = {"good": "#0ca30c", "warning": "#fab219",
         "critical": "#d03b3b", "none": "#898781", "unknown": "#898781"}

ARCH_ORDER = ["x86_64", "aarch64", "armv7h", "loong64", "riscv64"]
REPO_ORDER = ["core", "extra", "multilib", "alarm", "aur"]
PATH_ORDER = ["official", "worker", "oci", "oci-serial"]
PATH_LABEL = {"official": "official mirror", "worker": "Worker, native",
              "oci": "oci wrapper", "oci-serial": "oci wrapper, serial"}
OP_ORDER = ["sy", "sw-small", "sw-large"]

WIDE = 760
NARROW = 420
PAD = 24


def warn(msg):
    sys.stderr.write("%s: warning: %s\n" % (PROG, msg))


def die(msg, *more):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    for m in more:
        sys.stderr.write("  %s\n" % m)
    sys.exit(1)


#---------------------------------------------------------------------------#
# Formatting
#---------------------------------------------------------------------------#
def esc(s):
    return html.escape("" if s is None else str(s), quote=True)


def fmt_int(n):
    return "-" if n is None else "{:,}".format(int(n))


def fmt_pct(r):
    if r is None:
        return "-"
    if r >= 1:
        return "100%"
    if r <= 0:
        return "0%"
    if r < 0.001:
        return "<0.1%"
    v = math.floor(r * 1000) / 10
    return ("%.1f" % v).rstrip("0").rstrip(".") + "%"


def fmt_age(s):
    if s is None:
        return "-"
    if s < 0:
        s = 0
    if s < 3600:
        return "%d min" % round(s / 60)
    if s < 48 * 3600:
        return "%.1f h" % (s / 3600)
    return "%.1f d" % (s / 86400)


def fmt_interval(s):
    return fmt_age(s).replace(".0 h", " h").replace(".0 d", " d")


def fmt_gib(b):
    if b is None:
        return "-"
    g = b / 1073741824
    if g == 0:
        return "0"
    if g < 10:
        return "%.2f" % g
    if g < 100:
        return "%.1f" % g
    return "%.0f" % g


def fmt_secs(s):
    if s is None:
        return "-"
    if s < 1:
        return "%d ms" % round(s * 1000)
    if s < 10:
        return "%.2f s" % s
    return "%.1f s" % s


def fmt_hours(h):
    """An axis tick in hours: 0, 15 min, 1 h, 1 d, 7 d."""
    if h == 0:
        return "0"
    if h < 1:
        return "%d min" % round(h * 60)
    if h < 24 or h % 24:
        return ("%.1f" % h).rstrip("0").rstrip(".") + " h"
    return "%d d" % (h // 24)


def fmt_time(iso):
    if not iso:
        return "-"
    return str(iso).replace("T", " ")[:16]


def utc(epoch):
    return datetime.datetime.fromtimestamp(epoch, tz=datetime.timezone.utc)


def parse_time(s):
    if not isinstance(s, str):
        return None
    try:
        d = datetime.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ")
    except ValueError:
        return None
    return d.replace(tzinfo=datetime.timezone.utc).timestamp()


def median(values):
    v = sorted(x for x in values if x is not None)
    if not v:
        return None
    n = len(v)
    if n % 2:
        return v[n // 2]
    return (v[n // 2 - 1] + v[n // 2]) / 2


def num(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool)


# Text width, estimated from the proportions of a UI sans. Layout leaves
# room, so an estimate a little wide is safe and one too narrow is not.
NARROW_CHARS = set("il.,:;'|!()[]{}1 ")
WIDE_CHARS = set("mwMW@%")


def text_w(s, size, bold=False):
    w = 0.0
    for c in str(s):
        if c in NARROW_CHARS:
            w += 0.30
        elif c in WIDE_CHARS:
            w += 0.86
        elif c.isupper():
            w += 0.66
        elif c.isdigit():
            w += 0.58
        else:
            w += 0.54
    return w * size * (1.07 if bold else 1.0)


# Verdana at 11 px, the width a badge is laid out for. Verdana is wide, so a
# system font fits in the same box.
VERDANA = {" ": 3.9, "%": 12.3, ".": 4.0, ",": 4.0, ":": 4.7, "-": 5.0,
           "_": 7.0, "/": 4.9, "·": 4.0, "(": 4.6, ")": 4.6, "<": 9.2,
           "a": 6.7, "b": 6.8, "c": 5.8, "d": 6.8, "e": 6.6, "f": 3.9,
           "g": 6.8, "h": 7.0, "i": 3.0, "j": 3.8, "k": 6.5, "l": 3.0,
           "m": 10.7, "n": 7.0, "o": 6.7, "p": 6.8, "q": 6.8, "r": 4.7,
           "s": 5.8, "t": 4.3, "u": 7.0, "v": 6.5, "w": 9.0, "x": 6.5,
           "y": 6.5, "z": 5.8}


def badge_w(s):
    w = 0.0
    for c in s:
        if c in VERDANA:
            w += VERDANA[c]
        elif c.isdigit():
            w += 7.0
        elif c.isupper():
            w += 7.6
        else:
            w += 7.0
    return w


def nice_step(raw):
    if raw <= 0:
        return 1
    e = math.floor(math.log10(raw))
    f = raw / 10 ** e
    for n in (1, 2, 2.5, 5, 10):
        if f <= n + 1e-9:
            return n * 10 ** e
    return 10 ** (e + 1)


def nice_ticks(vmax, n=5):
    if vmax <= 0:
        vmax = 1
    step = nice_step(vmax / n)
    top = math.ceil(vmax / step - 1e-9) * step
    ticks = []
    i = 0
    while i * step <= top + step / 1000:
        ticks.append(round(i * step, 10))
        i += 1
    return ticks, top


def hour_ticks(vmax, n=5):
    """Ticks in hours on steps a reader counts in: 1, 2, 3, 6, 12 h, days."""
    steps = [0.25, 0.5, 1, 2, 3, 6, 12, 24, 48, 72, 168, 336, 720]
    step = next((s for s in steps if vmax / s <= n), steps[-1])
    top = math.ceil(vmax / step - 1e-9) * step
    return [i * step for i in range(int(round(top / step)) + 1)], top


#---------------------------------------------------------------------------#
# Identity: an architecture keeps its slot, whatever else is on the page
#---------------------------------------------------------------------------#
def arch_slots(arches):
    known = [a for a in ARCH_ORDER if a in arches]
    extra = sorted(a for a in arches if a not in ARCH_ORDER)
    slots = {}
    for i, a in enumerate(ARCH_ORDER):
        slots[a] = i + 1
    nxt = len(ARCH_ORDER) + 1
    for a in extra:
        slots[a] = nxt if nxt <= len(SLOTS_LIGHT) else 0
        nxt += 1
    return known + extra, slots


def repo_key(repo):
    if repo in REPO_ORDER:
        return (REPO_ORDER.index(repo), repo)
    return (len(REPO_ORDER), repo)


def target_key(t, order):
    arch = t.get("arch", "")
    a = order.index(arch) if arch in order else len(order)
    return (a, repo_key(t.get("repo", "")))


#---------------------------------------------------------------------------#
# States
#---------------------------------------------------------------------------#
def freshness(t, interval, tolerance):
    m = (t.get("mirror") or {}).get("state")
    if m == "absent":
        return "none", "not mirrored yet"
    age = t.get("age_seconds")
    if m != "promoted" or age is None:
        return "unknown", "unknown"
    if t.get("current") is True:
        return "good", "matches upstream"
    if age <= 2 * interval:
        return "good", "within 2 syncs"
    if age <= tolerance:
        return "warning", "late"
    return "critical", "stale"


def cov_ratio(t):
    return (t.get("coverage") or {}).get("ratio_files")


def target_level(t, interval, tolerance):
    f, _ = freshness(t, interval, tolerance)
    if f in ("none", "unknown"):
        return f
    r = cov_ratio(t)
    if f == "good" and (r is None or r < 1):
        return "warning"
    return f


def target_word(t, interval, tolerance):
    lvl = target_level(t, interval, tolerance)
    if lvl == "warning" and freshness(t, interval, tolerance)[0] == "good":
        return lvl, "partial"
    return lvl, {"good": "ok", "warning": "late", "critical": "stale",
                 "none": "not mirrored yet", "unknown": "unknown"}[lvl]


LEVEL_RANK = {"good": 0, "warning": 1, "critical": 2, "unknown": 1, "none": 1}


def not_read(t):
    """Why a target has no coverage: which side could not be read."""
    if not (t.get("upstream") or {}).get("ok"):
        return "upstream not read"
    return "registry not read"


def measured(targets):
    """The targets with a coverage in this run: read on both sides."""
    return [t for t in targets if t.get("coverage")]


def mirror_unread(targets):
    """The targets whose registry did not answer: mirror state error."""
    return [t for t in targets if (t.get("mirror") or {}).get("state") == "error"]


def scope(targets, lead=", in"):
    """Empty when every target was measured, else ', in K of N
    repositories': a sum over part of the targets says so."""
    k, n = len(measured(targets)), len(targets)
    return "" if k == n else "%s %d of %d repositories" % (lead, k, n)


# bench.json comes from a daily run. Older than this, it is shown with its age.
BENCH_MAX_AGE = 2 * 86400


def bench_age(bench, now):
    """Seconds from the bench to this measurement, or None when the bench
    names no date that reads."""
    t = parse_time((bench or {}).get("date"))
    if t is None or not now:
        return None
    return max(now - t, 0)


def bench_old(bench, now):
    """None for a bench of the last BENCH_MAX_AGE, else the words that say
    how old it is."""
    age = bench_age(bench, now)
    if age is None:
        return "date unknown"
    if age <= BENCH_MAX_AGE:
        return None
    return "%d d ago" % (age // 86400)


#---------------------------------------------------------------------------#
# SVG
#---------------------------------------------------------------------------#
def chart_style():
    rules = []
    for i, c in enumerate(SLOTS_LIGHT):
        rules.append(".s%d{fill:%s}.l%d{stroke:%s}" % (i + 1, c, i + 1, c))
    rules.append(".s0{fill:%s}.l0{stroke:%s}" % (OTHER_LIGHT, OTHER_LIGHT))
    for k, c in STATE.items():
        rules.append(".st-%s{fill:%s}" % (k, c))
    dark = []
    for i, c in enumerate(SLOTS_DARK):
        dark.append(".s%d{fill:%s}.l%d{stroke:%s}" % (i + 1, c, i + 1, c))
    dark.append(".s0{fill:%s}.l0{stroke:%s}" % (OTHER_DARK, OTHER_DARK))
    return (
        ".bg{fill:#fcfcfb;stroke:rgba(11,11,11,.10)}"
        "text{font-family:%(f)s}"
        ".tt{font-size:16px;font-weight:600;fill:#0b0b0b}"
        ".hd{font-size:30px;font-weight:600;fill:#0b0b0b}"
        ".sub{font-size:13px;fill:#52514e}"
        ".lb{font-size:12px;fill:#0b0b0b}"
        ".gr{font-size:12px;font-weight:600;fill:#52514e;paint-order:stroke;stroke:#fcfcfb;"
        "stroke-width:5px;stroke-linejoin:round}"
        ".vl{font-size:12px;fill:#0b0b0b;font-variant-numeric:tabular-nums}"
        ".mu{fill:#6f6e69}"
        ".lg{font-size:12px;fill:#52514e}"
        ".tk{font-size:11px;fill:#6f6e69;font-variant-numeric:tabular-nums}"
        ".ax{font-size:12px;fill:#52514e}"
        ".note{font-size:13px;fill:#6f6e69}"
        ".grid{stroke:#e9e8e3;stroke-width:1}"
        ".base{stroke:#c3c2b7;stroke-width:1}"
        ".ref{stroke:#7d7b75;stroke-width:1}"
        ".lead{stroke:#c3c2b7;stroke-width:1;fill:none}"
        ".track{fill:#ebeae5}"
        ".ring{stroke:#fcfcfb;stroke-width:2}"
        ".cut{stroke:#fcfcfb;stroke-width:2}"
        ".line{fill:none;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}"
        ".hollow{fill:none;stroke:#898781;stroke-width:1.5}"
        "%(rules)s"
        "@media (prefers-color-scheme:dark){"
        ".bg{fill:#1a1a19;stroke:rgba(255,255,255,.10)}"
        ".tt,.hd,.lb,.vl{fill:#ffffff}"
        ".sub,.gr,.ax,.lg{fill:#c3c2b7}"
        ".tk,.note,.mu{fill:#9a9890}"
        ".grid{stroke:#2a2a28}"
        ".base,.lead{stroke:#3d3d3a}"
        ".ref{stroke:#9a9890}"
        ".track{fill:#2e2e2c}"
        ".ring,.cut,.gr{stroke:#1a1a19}"
        "%(dark)s}"
    ) % {"f": FONT, "rules": "".join(rules), "dark": "".join(dark)}


class Svg:
    def __init__(self, title, desc, w):
        self.title = title
        self.desc = desc
        self.w = w
        self.parts = []

    def add(self, s):
        self.parts.append(s)

    def text(self, x, y, s, cls, anchor=None):
        a = ' text-anchor="%s"' % anchor if anchor else ""
        self.add('<text x="%.1f" y="%.1f" class="%s"%s>%s</text>' % (x, y, cls, a, esc(s)))

    def render(self, height):
        w = self.w
        return (
            '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" '
            'viewBox="0 0 %d %d" role="img" aria-labelledby="title desc">\n'
            '<title id="title">%s</title>\n<desc id="desc">%s</desc>\n'
            '<style>%s</style>\n'
            '<rect class="bg" x="0.5" y="0.5" width="%d" height="%d" rx="12"/>\n'
            '%s\n</svg>\n'
        ) % (w, height, w, height, esc(self.title), esc(self.desc),
             chart_style(), w - 1, height - 1, "\n".join(self.parts))


def wrap(s, size, width):
    lines = []
    cur = ""
    for word in s.split():
        nxt = (cur + " " + word).strip()
        if cur and text_w(nxt, size) > width:
            lines.append(cur)
            cur = word
        else:
            cur = nxt
    if cur:
        lines.append(cur)
    return lines


def header(svg, title, headline, caption):
    """The title, the headline number and its caption. Returns the next y."""
    svg.text(PAD, 40, title, "tt")
    svg.text(PAD, 82, headline, "hd")
    y = 82
    x = PAD + text_w(headline, 30, True) + 14
    room = svg.w - PAD - x
    lines = wrap(caption, 13, room) if room > 200 else []
    if 0 < len(lines) <= 2:
        if len(lines) == 1:
            svg.text(x, y - 3, lines[0], "sub")
        else:
            svg.text(x, y - 18, lines[0], "sub")
            svg.text(x, y - 1, lines[1], "sub")
        return y + 30
    for ln in wrap(caption, 13, svg.w - 2 * PAD):
        y += 19
        svg.text(PAD, y, ln, "sub")
    return y + 30


def glyph(svg, level, cx, cy):
    if level == "good":
        svg.add('<circle cx="%.1f" cy="%.1f" r="5" class="st-good"/>' % (cx, cy))
    elif level == "warning":
        svg.add('<path d="M%.1f %.1fl5.6 9.6h-11.2z" class="st-warning"/>' % (cx, cy - 5.6))
    elif level == "critical":
        svg.add('<path d="M%.1f %.1fl5 5-5 5-5-5z" class="st-critical"/>' % (cx, cy - 5))
    else:
        svg.add('<circle cx="%.1f" cy="%.1f" r="4.25" class="hollow"/>' % (cx, cy))


def legend(svg, y, items):
    """items: (kind, class, label), kind box, line or glyph. Returns the next y."""
    x = PAD
    for kind, cls, label in items:
        w = 16 + text_w(label, 12) + 18
        if x + w - 18 > svg.w - PAD and x > PAD:
            x = PAD
            y += 20
        if kind == "box":
            svg.add('<rect x="%.1f" y="%.1f" width="10" height="10" rx="2" class="%s"/>'
                    % (x, y - 9, cls))
        elif kind == "line":
            svg.add('<path d="M%.1f %.1fh12" class="line %s"/>' % (x - 1, y - 4, cls))
        else:
            glyph(svg, cls, x + 5, y - 4)
        svg.text(x + 16, y, label, "lg")
        x += w
    return y + 16


def hbar(x0, y, w, h, r=4, round_end=True):
    """A bar from x0 rightwards: square at the baseline, rounded data end."""
    if w <= 0:
        return ""
    if not round_end or w < 1:
        return "M%.1f %.1fh%.1fv%.1fh%.1fz" % (x0, y, w, h, -w)
    r = min(r, w, h / 2)
    return ("M%.1f %.1fh%.1fa%.1f %.1f 0 0 1 %.1f %.1fv%.1fa%.1f %.1f 0 0 1 %.1f %.1fh%.1fz"
            % (x0, y, w - r, r, r, r, r, h - 2 * r, r, r, -r, r, -(w - r)))


class Row:
    def __init__(self, kind, label, segments=None, value="", more="", short=None,
                 tip="", level=None):
        self.kind = kind            # group or bar
        self.label = label
        self.segments = segments or []   # (value, class); the outer end is rounded
        self.value = value          # ink, beside the bar
        self.more = more            # muted, after value; left out when narrow
        self.short = short          # replaces value when narrow
        self.tip = tip
        self.level = level


def bar_chart(svg, y, rows, vmax, ticks, tick_fmt, axis_label, ref=None, at_tip=False):
    """Horizontal bars, one per row, grouped by group rows. A bar longer than
    vmax is cut at the end of the scale and marked. The value stands in a
    column at the right, or at the tip of its bar. Returns the height."""
    narrow = svg.w < 600
    row_h = 24
    group_h = 28
    bar_h = 12

    def shown(r):
        if narrow:
            return (r.short if r.short is not None else r.value), ""
        return r.value, r.more

    label_w = max([text_w(r.label, 12) for r in rows if r.kind == "bar"] + [48]) + 22
    glyph_w = 16 if any(r.level for r in rows) else 0
    widths = []
    for r in rows:
        if r.kind != "bar":
            continue
        v, m = shown(r)
        widths.append(text_w(v, 12) + (8 + text_w(m, 12) if m else 0))
    value_w = max(widths + [30]) + 12 + glyph_w
    x0 = PAD + label_w
    x1 = svg.w - PAD - value_w
    plot_w = x1 - x0
    top = y + (18 if ref else 0)

    def sx(v):
        return x0 + (0 if vmax <= 0 else plot_w * min(max(v, 0), vmax) / vmax)

    yy = top
    marks = []
    for r in rows:
        if r.kind == "group":
            yy += group_h
            marks.append('<text x="%.1f" y="%.1f" class="gr">%s</text>' % (PAD, yy - 9, esc(r.label)))
            continue
        cy = yy + row_h / 2
        marks.append('<text x="%.1f" y="%.1f" class="lb">%s</text>' % (PAD + 8, cy + 4, esc(r.label)))
        segs = []
        pos = 0.0
        total = sum(v for v, _ in r.segments if v)
        for i, (v, cls) in enumerate(r.segments):
            if not v or v <= 0 or pos >= vmax:
                continue
            a = sx(pos)
            b = sx(pos + v)
            if pos > 0:
                a += 2          # the surface gap between two segments
            last = all(not s[0] or s[0] <= 0 for s in r.segments[i + 1:]) or pos + v >= vmax
            d = hbar(a, cy - bar_h / 2, b - a, bar_h, round_end=last)
            if d:
                segs.append('<path d="%s" class="%s"/>' % (d, cls))
            pos += v
        if total > vmax:
            # Cut at the end of the scale: two gaps across the bar.
            for dx in (16, 10):
                segs.append('<path d="M%.1f %.1fl4 -%d" class="cut"/>'
                            % (x1 - dx, cy + bar_h / 2 + 1, bar_h + 2))
        tip = "<title>%s</title>" % esc(r.tip) if r.tip else ""
        marks.append('<g>%s%s<rect x="%.1f" y="%.1f" width="%.1f" height="%d" '
                     'fill="#000" fill-opacity="0"/></g>'
                     % (tip, "".join(segs), x0, yy, svg.w - PAD - x0, row_h))
        vx = x1 + 12
        if at_tip:
            vx = (sx(min(total, vmax)) if total > 0 else x0) + 8
        if r.level:
            gl = Svg("", "", svg.w)
            glyph(gl, r.level, vx + 5, cy)
            marks.append("".join(gl.parts))
            vx += glyph_w
        v, m = shown(r)
        more = '<tspan class="mu" dx="8">%s</tspan>' % esc(m) if m else ""
        marks.append('<text x="%.1f" y="%.1f" class="vl">%s%s</text>' % (vx, cy + 4, esc(v), more))
        yy += row_h
    bottom = yy + 8
    for t in ticks:
        x = sx(t)
        svg.add('<path d="M%.1f %.1fV%.1f" class="%s"/>' % (x, top + 6, bottom, "base" if t == 0 else "grid"))
        svg.text(x, bottom + 16, tick_fmt(t), "tk", "middle")
    if ref and ref[0] <= vmax:
        x = sx(ref[0])
        svg.add('<path d="M%.1f %.1fV%.1f" class="ref"/>' % (x, top - 2, bottom))
        svg.text(x + 4, top + 2, ref[1], "tk")
    svg.add("\n".join(marks))
    svg.text(x0 + plot_w / 2, bottom + 38, axis_label, "ax", "middle")
    return bottom + 38 + 22


#---------------------------------------------------------------------------#
# Charts from status.json
#---------------------------------------------------------------------------#
def grouped(targets, order):
    out = []
    for a in order:
        ts = [t for t in targets if t.get("arch") == a]
        if ts:
            out.append((a, sorted(ts, key=lambda t: repo_key(t.get("repo", "")))))
    return out


def chart_coverage(ctx, w):
    s = ctx["status"]["summary"]
    svg = Svg("Coverage by repository",
              "Share of each repository's upstream files that the mirror serves, "
              "by file name and sha256, grouped by architecture.", w)
    if not measured(ctx["targets"]):
        cap = "No repository could be read on both sides in this run, so coverage is not known."
    else:
        cap = ("of %s upstream files%s are in the mirror, by name and sha256. %d of %d "
               "repositories have a snapshot." % (fmt_int(s.get("upstream_files")), scope(ctx["targets"], " in"),
                                                 s.get("promoted", 0), s.get("targets", 0)))
    y = header(svg, "Coverage by repository", fmt_pct(s.get("coverage_files")) if measured(ctx["targets"])
               else "unknown", cap)
    groups = grouped(ctx["targets"], ctx["order"])
    items = [("box", "s%d" % ctx["slots"][a], a) for a, _ in groups]
    y = legend(svg, y, items + [("box", "track", "upstream only")])
    rows = []
    for a, ts in groups:
        rows.append(Row("group", a))
        for t in ts:
            c = t.get("coverage")
            name = t.get("target")
            if not c or not c.get("of_files"):
                rows.append(Row("bar", t.get("repo"), [], not_read(t),
                                short="-", tip="%s: %s" % (name, not_read(t))))
                continue
            r = c.get("ratio_files") or 0
            rows.append(Row(
                "bar", t.get("repo"),
                [(r * 100, "s%d" % ctx["slots"][a]), ((1 - r) * 100, "track")],
                fmt_pct(r), "%s / %s" % (fmt_int(c["files"]), fmt_int(c["of_files"])),
                tip="%s: %s of %s files (%s), %s of %s GiB" % (
                    name, fmt_int(c["files"]), fmt_int(c["of_files"]), fmt_pct(r),
                    fmt_gib(c.get("bytes")), fmt_gib(c.get("of_bytes")))))
    ticks = [0, 25, 50, 75, 100] if w >= 600 else [0, 50, 100]
    h = bar_chart(svg, y, rows, 100, ticks, lambda v: "%d%%" % v,
                  "Share of upstream files in the mirror")
    return svg.render(h), h


def chart_freshness(ctx, w):
    status, interval, tolerance = ctx["status"], ctx["interval"], ctx["tolerance"]
    svg = Svg("Snapshot age",
              "Hours since each repository's promoted snapshot was fetched from "
              "upstream, against the sync interval. A bar past the stale limit is "
              "cut at the end of the scale.", w)
    ages = [t["age_seconds"] for t in ctx["targets"]
            if num(t.get("age_seconds")) and (t.get("mirror") or {}).get("state") == "promoted"]
    s = status["summary"]
    cap = ("oldest snapshot. Sync runs every %s. %d of %d repositories match "
           "upstream now." % (fmt_interval(interval), s.get("current", 0), s.get("targets", 0)))
    y = header(svg, "Snapshot age", fmt_age(max(ages)) if ages else "none", cap)
    y = legend(svg, y, [
        ("glyph", "good", "matches upstream, or within 2 syncs"),
        ("glyph", "warning", "late"),
        ("glyph", "critical", "stale, over %s" % fmt_interval(tolerance)),
        ("glyph", "none", "not mirrored yet"),
    ])
    hours = [a / 3600 for a in ages]
    ih = interval / 3600
    vmax = max([min(max(hours + [0]), tolerance / 3600), 2 * ih * 1.2])
    ticks, top = hour_ticks(vmax, 5 if w >= 600 else 3)
    rows = []
    for a, ts in grouped(ctx["targets"], ctx["order"]):
        rows.append(Row("group", a))
        for t in ts:
            lvl, word = freshness(t, interval, tolerance)
            age = t.get("age_seconds")
            if lvl in ("none", "unknown") or not num(age):
                rows.append(Row("bar", t.get("repo"), [], word, short="-",
                                tip="%s: %s" % (t.get("target"), word), level=lvl))
                continue
            rows.append(Row("bar", t.get("repo"), [(age / 3600, "st-%s" % lvl)],
                            fmt_age(age), word, short=fmt_age(age),
                            tip="%s: fetched %s, %s ago, %s" % (
                                t.get("target"), (t.get("mirror") or {}).get("fetched"),
                                fmt_age(age), word), level=lvl))
    h = bar_chart(svg, y, rows, top, ticks, fmt_hours,
                  "Time since the snapshot was fetched from upstream",
                  ref=(ih, "sync every %s" % fmt_interval(interval)))
    return svg.render(h), h


def chart_size(ctx, w):
    s = ctx["status"]["summary"]
    svg = Svg("Size by repository",
              "Compressed package bytes per repository: in the mirror, and upstream "
              "only.", w)
    if s.get("mirrored_bytes") is None:
        head = "unknown"
        cap = "No repository could be read on both sides in this run, so the size is not known."
    else:
        head = "%s GiB" % fmt_gib(s.get("mirrored_bytes"))
        cap = ("in the mirror, of %s GiB upstream (%s by bytes)%s."
               % (fmt_gib(s.get("upstream_bytes")), fmt_pct(s.get("coverage_bytes")), scope(ctx["targets"])))
    y = header(svg, "Size by repository", head, cap)
    groups = grouped(ctx["targets"], ctx["order"])
    items = [("box", "s%d" % ctx["slots"][a], a) for a, _ in groups]
    y = legend(svg, y, items + [("box", "track", "upstream only")])
    gib = 1073741824
    vmax = max([((t.get("coverage") or {}).get("of_bytes") or 0) / gib for t in ctx["targets"]] + [0.001])
    ticks, top = nice_ticks(vmax, 5 if w >= 600 else 3)
    rows = []
    for a, ts in groups:
        rows.append(Row("group", a))
        for t in ts:
            c = t.get("coverage")
            if not c or c.get("of_bytes") is None:
                rows.append(Row("bar", t.get("repo"), [], not_read(t), short="-",
                                tip="%s: %s" % (t.get("target"), not_read(t))))
                continue
            mb = (c.get("bytes") or 0) / gib
            nb = (c.get("of_bytes") or 0) / gib
            rows.append(Row("bar", t.get("repo"),
                            [(mb, "s%d" % ctx["slots"][a]), (max(nb - mb, 0), "track")],
                            "%s GiB" % fmt_gib(c.get("bytes")),
                            "of %s" % fmt_gib(c.get("of_bytes")),
                            short=fmt_gib(c.get("of_bytes")),
                            tip="%s: %s of %s GiB in the mirror" % (
                                t.get("target"), fmt_gib(c.get("bytes")), fmt_gib(c.get("of_bytes")))))
    h = bar_chart(svg, y, rows, top, ticks, lambda v: "%g" % v, "GiB of compressed packages",
                  at_tip=True)
    return svg.render(h), h


#---------------------------------------------------------------------------#
# History
#---------------------------------------------------------------------------#
def history_series(history, now, days=30):
    """{arch: [(t, coverage ratio or None, oldest age or None)]}, last DAYS."""
    start = now - days * 86400
    out = {}
    for line in history:
        t = parse_time(line.get("t"))
        if t is None or t < start or t > now + 3600:
            continue
        per = {}
        for name, x in (line.get("x") or {}).items():
            if not isinstance(x, dict) or "-" not in name:
                continue
            p = per.setdefault(name.split("-", 1)[0], [0, 0, None, False])
            if num(x.get("n")) and num(x.get("m")):
                p[0] += x["n"]
                p[1] += x["m"]
                p[3] = True
            if num(x.get("a")):
                p[2] = x["a"] if p[2] is None else max(p[2], x["a"])
        for arch, (n, m, age, have) in per.items():
            out.setdefault(arch, []).append((t, (m / n) if have and n > 0 else None, age))
    for arch in out:
        out[arch].sort()
    return out


def bucket(points, step, how):
    """One point per STEP seconds: the last value, or the largest. A point
    with no value is left out."""
    if step <= 0:
        return [(t, v) for t, v in points if v is not None]
    keep = {}
    for t, v in points:
        if v is None:
            continue
        k = int(t // step)
        if k not in keep:
            keep[k] = (t, v)
        elif how == "max":
            keep[k] = (max(keep[k][0], t), max(keep[k][1], v))
        else:
            keep[k] = max(keep[k], (t, v))
    return [keep[k] for k in sorted(keep)]


def time_ticks(x0, x1, plot_w):
    span = x1 - x0
    most = max(2, int(plot_w // 72))
    steps = [3600 * h for h in (3, 6, 12, 24, 48, 120, 240)]
    step = next((s for s in steps if span / s <= most), steps[-1])
    fmt = "%H:%M" if step < 86400 else "%b %d"
    t = math.ceil(x0 / step) * step
    ticks = []
    while t <= x1:
        d = utc(t)
        label = d.strftime(fmt)
        if fmt == "%H:%M" and d.hour == 0:
            label = d.strftime("%b %d")
        ticks.append((t, label.replace(" 0", " ")))
        t += step
    return ticks


def line_chart(svg, y, series, slots, y_ticks, ty, y_fmt, y_label, x0, x1, ref=None):
    """One line per series. ty maps a value to 0..1 up the plot."""
    items = [("line", "l%d" % slots.get(a, 0), a) for a, _ in series]
    if ref:
        items.append(("line", "ref", ref[1]))
    y = legend(svg, y, items)
    end_w = max([text_w("%s %s" % (a, y_fmt(v, True)), 12)
                 for a, pts in series for _, v in pts[-1:]] + [40])
    plot_l = PAD + 46
    plot_r = svg.w - PAD - end_w - 20
    top = y + 10
    bottom = top + (200 if svg.w >= 600 else 170)

    def sx(t):
        return plot_l + (plot_r - plot_l) * (t - x0) / max(x1 - x0, 1)

    def sy(v):
        return bottom - (bottom - top) * min(max(ty(v), 0.0), 1.0)

    for v in y_ticks:
        svg.add('<path d="M%.1f %.1fH%.1f" class="%s"/>' % (plot_l, sy(v), plot_r,
                                                          "base" if v == y_ticks[0] else "grid"))
        svg.text(plot_l - 8, sy(v) + 4, y_fmt(v), "tk", "end")
    for t, label in time_ticks(x0, x1, plot_r - plot_l):
        svg.add('<path d="M%.1f %.1fv4" class="base"/>' % (sx(t), bottom))
        svg.text(sx(t), bottom + 18, label, "tk", "middle")
    if ref:
        svg.add('<path d="M%.1f %.1fH%.1f" class="ref"/>' % (plot_l, sy(ref[0]), plot_r))

    ends = []
    for arch, pts in series:
        cls = slots.get(arch, 0)
        if not pts:
            continue
        steps = [b[0] - a[0] for a, b in zip(pts, pts[1:])]
        gap = max(4 * (median(steps) or 3600), 2 * 3600)
        d = []
        prev = None
        for t, v in pts:
            d.append("%s%.1f %.1f" % ("M" if prev is None or t - prev > gap else "L", sx(t), sy(v)))
            prev = t
        svg.add('<path d="%s" class="line l%d"><title>%s</title></path>' % ("".join(d), cls, esc(arch)))
        lt, lv = pts[-1]
        ends.append([sy(lv), arch, lv, sx(lt), sy(lv)])
    # End labels 15 px apart at least, each with a leader line when it moved.
    ends.sort()
    for i in range(1, len(ends)):
        if ends[i][0] < ends[i - 1][0] + 15:
            ends[i][0] = ends[i - 1][0] + 15
    if ends and ends[-1][0] > bottom + 4:
        shift = ends[-1][0] - bottom - 4
        for e in ends:
            e[0] -= shift
    lx = plot_r + 16
    for ly, arch, v, ex, ey in ends:
        if abs(ly - ey) > 2:
            svg.add('<path d="M%.1f %.1fL%.1f %.1f" class="lead"/>' % (ex + 6, ey, lx - 4, ly))
    for ly, arch, v, ex, ey in ends:
        svg.add('<circle cx="%.1f" cy="%.1f" r="4" class="s%d ring"><title>%s %s</title></circle>'
                % (ex, ey, slots.get(arch, 0), esc(arch), esc(y_fmt(v, True))))
        svg.add('<text x="%.1f" y="%.1f" class="vl">%s<tspan class="mu" dx="5">%s</tspan></text>'
                % (lx, ly + 4, esc(arch), esc(y_fmt(v, True))))
    if not ends:
        svg.text((plot_l + plot_r) / 2, (top + bottom) / 2, "No history yet", "note", "middle")
    svg.text((plot_l + plot_r) / 2, bottom + 42, "Time, UTC", "ax", "middle")
    svg.add('<text class="ax" text-anchor="middle" transform="translate(%.1f %.1f) rotate(-90)">%s</text>'
            % (PAD + 6, (top + bottom) / 2, esc(y_label)))
    return bottom + 42 + 22


def history_window(ctx):
    now = ctx["now"]
    series = ctx["series"]
    times = [p[0] for pts in series.values() for p in pts]
    x1 = now
    x0 = max(min(times), now - 30 * 86400) if times else now - 86400
    if x1 - x0 < 86400:
        x0 = x1 - 86400
    if (x1 - x0) / 86400 >= 29.5:
        span = "last 30 days"
    elif times:
        span = "since %s" % utc(min(times)).strftime("%b %d, %H:%M UTC").replace(" 0", " ")
    else:
        span = "no history yet"
    # More than 2 days: one point per 6 hours, so a line reads as a trend.
    step = 6 * 3600 if x1 - x0 > 2 * 86400 else 0
    return x0, x1, span, step


def chart_history_coverage(ctx, w):
    x0, x1, span, step = history_window(ctx)
    s = ctx["status"]["summary"]
    svg = Svg("Coverage, last 30 days",
              "Share of upstream files in the mirror per architecture over time. "
              "A repository that a run could not read counts with its last "
              "measured files. With more than 2 days of history, one point per "
              "6 hours, the last value of each.", w)
    if measured(ctx["targets"]):
        y = header(svg, "Coverage, last 30 days", fmt_pct(s.get("coverage_files")),
                   "of upstream files in the mirror now%s. One line per architecture, %s."
                   % (scope(ctx["targets"]), span))
    else:
        y = header(svg, "Coverage, last 30 days", "unknown",
                   "now: no repository could be read on both sides. One line per architecture, %s." % span)
    series = []
    for a in ctx["hist_order"]:
        pts = [(t, None if c is None else c * 100) for t, c, _ in ctx["series"][a]]
        series.append((a, bucket(pts, step, "last")))
    series = [(a, p) for a, p in series if p]

    def pct(v, end=False):
        return fmt_pct(v / 100) if end else "%d%%" % v

    ticks = [0, 25, 50, 75, 100] if w >= 600 else [0, 50, 100]
    h = line_chart(svg, y, series, ctx["slots"], ticks, lambda v: v / 100, pct,
                   "Share of upstream files", x0, x1)
    return svg.render(h), h


AGE_TICKS = [0.25, 0.5, 1, 3, 6, 12, 24, 72, 168, 720]


def chart_history_age(ctx, w):
    x0, x1, span, step = history_window(ctx)
    s = ctx["status"]["summary"]
    ih = ctx["interval"] / 3600
    svg = Svg("Snapshot age, last 30 days",
              "Age of the oldest promoted snapshot per architecture over time, on a "
              "log scale, against the sync interval. With more than 2 days of "
              "history, one point per 6 hours, the largest of each.", w)
    oldest = s.get("oldest_age_seconds")
    y = header(svg, "Snapshot age, last 30 days", fmt_age(oldest) if num(oldest) else "none",
               "oldest snapshot now. One line per architecture, %s, log scale." % span)
    series = []
    for a in ctx["hist_order"]:
        pts = [(t, None if g is None else g / 3600) for t, _, g in ctx["series"][a]]
        series.append((a, bucket(pts, step, "max")))
    series = [(a, p) for a, p in series if p]
    vals = [v for _, pts in series for _, v in pts]
    hi_v = max(vals + [2 * ih])
    lo = 0.5 if min(vals + [ih]) >= 0.5 else 0.25
    hi = next((t for t in AGE_TICKS if t >= hi_v), AGE_TICKS[-1])
    ticks = [t for t in AGE_TICKS if lo <= t <= hi]
    if w < 600 and len(ticks) > 4:
        ticks = [t for i, t in enumerate(ticks) if i % 2 == 0 or t == hi]

    def ty(v):
        return (math.log(max(v, lo)) - math.log(lo)) / (math.log(hi) - math.log(lo))

    def hours(v, end=False):
        return fmt_age(v * 3600) if end else fmt_hours(v)

    h = line_chart(svg, y, series, ctx["slots"], ticks, ty, hours,
                   "Age, log scale", x0, x1,
                   ref=(ih, "sync every %s" % fmt_interval(ctx["interval"])))
    return svg.render(h), h


#---------------------------------------------------------------------------#
# Bench
#---------------------------------------------------------------------------#
def bench_cases(bench):
    out = {}
    for c in (bench or {}).get("cases") or []:
        if isinstance(c, dict):
            out[(c.get("path"), c.get("op"))] = c
    return out


def bench_totals(bench):
    cases = bench_cases(bench)
    totals = {}
    for p in PATH_ORDER:
        vals = []
        for op in OP_ORDER:
            c = cases.get((p, op))
            if c and c.get("ok") is True and num(c.get("seconds")):
                vals.append(c["seconds"])
            else:
                vals = None
                break
        totals[p] = sum(vals) if vals else None
    return totals


def op_label(op, c):
    files = c.get("files") if c else None
    n = " %s" % fmt_int(files) if isinstance(files, int) else ""
    return {"sy": "pacman -Sy, the databases",
            "sw-small": "pacman -Sw, the%s smallest packages" % n,
            "sw-large": "pacman -Sw, the%s largest packages" % n}.get(op, op)


def chart_speed(ctx, w):
    bench = ctx["bench"]
    svg = Svg("pacman speed by path",
              "Median seconds of pacman -Sy and -Sw through the official mirror, the "
              "Worker, and the oci wrapper with and without prefetch.", w)
    # The oci wrapper is the path this mirror ships: it has the colour, and
    # the other paths are the grey it is measured against.
    items = [("box", "s1", "oci wrapper"), ("box", "s0", "official mirror, Worker, oci serial")]
    if not bench:
        y = header(svg, "pacman speed by path", "no data",
                   "No benchmark yet. The status workflow runs scripts/bench-consumer once a day.")
        y = legend(svg, y, items)
        top = y + 10
        bottom = top + 110
        svg.add('<path d="M%d %.1fV%.1f" class="base"/>' % (PAD + 140, top, bottom))
        svg.add('<path d="M%d %.1fH%.1f" class="base"/>' % (PAD + 140, bottom, svg.w - PAD - 60))
        svg.text((PAD + 140 + svg.w - PAD - 60) / 2, (top + bottom) / 2 + 4,
                 "No measurement yet", "note", "middle")
        svg.text((PAD + 140 + svg.w - PAD - 60) / 2, bottom + 34, "Seconds, median of the rounds",
                 "ax", "middle")
        h = bottom + 56
        return svg.render(h), h
    totals = bench_totals(bench)
    cases = bench_cases(bench)
    rounds = max([len(c.get("rounds") or []) for c in cases.values()] + [0])
    oci = totals.get("oci")
    old = bench_old(bench, ctx["now"])
    cap = ("for -Sy and -Sw through the oci wrapper, median of %d rounds. Official "
           "mirror: %s. Measured %s%s on %s." % (rounds, fmt_secs(totals.get("official")),
                                                str(bench.get("date", "?"))[:10],
                                                " (%s)" % old if old else "", bench.get("host", "?")))
    y = header(svg, "pacman speed by path", fmt_secs(oci) if oci is not None else "failed", cap)
    y = legend(svg, y, items)
    vals = [c["seconds"] for c in cases.values() if num(c.get("seconds"))]
    ticks, top = nice_ticks(max(vals + [0.1]), 5 if w >= 600 else 3)
    rows = []
    for op in OP_ORDER:
        some = [cases.get((p, op)) for p in PATH_ORDER]
        if not any(some):
            continue
        rows.append(Row("group", op_label(op, next((c for c in some if c), None))))
        for p in PATH_ORDER:
            c = cases.get((p, op))
            cls = "s1" if p == "oci" else "s0"
            if not c:
                rows.append(Row("bar", PATH_LABEL[p], [], "not measured", short="-"))
            elif c.get("ok") is not True or not num(c.get("seconds")):
                rows.append(Row("bar", PATH_LABEL[p], [], "failed",
                                tip="%s, %s: failed" % (PATH_LABEL[p], op)))
            else:
                rows.append(Row("bar", PATH_LABEL[p], [(c["seconds"], cls)], fmt_secs(c["seconds"]),
                                tip="%s, %s: median %s of %s; %s files, %.1f MiB" % (
                                    PATH_LABEL[p], op, fmt_secs(c["seconds"]),
                                    ", ".join(fmt_secs(r) for r in (c.get("rounds") or []) if num(r)),
                                    fmt_int(c.get("files")), (c.get("bytes") or 0) / 1048576)))
    h = bar_chart(svg, y, rows, top, ticks, lambda v: "%g s" % v,
                  "Seconds, median of the rounds; shorter is faster", at_tip=True)
    return svg.render(h), h


#---------------------------------------------------------------------------#
# Badges
#---------------------------------------------------------------------------#
BADGE_LIGHT = {"good": "#1a7f37", "warning": "#9a6700", "critical": "#cf222e",
               "none": "#6e7781", "unknown": "#6e7781", "info": "#0969da"}
BADGE_DARK = {"good": "#238636", "warning": "#9e6a03", "critical": "#da3633",
              "none": "#6e7681", "unknown": "#6e7681", "info": "#1f6feb"}


def badge(label, message, level):
    lw = round(badge_w(label) + 12)
    mw = round(badge_w(message) + 12)
    w = lw + mw
    title = "%s: %s" % (label, message)
    style = (".lab{fill:#555}.msg{fill:%s}text{font-family:%s;font-size:11px;fill:#fff}"
             "@media (prefers-color-scheme:dark){.lab{fill:#3d444d}.msg{fill:%s}}"
             % (BADGE_LIGHT[level], FONT, BADGE_DARK[level]))
    return (
        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="20" viewBox="0 0 %d 20" '
        'role="img" aria-label="%s">\n<title>%s</title>\n<style>%s</style>\n'
        '<clipPath id="r"><rect width="%d" height="20" rx="3"/></clipPath>\n'
        '<g clip-path="url(#r)"><rect class="lab" width="%d" height="20"/>'
        '<rect class="msg" x="%d" width="%d" height="20"/></g>\n'
        '<text x="%.1f" y="14" text-anchor="middle">%s</text>\n'
        '<text x="%.1f" y="14" text-anchor="middle">%s</text>\n</svg>\n'
    ) % (w, w, esc(title), esc(title), style, w, lw, lw, mw,
         lw / 2, esc(label), lw + mw / 2, esc(message))


def target_badge(t, interval, tolerance):
    lvl = target_level(t, interval, tolerance)
    if lvl == "none":
        return badge(t["target"], "not mirrored", "none")
    if lvl == "unknown":
        return badge(t["target"], "unknown", "unknown")
    return badge(t["target"], "%s · %s" % (fmt_pct(cov_ratio(t)), fmt_age(t.get("age_seconds"))), lvl)


def group_badge(label, targets, interval, tolerance, count=False):
    """Coverage and age over a group of targets. The ratio is over the
    targets measured in this run. When that is not all of them, the badge
    says how many were, so a part never reads as the whole."""
    promoted = [t for t in targets if (t.get("mirror") or {}).get("state") == "promoted"]
    if not promoted:
        if mirror_unread(targets):
            # The registry did not answer: nothing says the group is not mirrored.
            return badge(label, "unknown", "unknown")
        return badge(label, "not mirrored", "none")
    done = measured(targets)
    n = sum((t["coverage"].get("of_files") or 0) for t in done)
    m = sum((t["coverage"].get("files") or 0) for t in done)
    worst = max((target_level(t, interval, tolerance) for t in targets), key=lambda lv: LEVEL_RANK[lv])
    if worst in ("none", "unknown"):
        worst = "warning"
    ages = [t["age_seconds"] for t in promoted if num(t.get("age_seconds"))]
    parts = [fmt_pct(m / n) if n else "coverage unknown"]
    if count:
        parts.append("%d/%d repos" % (len(promoted), len(targets)))
    else:
        parts.append(fmt_age(max(ages) if ages else None))
    if len(done) < len(targets):
        parts.append("%d of %d measured" % (len(done), len(targets)))
    return badge(label, " · ".join(parts), worst)


def speed_badge(bench, now):
    if not bench:
        return badge("pacman speed", "no data", "none")
    tot = bench_totals(bench)
    if tot.get("oci") is None:
        return badge("pacman speed", "oci failed", "critical")
    msg = "oci %s · official %s" % (fmt_secs(tot["oci"]), fmt_secs(tot.get("official")))
    old = bench_old(bench, now)
    if old:
        # The daily bench has not run since: the time is not current.
        return badge("pacman speed", "%s · %s" % (msg, old), "warning")
    return badge("pacman speed", msg, "info")


