def state_cell(level, word):
    return '<span class="st"><span class="dot %s" aria-hidden="true"></span>%s</span>' % (
        esc(level), esc(word))


def table(head, rows, nums=()):
    h = "".join('<th class="n">%s</th>' % esc(x) if i in nums else "<th>%s</th>" % esc(x)
                for i, x in enumerate(head))
    body = "".join("<tr>%s</tr>" % "".join('<td class="n">%s</td>' % c if i in nums else "<td>%s</td>" % c
                                           for i, c in enumerate(r)) for r in rows)
    return "<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>" % (h, body)


def page(ctx, charts, badges):
    status, targets = ctx["status"], ctx["targets"]
    interval, tolerance, bench = ctx["interval"], ctx["tolerance"], ctx["bench"]
    s = status["summary"]
    wk = status.get("worker") or {}
    worker_url = status.get("worker_url") or ""
    site = status.get("site_url") or ""
    source = status.get("source") or ""
    ns = status.get("namespace") or ""
    registry = status.get("registry") or "ghcr.io"

    def tile(k, v, sub="", raw=False):
        return ('<div class="tile"><div class="k">%s</div><div class="v">%s</div>'
                '<div class="s">%s</div></div>' % (esc(k), v if raw else esc(v), esc(sub)))

    oldest = s.get("oldest_age_seconds")
    if wk.get("ok") is True:
        wv, wl = "ok", "good"
    elif wk.get("ok") is False:
        wv, wl = "failing", "critical"
    else:
        wv, wl = "not judged", "unknown"
    ghcr_ms = fmt_secs((status.get("ghcr") or {}).get("median_manifest_seconds"))
    wsub = "median %s; GHCR manifest %s" % (fmt_secs(wk.get("median_seconds")), ghcr_ms)
    if wk.get("failed_runs"):
        wsub = "%d run(s) in a row; median %s" % (wk["failed_runs"], fmt_secs(wk.get("median_seconds")))
    totals = bench_totals(bench) if bench else {}
    if totals.get("oci") is not None:
        old = bench_old(bench, ctx["now"])
        when = "measured %s" % str(bench.get("date", "?"))[:10]
        sub = "official mirror %s; %s" % (fmt_secs(totals.get("official")), when)
        if old:
            last = tile("pacman, oci wrapper", state_cell("warning", fmt_secs(totals["oci"])),
                        "%s, %s" % (sub, old), raw=True)
        else:
            last = tile("pacman, oci wrapper", fmt_secs(totals["oci"]), sub)
    else:
        last = tile("GHCR manifest", ghcr_ms, "median, read with no credential")

    # A count or a sum over part of the targets says which part.
    n_all = s.get("targets", 0)
    n_err = len(mirror_unread(targets))
    n_done = len(measured(targets))
    if n_err == 0:
        snap = tile("Repositories with a snapshot", "%d of %d" % (s.get("promoted", 0), n_all),
                    "%d match upstream now" % s.get("current", 0))
    elif n_err == n_all:
        snap = tile("Repositories with a snapshot", "unknown",
                    "the registry did not answer for any of the %d" % n_all)
    else:
        snap = tile("Repositories with a snapshot", "%d of %d read" % (s.get("promoted", 0), n_all - n_err),
                    "%d not read from the registry; %d match upstream now" % (n_err, s.get("current", 0)))
    if n_done == 0:
        files = tile("Files in the mirror", "unknown", "no repository read on both sides")
        size = tile("Size in the mirror", "unknown", "no repository read on both sides")
    else:
        files = tile("Files in the mirror", fmt_int(s.get("mirrored_files")),
                     "of %s upstream%s" % (fmt_int(s.get("upstream_files")), scope(targets)))
        size = tile("Size in the mirror", "%s GiB" % fmt_gib(s.get("mirrored_bytes")),
                    "of %s GiB, %s%s" % (fmt_gib(s.get("upstream_bytes")), fmt_pct(s.get("coverage_bytes")),
                                         scope(targets)))
    if n_done == 0:
        hero_big = "unknown"
        hero_cap = ("Coverage is not known: no repository could be read on both sides in this run. "
                    "The table of repositories names what failed.")
    elif n_done == n_all:
        hero_big = fmt_pct(s.get("coverage_files"))
        hero_cap = ("of upstream files are in the mirror, counted by file name and sha256 over %d "
                    "repositories." % n_all)
    else:
        hero_big = fmt_pct(s.get("coverage_files"))
        hero_cap = ("of upstream files are in the mirror, counted by file name and sha256 over the %d of %d "
                    "repositories measured in this run. %d could not be read." % (n_done, n_all, n_all - n_done))
    down = wk.get("down_after") or {}
    down_text = ("Failed probes in %d runs in a row, over %d minutes or more, open the <code>worker-down</code> issue."
                 % (down.get("runs") or 2, (down.get("seconds") or 3000) // 60))
    tiles = "".join([
        snap,
        files,
        size,
        tile("Oldest snapshot", fmt_age(oldest) if num(oldest) else "none",
             "sync runs every %s" % fmt_interval(interval)),
        tile("Worker", state_cell(wl, wv), wsub, raw=True),
        last,
    ])

    def fig(name, alt, tbl):
        _, hw = charts[name]["wide"]
        _, hn = charts[name]["narrow"]
        return ('<figure><a href="charts/%(n)s.svg"><picture>'
                '<source media="(max-width: 600px)" srcset="charts/narrow/%(n)s.svg" width="%(nw)d" height="%(nh)d">'
                '<img src="charts/%(n)s.svg" width="%(ww)d" height="%(wh)d" alt="%(alt)s" loading="lazy">'
                '</picture></a><details><summary>Table</summary><div class="scroll">%(t)s</div></details></figure>'
                % {"n": name, "nw": NARROW, "nh": hn, "ww": WIDE, "wh": hw, "alt": esc(alt), "t": tbl})

    cov_rows, size_rows, fresh_rows = [], [], []
    for t in targets:
        c = t.get("coverage") or {}
        lvl, word = freshness(t, interval, tolerance)
        cov_rows.append([esc(t["target"]), esc(fmt_int(c.get("files"))), esc(fmt_int(c.get("of_files"))),
                         esc(fmt_pct(c.get("ratio_files"))), esc(fmt_int(c.get("missing")))])
        size_rows.append([esc(t["target"]), esc(fmt_gib(c.get("bytes"))), esc(fmt_gib(c.get("of_bytes"))),
                          esc(fmt_pct(c.get("ratio_bytes")))])
        fresh_rows.append([esc(t["target"]), state_cell(lvl, word),
                           esc(fmt_time((t.get("mirror") or {}).get("fetched"))),
                           esc(fmt_age(t.get("age_seconds"))), esc(fmt_age(t.get("lag_seconds")))])
    hist_rows = []
    for a in ctx["hist_order"]:
        pts = ctx["series"][a]
        covs = [p for p in pts if p[1] is not None]
        ages = [p[2] for p in pts if p[2] is not None]
        hist_rows.append([esc(a), esc(utc(pts[0][0]).strftime("%Y-%m-%d %H:%M")),
                          esc(fmt_pct(covs[0][1]) if covs else "-"), esc(fmt_pct(covs[-1][1]) if covs else "-"),
                          esc(fmt_age(max(ages)) if ages else "-"), esc(fmt_int(len(pts)))])
    hist_table = table(["architecture", "first point", "coverage then", "coverage now",
                        "largest age", "points"], hist_rows, (2, 3, 4, 5))
    speed_rows = []
    cases = bench_cases(bench)
    for op in OP_ORDER:
        for p in PATH_ORDER:
            c = cases.get((p, op))
            if c:
                speed_rows.append([esc(op), esc(PATH_LABEL[p]),
                                   esc(fmt_secs(c.get("seconds")) if c.get("ok") is True else "failed"),
                                   esc(", ".join(fmt_secs(r) for r in (c.get("rounds") or []) if num(r))),
                                   esc(fmt_int(c.get("files"))),
                                   esc("%.1f" % ((c.get("bytes") or 0) / 1048576))])
    figs = "".join([
        fig("coverage", ("Coverage by repository: %s of upstream files%s are in the mirror."
                         % (fmt_pct(s.get("coverage_files")), scope(targets, " in"))) if n_done
            else "Coverage by repository: not known in this run.",
            table(["repository", "in the mirror", "upstream", "share", "missing"], cov_rows, (1, 2, 3, 4))),
        fig("freshness", "Snapshot age per repository, against the sync interval.",
            table(["repository", "state", "fetched, UTC", "age", "lag"], fresh_rows, (3, 4))),
        fig("history-coverage", "Coverage per architecture over the last 30 days.", hist_table),
        fig("history-age", "Oldest snapshot age per architecture over the last 30 days.", hist_table),
        fig("size", ("Size by repository: %s GiB of %s GiB%s are in the mirror."
                     % (fmt_gib(s.get("mirrored_bytes")), fmt_gib(s.get("upstream_bytes")), scope(targets, " in")))
            if n_done else "Size by repository: not known in this run.",
            table(["repository", "GiB in the mirror", "GiB upstream", "share"], size_rows, (1, 2, 3))),
        fig("speed", "pacman speed through each path, from the daily benchmark.",
            table(["operation", "path", "median", "rounds", "files", "MiB"], speed_rows, (2, 4, 5))
            if speed_rows else "<p>No benchmark yet.</p>"),
    ])

    repo_rows = []
    for t in targets:
        c = t.get("coverage") or {}
        u = t.get("upstream") or {}
        lvl, word = target_word(t, interval, tolerance)
        names = c.get("missing_names") or []
        miss = esc(fmt_int(c.get("missing")))
        if names:
            more = (c.get("missing") or 0) - len(names)
            miss = ('<details><summary>%s</summary><div class="missing">%s%s</div></details>'
                    % (miss, ", ".join("<code>%s</code>" % esc(n) for n in names),
                       esc(", and %s more" % fmt_int(more)) if more > 0 else ""))
        probes = []
        for key in ("db", "package"):
            p = (t.get("worker") or {}).get(key)
            if p:
                probes.append("%s %s%s" % (key, p.get("code"), " failed" if p.get("ok") is False else ""))
        repo_rows.append([
            "<code>%s</code>" % esc(t["target"]), state_cell(lvl, word),
            esc(fmt_pct(c.get("ratio_files"))), esc(fmt_int(c.get("files"))), esc(fmt_int(c.get("of_files"))),
            miss, esc(fmt_gib(c.get("of_bytes"))), esc(fmt_age(t.get("age_seconds"))),
            esc(fmt_age(t.get("lag_seconds"))), esc(fmt_time((t.get("mirror") or {}).get("fetched"))),
            esc(u.get("server") or u.get("error") or "-"), esc(", ".join(probes) or "-"),
            '<img src="badges/%s.svg" alt="%s badge" height="20">' % (esc(t["target"]), esc(t["target"])),
        ])
    repos = table(["repository", "state", "coverage", "files", "upstream", "missing", "GiB", "age",
                   "lag", "fetched, UTC", "upstream server", "Worker", "badge"],
                  repo_rows, (2, 3, 4, 5, 6, 7, 8))

    probe_rows = []
    for t in targets:
        for key in ("db", "package"):
            p = (t.get("worker") or {}).get(key)
            if not p:
                continue
            ok = p.get("ok")
            lvl = "good" if ok is True else ("critical" if ok is False else "unknown")
            probe_rows.append([
                esc(t["target"]), esc(key), "<code>%s</code>" % esc(p.get("url")),
                esc(p.get("code")), esc(p.get("expect") if p.get("expect") is not None else "-"),
                esc(fmt_secs(p.get("seconds"))), esc(p.get("location") or "-"),
                state_cell(lvl, "ok" if ok is True else (p.get("error") or "not judged"))])
    probes_html = (table(["repository", "probe", "URL", "HTTP", "expected", "time", "redirect to",
                          "result"], probe_rows, (3, 4, 5))
                   if probe_rows else "<p>The Worker was not probed.</p>")

    badge_rows = []
    for name in badges:
        badge_rows.append(['<img src="badges/%s.svg" alt="%s badge" height="20">' % (esc(name), esc(name)),
                           "<code>%sbadges/%s.svg</code>" % (esc(site), esc(name))])

    use = ""
    if worker_url:
        use = (
            '<h2>Use the mirror</h2><div class="use">'
            '<div><h3>Through the Worker, no client</h3><p>pacman downloads as usual. The Worker '
            'answers each request with a redirect to GHCR.</p><pre><code>[core]\nServer = %(w)s/$arch/$repo\n'
            'Include = /etc/pacman.d/mirrorlist</code></pre></div>'
            '<div><h3>Through the oci wrapper</h3><p>pacman reads the registry with '
            '<code>client/pacman-oci</code> as its XferCommand.</p><pre><code>[options]\n'
            'XferCommand = /usr/local/bin/pacman-oci %%o %%u\n\n[core]\n'
            'Server = oci://%(r)s/%(ns)s/$arch/$repo\nInclude = /etc/pacman.d/mirrorlist</code></pre></div>'
            '</div>' % {"w": esc(worker_url), "r": esc(registry), "ns": esc(ns)})

    return """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>mirror-archlinux status</title>
<meta name="description" content="Coverage, freshness and speed of the Arch Linux repositories mirrored to GHCR.">
<style>%(css)s</style>
</head>
<body>
<div class="wrap">
<header class="top">
<div>
<h1>mirror-archlinux status</h1>
<p class="lede">Arch Linux repositories for %(narch)d architectures, mirrored to GitHub Container Registry and served to pacman.</p>
<p class="meta">Measured %(gen)s. Source: <a href="%(source)s">%(source_text)s</a>.</p>
</div>
<div class="badges"><img src="badges/all.svg" alt="all repositories badge" height="20"><img src="badges/speed.svg" alt="pacman speed badge" height="20"></div>
</header>
<section class="hero" aria-label="Summary">
<div>
<p class="big">%(cov)s</p>
<p class="big-cap">%(cap)s</p>
</div>
<div class="tiles">%(tiles)s</div>
</section>
%(use)s
<h2>Charts</h2>
<div class="charts">%(figs)s</div>
<h2>Repositories</h2>
<div class="scroll">%(repos)s</div>
<h2>Worker probes</h2>
<p>Each probe is one GET with no redirect followed. A repository with a snapshot must answer 302 to <code>https://*.githubusercontent.com</code>. A repository with no snapshot must answer 404. %(down)s</p>
<div class="scroll">%(probes)s</div>
<h2>Badges</h2>
<div class="scroll">%(badges)s</div>
<footer>
<p>Coverage counts an upstream file when the mirror's database names the same file name with the same sha256. Age is the time since the snapshot was fetched from upstream. Lag is the newest upstream build date minus the newest build date in the mirror. A snapshot that matches upstream is current at any age.</p>
<p>Data: <a href="status.json">status.json</a>, <a href="history.json">history.json</a>, <a href="bench.json">bench.json</a>. Written by <code>scripts/status-collect</code> and <code>scripts/status-render</code>.</p>
</footer>
</div>
</body>
</html>
""" % {
        "css": PAGE_CSS, "gen": esc(fmt_time(status.get("generated")) + " UTC"),
        "source": esc(source), "source_text": esc(source.replace("https://", "")),
        "narch": len(ctx["order"]), "cov": esc(hero_big), "cap": esc(hero_cap), "down": down_text,
        "tiles": tiles, "use": use, "figs": figs, "repos": repos,
        "probes": probes_html, "badges": table(["badge", "URL"], badge_rows),
    }


#---------------------------------------------------------------------------#
# Input
#---------------------------------------------------------------------------#
def read_json(path, what, required):
    if not os.path.exists(path):
        if required:
            die("%s: no such file" % path, "it is %s" % what, "reproduce: ls -l %s" % path)
        return None
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        if required:
            die("%s does not read as JSON: %s" % (path, e),
                "reproduce: python3 -I -m json.tool %s" % path)
        warn("%s does not read as JSON, so it is left out: %s" % (path, e))
        return None


def read_history(path):
    out = []
    if not os.path.exists(path):
        return out
    with open(path, encoding="utf-8") as f:
        for i, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except ValueError as e:
                warn("%s line %d is not JSON, so it is left out: %s" % (path, i, e))
                continue
            if not isinstance(obj, dict) or parse_time(obj.get("t")) is None:
                warn("%s line %d has no time t, so it is left out" % (path, i))
                continue
            out.append(obj)
    return out


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    os.replace(tmp, path)


def main(argv):
    if len(argv) != 3:
        sys.stderr.write("usage: python3 -I scripts/status-render IN OUT_SITE\n")
        return 2
    src, site = argv[1], argv[2]
    status = read_json(os.path.join(src, "status.json"), "scripts/status-collect's output", True)
    if not isinstance(status, dict) or status.get("schema") != 1:
        die("%s/status.json is not schema 1" % src,
            "reproduce: python3 -I -m json.tool %s/status.json" % src)
    if not isinstance(status.get("summary"), dict):
        die("%s/status.json has no summary" % src)
    targets = status.get("targets")
    if not isinstance(targets, list) or not targets:
        die("%s/status.json names no target" % src)
    for t in targets:
        if not isinstance(t, dict) or not isinstance(t.get("target"), str) or "-" not in t["target"]:
            die("%s/status.json has a target entry with no arch-repo name: %r" % (src, t))
        t.setdefault("arch", t["target"].split("-", 1)[0])
        t.setdefault("repo", t["target"].split("-", 1)[1])
    history = read_history(os.path.join(src, "history.jsonl"))
    bench = read_json(os.path.join(src, "bench.json"), "scripts/bench-consumer's output", False)
    if bench is not None and (not isinstance(bench, dict) or bench.get("schema") != 1
                              or not isinstance(bench.get("cases"), list)):
        warn("%s/bench.json is not schema 1 with a cases list, so it is left out" % src)
        bench = None
    if bench is not None and not bench["cases"]:
        bench = None

    sync = status.get("sync") or {}
    order, slots = arch_slots({t["arch"] for t in targets})
    now = status.get("generated_epoch") or parse_time(status.get("generated")) or 0
    series = history_series(history, now)
    ctx = {
        "status": status, "bench": bench, "order": order, "slots": slots, "now": now,
        "targets": sorted(targets, key=lambda t: target_key(t, order)),
        "interval": (sync.get("interval_minutes") or 180) * 60,
        "tolerance": (sync.get("tolerance_days") or 3) * 86400,
        "series": series,
        "hist_order": [a for a in order if a in series] + sorted(a for a in series if a not in order),
    }

    builders = [("coverage", chart_coverage), ("freshness", chart_freshness),
                ("size", chart_size), ("history-coverage", chart_history_coverage),
                ("history-age", chart_history_age), ("speed", chart_speed)]
    charts = {}
    for name, build in builders:
        charts[name] = {"wide": build(ctx, WIDE), "narrow": build(ctx, NARROW)}
        write(os.path.join(site, "charts", name + ".svg"), charts[name]["wide"][0])
        write(os.path.join(site, "charts", "narrow", name + ".svg"), charts[name]["narrow"][0])

    interval, tolerance = ctx["interval"], ctx["tolerance"]
    badges = []
    for t in ctx["targets"]:
        write(os.path.join(site, "badges", t["target"] + ".svg"), target_badge(t, interval, tolerance))
        badges.append(t["target"])
    for a in order:
        ts = [t for t in ctx["targets"] if t["arch"] == a]
        write(os.path.join(site, "badges", a + ".svg"), group_badge(a, ts, interval, tolerance))
        badges.append(a)
    write(os.path.join(site, "badges", "all.svg"),
          group_badge("mirror", ctx["targets"], interval, tolerance, count=True))
    badges.append("all")
    write(os.path.join(site, "badges", "speed.svg"), speed_badge(bench, now))
    badges.append("speed")

    write(os.path.join(site, "index.html"), page(ctx, charts, badges))
    write(os.path.join(site, "status.json"), json.dumps(status, indent=1) + "\n")
    write(os.path.join(site, "history.json"), json.dumps(history, separators=(",", ":")) + "\n")
    write(os.path.join(site, "bench.json"),
          json.dumps(bench if bench is not None else {"schema": 1, "cases": []}, indent=1) + "\n")
    sys.stderr.write("%s: %d chart(s) in 2 widths, %d badge(s), %d history point(s), bench %s, in %s\n"
                     % (PROG, len(charts), len(badges), len(history),
                        "present" if bench else "absent", site))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
