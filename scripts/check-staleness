#!/usr/bin/env bash
#
# Say which targets have stopped following upstream.
#
#   scripts/check-staleness OUT [TARGET.conf ...]
#
# For each enabled target: the database latest serves, read the way a consumer
# reads it with the registry's own token flow (PACMAN_OCI_NO_DUMMY=1, so that
# path is exercised on schedule too), and upstream's current database from the
# target's db_servers. The target is stale when the two differ AND the promoted
# snapshot was fetched more days ago than the tolerance scripts/cron-tolerance
# derives from sync.yml's own cron. Equal databases are current however old the
# snapshot is: an upstream that does not move is not a mirror that stopped.
#
# ⭐ This measures the outcome, not the runs. A schedule that stopped firing, a
# run that is green and promotes nothing, a target held run after run by one
# bad file: each ends here, as a database that has stopped following upstream.
#
# A target with no latest at all, whose file git added or enabled no more than
# the tolerance ago, is new: the sync has not seeded it yet. Older, it is
# stale. Enabled is the last change to the file's enabled line: a file added
# with "enabled = no" starts its grace when that line goes. ⚠ When git cannot
# say when the file was added (no git, a shallow clone, a file git does not
# track), it is stale: an unknown age is never a grace period. watchdog.yml
# checks out the whole history for this.
#
# OUT/<target>.state   current fresh new stale unknown
# OUT/<target>.md      the issue body for a stale or unknown target
#
# Environment: MIRROR_NOW (seconds) pins the clock, for the test suite only.
#
# Exit status: 0 nothing stale, 3 at least one target stale or unknown, 1 the
# check could not run.
set -euo pipefail
SCRIPT_NAME=check-staleness
# shellcheck source=lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need curl jq awk sha256sum

out="${1:-}"
[ -n "$out" ] || die "usage: scripts/check-staleness OUT [TARGET.conf ...]"
shift
[ -n "$MIRROR_NAMESPACE" ] || die "MIRROR_NAMESPACE is not set"
mkdir -p "$out"

if [ "$#" -eq 0 ]; then
  for conf in "$TARGETS_DIR"/*.conf; do
    [ -e "$conf" ] || continue
    if target_enabled "$conf"; then
      set -- "$@" "$conf"
    fi
  done
fi
[ "$#" -gt 0 ] || die "no enabled target"

read -r _ tolerance <<< "$("$REPO_ROOT/scripts/cron-tolerance" "$REPO_ROOT/.github/workflows/sync.yml")"
today="$(iso_now)"
today="${today:0:10}"
run_url="${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY:-pkgforge-dev/mirror-archlinux}/actions/workflows/sync.yml"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# added_date CONF -> YYYY-MM-DD of the later of two commits: the last that
# added CONF, and the last that changed its enabled line. Nothing when git
# cannot say; what git said then goes to stderr.
added_date() {
  local dir base shallow added enabled rc=0
  if ! command -v git > /dev/null; then
    log "git is not on PATH, so the date $1 was added is unknown"
    return 0
  fi
  dir="$(dirname "$1")"
  base="$(basename "$1")"
  shallow="$(git -C "$dir" rev-parse --is-shallow-repository 2> "$work/git.err")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    log "git cannot say when $1 was added: $(sed -n 1p "$work/git.err")"
    return 0
  fi
  if [ "$shallow" != false ]; then
    log "the clone is shallow, so the date $1 was added is unknown" \
      "reproduce: git -C $dir rev-parse --is-shallow-repository"
    return 0
  fi
  # --first-parent: the date CONF reached this branch (the merge or squash
  # commit), not the date of a commit on the branch it came from. git diffs a
  # merge against its first parent here, so -G sees an enabled line that a
  # merge changed.
  added="$(git -C "$dir" log --first-parent --diff-filter=A --format=%cs -- "$base" | awk 'NR == 1')"
  enabled="$(git -C "$dir" log -1 --first-parent --format=%cs -G '^[[:space:]]*enabled[[:space:]]*=' -- "$base")"
  # YYYY-MM-DD sorts as text.
  printf '%s\n' "$added" "$enabled" | awk 'NF' | sort | tail -n 1
}

worst=0
for conf in "$@"; do
  target_check "$conf"
  repo="$(target_get "$conf" repo)"
  name="$(target_get "$conf" arch)-$repo"
  repo_path="$(target_repository "$conf")"
  rm -f "$out/$name.md"

  # What latest serves, through the wrapper's token flow
  promoted=""
  fetched=""
  rc=0
  REGISTRY_TOKEN='' PACMAN_OCI_NO_DUMMY=1 "$WRAPPER" "$work/$name.db.part" "$OCI_SCHEME://$MIRROR_REGISTRY/$repo_path/$repo.db" || rc=$?
  if [ "$rc" -eq 0 ]; then
    promoted="$(sha256sum "$work/$name.db.part" | cut -d ' ' -f 1)"
  fi
  rc=0
  REGISTRY_TOKEN='' registry_manifest "$repo_path" latest "$work/$name.json" || rc=$?
  latest_absent=0
  if [ "$rc" -eq "$REG_STATUS_OK" ]; then
    fetched="$(jq -r '.annotations["dev.pkgforge.mirror.fetched"] // empty' "$work/$name.json")"
  elif [ "$rc" -eq "$REG_STATUS_ABSENT" ]; then
    latest_absent=1
  fi

  # What upstream serves now
  upstream=""
  while IFS= read -r server; do
    [ -n "$server" ] || continue
    rc=0
    fetch_upstream "$server/$repo.db" "$work/$name.up" || rc=$?
    if [ "$rc" -eq 0 ]; then
      upstream="$(sha256sum "$work/$name.up" | cut -d ' ' -f 1)"
      break
    fi
  done <<< "$(target_all "$conf" db_server)"

  verdict="$(stale_verdict "$promoted" "$upstream" "$fetched" "$today" "$tolerance")"
  added=""
  if [ "$verdict" = stale ] && [ "$latest_absent" -eq 1 ]; then
    added="$(added_date "$conf")"
    if [ -n "$added" ] && [ "$("$REPO_ROOT/scripts/date-age" "$added" "$today")" -le "$tolerance" ]; then
      verdict=new
    fi
  fi
  printf '%s\n' "$verdict" > "$out/$name.state"
  printf '%-24s %-8s promoted %s, fetched %s, upstream %s, tolerance %s day(s)%s\n' \
    "$name" "$verdict" "${promoted:-none}" "${fetched:-never}" "${upstream:-unreadable}" "$tolerance" \
    "${added:+, target added or enabled $added}"

  case "$verdict" in
    current | fresh | new) continue ;;
  esac
  worst=3
  # shellcheck disable=SC2016 # Markdown backticks, not command substitution
  {
    printf '<!-- reported by scripts/check-staleness on %s -->\n' "$today"
    printf '`%s` has stopped following upstream.\n\n' "$repo_path"
    printf '| | |\n| --- | --- |\n'
    printf '| verdict | %s |\n' "$verdict"
    printf '| `latest` serves | `%s` |\n' "${promoted:-nothing readable}"
    printf '| fetched | %s |\n' "${fetched:-never}"
    printf '| upstream now | `%s` |\n' "${upstream:-no db_server answered}"
    if [ "$latest_absent" -eq 1 ]; then
      printf '| target file added or enabled | %s |\n' "${added:-unknown to git}"
    fi
    printf '| tolerance | %s day(s), from sync.yml'"'"'s cron |\n\n' "$tolerance"
    printf 'The latest sync runs and their summaries: %s\n\n' "$run_url"
    printf 'Each run'"'"'s summary names the state of every target (held, replaced, private, behind, error) and the files at fault.\n\n'
    printf 'reproduce:\n\n```bash\nPACMAN_OCI_NO_DUMMY=1 client/pacman-oci /tmp/%s.db.part oci://%s/%s/%s.db && sha256sum /tmp/%s.db.part\n```\n\n' \
      "$repo" "$MIRROR_REGISTRY" "$repo_path" "$repo" "$repo"
    printf 'This issue closes itself when the mirror follows upstream again.\n'
  } > "$out/$name.md"
done
exit "$worst"
