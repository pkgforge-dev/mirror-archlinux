#!/usr/bin/env bash
#
# Measure what the mirror serves against what upstream serves, for the status
# page and the worker-down check of status.yml.
#
#   scripts/status-collect OUT [TARGET.conf ...]
#
# With no target file, every enabled target in targets/ is measured. For each
# target:
#   upstream  <repo>.db through scripts/upstream-db, within the target's share
#             of STATUS_BUDGET: every db_server is read, a database that is
#             not whole or that is behind another is dropped, and the first
#             one left, in db_server order, is upstream
#   mirror    the latest manifest and the database it names, read with no
#             credential (the anonymous token flow), the way a consumer reads
#   coverage  upstream (filename, sha256) pairs that the mirror database also
#             names, by count and by bytes; the first 20 missing file names
#   age       now minus the snapshot's fetched time
#   lag       upstream newest build date minus the mirror's newest build date
#   worker    GET <worker>/<arch>/<repo>/<repo>.db and one package, with no
#             redirect followed: 302 to an https URL when latest exists, 404
#             when it does not. The signed URL of a 302 must answer one byte
#             to the runner, with no credential (probe, below). Once per run,
#             the smallest promoted database is downloaded through the
#             Worker, redirects followed, and must have latest's sha256
#   ghcr      the time of the direct latest manifest GET
#
# Writes:
#   OUT/status.json    schema 1, below
#   OUT/history.jsonl  one compact line appended per run; the last
#                      STATUS_HISTORY_LINES (2000) lines are kept
#   OUT/worker.md      the worker-down issue body: every probe, and how to
#                      reproduce the first failure
# OUT/history.jsonl is read first when it exists, so the caller puts the
# previous run's copy there.
#
# status.json, schema 1. Times are ISO 8601 UTC, sizes are bytes, durations
# are seconds, a ratio is 0 to 1, null is "not measured":
#   schema 1, generated, generated_epoch, source, site_url, registry,
#   namespace, worker_url
#   sync      {workflow, interval_minutes, tolerance_days}, from sync.yml's cron
#   summary   {targets, promoted, current, measured, mirror_unread,
#             upstream_files, upstream_bytes, mirrored_files, mirrored_bytes,
#             coverage_files, coverage_bytes, oldest_age_seconds,
#             newest_age_seconds, last_synced}
#             measured counts the targets with a coverage, read on both
#             sides. The files, bytes and coverage sums are over those
#             targets only, and null when there is none. mirror_unread counts
#             the targets whose registry did not answer (mirror state error):
#             promoted does not count them, whatever they hold. last_synced
#             is when the mirror last changed: the newest of each target's
#             mirror.created, or its mirror.fetched when the manifest names
#             no created time. null when no latest names either.
#   worker    {probed, ok, probes, failures, failed_runs, failing_since,
#             failing_seconds, down, down_after {runs, seconds},
#             median_seconds}; failed_runs counts the runs in a row, this one
#             included, in which a probe failed. failing_seconds is the time
#             from failing_since to this run. down is true when failed_runs
#             and failing_seconds both reach down_after: status.yml raises
#             worker-down then. Runs are not an hour apart: sync.yml also
#             starts a status run when it ends. probes and failures count
#             the download too; median_seconds leaves it out, because it
#             moves a whole file.
#   ghcr      {median_manifest_seconds}
#   targets[] {target, arch, repo, repository,
#     upstream {ok, server, sha256, files, bytes, newest_builddate, tried[]
#               {server, result}, error}; tried has one entry per db_server,
#               in db_server order, and result is ok, behind by N
#               package(s) (against which server), refused (and why),
#               HTTP <code>, curl <status>, not read (no time left of the
#               share), or not asked (and why),
#     mirror   {state promoted|absent|error, error, manifest_code,
#               manifest_seconds, fetched, created, run, db_sha256, files,
#               bytes, newest_builddate}; created is the latest manifest's
#               org.opencontainers.image.created, which oras sets when stage
#               pushes the snapshot, or null,
#     current  true when the mirror database is upstream's database,
#     coverage {files, of_files, ratio_files, bytes, of_bytes, ratio_bytes,
#               missing, missing_names[]} or null when upstream or the
#               registry is unread (mirror state error),
#     age_seconds, lag_seconds,
#     worker   {db, package, download}, each a probe or null: {url, code,
#               expect, seconds, location (the host of a redirect), ok,
#               error, signed_code (the signed URL's answer to one byte),
#               location_unexpected (true: a host outside
#               *.githubusercontent.com whose signed URL works), cache and
#               blob_host (the Worker's x-mirror-cache and
#               x-mirror-blob-host headers, or null)}. download is on one
#               target per run, with sha256 and want_sha256 in place of the
#               last four}
#
# history.jsonl, one object per line:
#   {"t": generated, "w": {"ok", "f": failed_runs, "s": failing_since, "ms"},
#    "g": {"ms"}, "x": {"<target>": {"n": upstream files, "m": mirrored
#    files, "b": upstream bytes, "mb": mirrored bytes, "k": 1 carried, "a":
#    age, "l": lag, "c": 1 current, 0 not, null unknown}}}
# A target with no coverage in this run keeps n, m, b and mb from the last
# line that has them, with "k": 1. So a read that fails once does not move
# the coverage history of its architecture. With no such line they are null.
#
# ⛔ The upstream reads end within STATUS_BUDGET seconds (default 900), below
# the build job's 30 minutes, with room for the render and the push. Each
# target gets a share: what is left of the budget, divided by the targets not
# yet read. scripts/upstream-db reads the db_servers within the share. A host
# that fails is asked last by every later target, so a stalled db_server costs
# one deadline per run. A target whose reads do not fit is a measurement: its
# upstream.error names STATUS_BUDGET. The read of the mirror's database gets
# REG_BLOB_MAX_TIME (120 s), which lib.sh registry_blob reads.
#
# Environment:
#   MIRROR_NAMESPACE      owner/name, default from GITHUB_REPOSITORY
#   MIRROR_REGISTRY       default ghcr.io
#   STATUS_WORKER_URL     default https://ghcr.mirror.archlinux.pkgforge.dev;
#                         empty: no Worker probe
#   STATUS_SITE_URL       default https://<owner>.github.io/<name>/
#   STATUS_HISTORY_LINES  default 2000
#   STATUS_BUDGET         default 900 (seconds)
#   MIRROR_NOW            seconds; pins the clock, for the test suite only
#
# ⚠ db_records reads the database with GNU tar (--wildcards). busybox tar
# cannot, so this runs on the runner, not in Alpine.
#
# Exit status: 0 measured (a target that cannot be read is a measurement, and
# is in status.json), 1 the collect itself could not run.
set -euo pipefail
SCRIPT_NAME=status-collect
# shellcheck source=lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need curl jq awk sha256sum tar sort timeout

out="${1:-}"
[ -n "$out" ] || die "usage: scripts/status-collect OUT [TARGET.conf ...]"
shift
[ -n "$MIRROR_NAMESPACE" ] || die "MIRROR_NAMESPACE is not set" \
  "set it to owner/name, or set GITHUB_REPOSITORY"
mkdir -p "$out"
STATUS_BUDGET="${STATUS_BUDGET:-900}"
case "$STATUS_BUDGET" in
  '' | *[!0-9]* | 0) die "STATUS_BUDGET must be a positive integer, not '$STATUS_BUDGET'" ;;
esac
run_deadline=$((SECONDS + STATUS_BUDGET))
# The whole read of one database blob of the mirror, retries included.
export REG_BLOB_MAX_TIME="${REG_BLOB_MAX_TIME:-120}"
# The whole token request of one target, retries included. It is asked once
# per target, so a token endpoint that stalls costs at most 15 x 35 s here,
# inside the 30 minutes of the job, not 15 x 250 s.
export REG_TOKEN_MAX_TIME="${REG_TOKEN_MAX_TIME:-30}"

# Anonymous, the way a consumer reads: with REGISTRY_TOKEN empty, lib.sh
# registry_token asks the token endpoint with no credential, and gives what
# an anonymous reader gets.
REGISTRY_TOKEN=''
WORKER_URL="${STATUS_WORKER_URL-https://ghcr.mirror.archlinux.pkgforge.dev}"
WORKER_URL="${WORKER_URL%/}"
HISTORY_LINES="${STATUS_HISTORY_LINES:-2000}"
[[ "$HISTORY_LINES" =~ ^[1-9][0-9]*$ ]] || die "STATUS_HISTORY_LINES must be a positive integer, not '$HISTORY_LINES'"
# worker-down: failed probes in this many runs in a row, over at least this
# many seconds. The cron runs status.yml at :47 each hour, and sync.yml starts
# it after each sync, so two runs can be minutes apart.
WORKER_DOWN_RUNS=2
WORKER_DOWN_SECONDS=3000
owner="${MIRROR_NAMESPACE%%/*}"
name_part="${MIRROR_NAMESPACE#*/}"
SITE_URL="${STATUS_SITE_URL:-https://$owner.github.io/${name_part%%/*}/}"
SOURCE_URL="${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY:-$MIRROR_NAMESPACE}"
UA="mirror-archlinux-status (+$SOURCE_URL)"

if [ "$#" -eq 0 ]; then
  for conf in "$TARGETS_DIR"/*.conf; do
    [ -e "$conf" ] || continue
    if target_enabled "$conf"; then
      set -- "$@" "$conf"
    fi
  done
fi
[ "$#" -gt 0 ] || die "no enabled target" "reproduce: ls $TARGETS_DIR"

now="$(now_epoch)"
[[ "$now" =~ ^[0-9]+$ ]] || die "the clock reads '$now', not seconds"
generated="$(jq -nr --argjson t "$now" '$t | todate')"

sync_wf="$REPO_ROOT/.github/workflows/sync.yml"
interval="$("$REPO_ROOT/scripts/cron-tolerance" --minutes "$sync_wf")"
read -r _ tolerance <<< "$("$REPO_ROOT/scripts/cron-tolerance" "$sync_wf")"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/t"

#---------------------------------------------------------------------------#
# get URL OUT [HEADER ...] -> "CODE SECONDS LOCATION" on stdout, curl's status
# as the return. Redirects are not followed: a probe measures the answer it
# gets. The body is kept in OUT, so an error body can be quoted, and the
# response headers in OUT.h.
#---------------------------------------------------------------------------#
get() {
  local url="$1" body="$2" args=() h rc=0 res
  shift 2
  for h in "$@"; do
    args+=(--header "$h")
  done
  : > "$body.h"
  res="$(curl -q --silent --show-error --connect-timeout 10 --max-time 30 \
    --proto '=http,https' --user-agent "$UA" "${args[@]}" --dump-header "$body.h" \
    --output "$body" --write-out '%{http_code} %{time_total} %{redirect_url}' "$url")" || rc=$?
  printf '%s\n' "$res"
  return "$rc"
}

# header_of FILE NAME -> the value of the response header NAME in FILE, any
# case, or nothing
header_of() {
  awk -v want="$2" '
    { line = $0; sub(/\r$/, "", line); i = index(line, ":") }
    i > 0 && tolower(substr(line, 1, i - 1)) == want { v = substr(line, i + 1); sub(/^[ \t]+/, "", v) }
    END { print v }
  ' "$1"
}

# num VALUE -> VALUE when it is a JSON number, else null
num() {
  if [[ "${1:-}" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    printf '%s\n' "$1"
  else
    printf 'null\n'
  fi
}

# http_code VALUE -> the three digit code as a number, 0 when curl gave none
http_code() {
  if [[ "${1:-}" =~ ^[0-9]{3}$ ]]; then
    printf '%d\n' "$((10#$1))"
  else
    printf '0\n'
  fi
}

# records_stats RECORDS.tsv -> "COUNT BYTES NEWEST_BUILDDATE"
records_stats() {
  awk -F '\t' '
    { n++; b += $6; if ($7 + 0 > nb) nb = $7 + 0 }
    END { printf "%d %.0f %.0f\n", n, b, nb }
  ' "$1"
}

# probe NAME URL EXPECT DIR -> one probe object, as JSON, on stdout
#
# EXPECT is the code the Worker must answer: 302 when latest exists, 404 when
# it does not, empty when the registry could not be read. With no EXPECT only
# no answer or a 5xx fails; any other answer is measured and not judged.
#
# ⛔ A 302 is followed once, the way a consumer follows it. A GET of the
# Location from the runner must answer 206 or 200. It sends no credential,
# and Range: bytes=0-0. The Worker gets the signed URL from a Cloudflare address
# and hands it to another client. A URL bound to the asker, or one the blob
# host refuses, fails every download through the Worker while the 302 looks
# right. The Location must be https. A host outside *.githubusercontent.com
# whose signed URL works is recorded as location_unexpected, and passes.
probe() {
  local label="$1" url="$2" expect="$3" dir="$4" rc=0 res code secs loc host ok err
  local s_rc=0 s_code="" unexpected=false cache blob_host
  res="$(get "$url" "$dir/$label.body")" || rc=$?
  read -r code secs loc <<< "$res"
  code="$(http_code "${code:-}")"
  host=""
  if [ -n "${loc:-}" ]; then
    host="${loc#*://}"
    host="${host%%[/?#]*}"
  fi
  cache="$(header_of "$dir/$label.body.h" x-mirror-cache)"
  blob_host="$(header_of "$dir/$label.body.h" x-mirror-blob-host)"
  ok=null
  err=""
  if [ "$rc" -ne 0 ]; then
    err="curl $rc: no answer within the 30 s deadline, or the connection failed"
  elif [ -z "$expect" ]; then
    if [ "$code" -ge 500 ]; then err="HTTP $code"; fi
  elif [ "$code" != "$expect" ]; then
    err="HTTP $code, expected $expect"
  elif [ "$expect" = 302 ] && ! [[ "${loc:-}" =~ ^https://[^/?#]+/ ]]; then
    err="302 to '${host:-nothing}', not to an https URL"
  elif [ "$expect" = 302 ]; then
    res="$(get "$loc" "$dir/$label.signed" 'Range: bytes=0-0')" || s_rc=$?
    read -r s_code _ _ <<< "$res"
    s_code="$(http_code "${s_code:-}")"
    if [ "$s_rc" -ne 0 ]; then
      err="the signed URL did not answer (curl $s_rc)"
    elif [ "$s_code" != 206 ] && [ "$s_code" != 200 ]; then
      err="the signed URL answered $s_code"
    elif ! [[ "$loc" =~ ^https://[^/?#]*\.githubusercontent\.com/ ]]; then
      unexpected=true
      log "worker probe $url: 302 to '$host', outside *.githubusercontent.com; its signed URL answered $s_code"
    fi
  fi
  if [ -n "$err" ]; then
    ok=false
  elif [ -n "$expect" ]; then
    ok=true
  fi
  [ -z "$err" ] || log "worker probe $url: $err"
  jq -nc --arg url "$url" --argjson code "$code" --arg expect "$expect" \
    --argjson secs "$(num "${secs:-}")" --arg host "$host" --argjson ok "$ok" --arg err "$err" \
    --arg s_code "$s_code" --argjson unexpected "$unexpected" --arg cache "$cache" --arg blob_host "$blob_host" \
    'def nul: if . == "" then null else . end;
     {url: $url, code: $code, expect: (if $expect == "" then null else ($expect | tonumber) end),
      seconds: $secs, location: ($host | nul), ok: $ok, error: ($err | nul),
      signed_code: (if $s_code == "" then null else ($s_code | tonumber) end),
      location_unexpected: $unexpected, cache: ($cache | nul), blob_host: ($blob_host | nul)}'
}

# download URL WANT DIR -> one probe object, as JSON, on stdout: the whole
# file through the Worker, redirects followed as pacman follows them, within
# 60 s. Its sha256 must be WANT.
download() {
  local url="$1" want="$2" dir="$3" rc=0 res code secs got="" ok=true err=""
  res="$(curl -q --silent --show-error --location --max-redirs 3 --proto '=https' --proto-redir '=https' \
    --connect-timeout 10 --max-time 60 --user-agent "$UA" \
    --output "$dir/download.body" --write-out '%{http_code} %{time_total}' "$url")" || rc=$?
  read -r code secs <<< "$res"
  code="$(http_code "${code:-}")"
  if [ -f "$dir/download.body" ]; then
    got="$(sha256sum "$dir/download.body" | cut -d ' ' -f 1)"
  fi
  if [ "$rc" -ne 0 ]; then
    err="curl $rc: no whole answer within 60 s, or the connection failed"
  elif [ "$code" != 200 ]; then
    err="HTTP $code at the end of the redirects, expected 200"
  elif [ "$got" != "$want" ]; then
    err="the file has sha256 $got, and latest names $want"
  fi
  if [ -n "$err" ]; then
    ok=false
    log "worker download $url: $err"
  fi
  jq -nc --arg url "$url" --argjson code "$code" --argjson secs "$(num "${secs:-}")" --argjson ok "$ok" \
    --arg err "$err" --arg got "$got" --arg want "$want" \
    'def nul: if . == "" then null else . end;
     {url: $url, code: $code, expect: 200, seconds: $secs, location: null, ok: $ok, error: ($err | nul),
      sha256: ($got | nul), want_sha256: $want}'
}

#---------------------------------------------------------------------------#
# One target
#---------------------------------------------------------------------------#
collect_target() {
  local conf="$1" share="$2" arch repo name repo_path tw
  target_check "$conf"
  arch="$(target_get "$conf" arch)"
  repo="$(target_get "$conf" repo)"
  name="$arch-$repo"
  repo_path="$(target_repository "$conf")"
  tw="$work/$name"
  mkdir -p "$tw"

  #-------------------------------------------------------------------------#
  # Upstream, within the target's share of STATUS_BUDGET
  #-------------------------------------------------------------------------#
  local rc res up_server="" up_err="" tried
  rc=0
  "$REPO_ROOT/scripts/upstream-db" "$conf" "$share" "$work/down" "$tw/up" STATUS_BUDGET || rc=$?
  local up_ok=false up_sha="" up_n="" up_b="" up_nb=""
  case "$rc" in
    0)
      # A whole database, not behind another db_server's (scripts/upstream-db)
      up_server="$(cat "$tw/up/server")"
      mv -f "$tw/up/upstream.db" "$tw/up.db"
      mv -f "$tw/up/upstream.tsv" "$tw/up.tsv"
      up_sha="$(sha256sum "$tw/up.db" | cut -d ' ' -f 1)"
      up_ok=true
      read -r up_n up_b up_nb <<< "$(records_stats "$tw/up.tsv")"
      ;;
    3)
      up_err="$(cat "$tw/up/why")"
      log "$name: $up_err"
      ;;
    *) die "scripts/upstream-db could not read $name (exit $rc)" "reproduce: scripts/upstream-db $conf $share DOWN OUT" ;;
  esac
  # One {server, result} per db_server, in db_server order
  tried="$(jq -R -s -c 'split("\n") | map(select(. != "") | split("\t") | {server: .[0], result: .[1]})' "$tw/up/tried.tsv")"

  #-------------------------------------------------------------------------#
  # The mirror's latest, anonymously
  #-------------------------------------------------------------------------#
  local token="" m_state m_err="" m_code=0 m_secs="" fetched="" created="" run="" m_sha="" m_n="" m_b="" m_nb="" errc d
  rc=0
  token="$(registry_token "$repo_path" pull)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    res="$(get "$REG_URL/v2/$repo_path/manifests/latest" "$tw/latest.json" \
      "Authorization: Bearer $token" \
      'Accept: application/vnd.oci.image.manifest.v1+json')" || rc=$?
    read -r m_code m_secs _ <<< "$res"
    m_code="$(http_code "${m_code:-}")"
  else
    m_secs=""
  fi
  if [ -z "$token" ]; then
    m_state=error
    m_err="no pull token for $repo_path"
  elif [ "$rc" -ne 0 ]; then
    m_state=error
    m_err="no answer for $repo_path:latest (curl $rc)"
  elif [ "$m_code" = 200 ] && jq -e '.schemaVersion == 2' "$tw/latest.json" > /dev/null; then
    m_state=promoted
  elif [ "$m_code" = 404 ]; then
    errc="$(registry_error_code "$tw/latest.json")"
    case "$errc" in
      MANIFEST_UNKNOWN | NAME_UNKNOWN) m_state=absent ;;
      *)
        m_state=error
        m_err="$repo_path:latest answered 404 with error code '${errc:-none}'"
        ;;
    esac
  else
    m_state=error
    m_err="$repo_path:latest answered HTTP $m_code"
  fi

  if [ "$m_state" = promoted ]; then
    fetched="$(jq -r '.annotations["dev.pkgforge.mirror.fetched"] // empty' "$tw/latest.json")"
    run="$(jq -r '.annotations["dev.pkgforge.mirror.run"] // empty' "$tw/latest.json")"
    if [ -n "$fetched" ] && ! [[ "$fetched" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
      warn "$name: latest names a fetched time '$fetched' that is not ISO 8601 UTC; the age is not measured"
      fetched=""
    fi
    # oras writes whole seconds. A fraction is cut, so jq's fromdateiso8601
    # reads the time.
    created="$(jq -r '.annotations["org.opencontainers.image.created"] // empty' "$tw/latest.json")"
    if [[ "$created" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})([.][0-9]+)?Z$ ]]; then
      created="${BASH_REMATCH[1]}Z"
    elif [ -n "$created" ]; then
      warn "$name: latest names a created time '$created' that is not ISO 8601 UTC; its fetched time counts as its synced time"
      created=""
    fi
    read -r d _ _ <<< "$(manifest_layer "$tw/latest.json" "$repo.db")"
    if [ -z "${d:-}" ]; then
      m_state=error
      m_err="$repo_path:latest has no single layer titled $repo.db"
    else
      rc=0
      registry_blob "$repo_path" "$d" "$tw/mirror.db" || rc=$?
      if [ "$rc" -ne 0 ]; then
        m_state=error
        m_err="could not read $repo.db ($d) of $repo_path"
      else
        m_sha="${d#sha256:}"
        rc=0
        db_records "$tw/mirror.db" "$tw/mirror.tsv" || rc=$?
        if [ "$rc" -ne 0 ]; then
          m_state=error
          m_err="$repo.db of $repo_path:latest does not read as a database"
        else
          read -r m_n m_b m_nb <<< "$(records_stats "$tw/mirror.tsv")"
        fi
      fi
    fi
  fi
  [ -z "$m_err" ] || log "$name: $m_err"

  #-------------------------------------------------------------------------#
  # Coverage: an upstream file counts when the mirror names the same file
  # name with the same sha256
  #-------------------------------------------------------------------------#
  local cov=null cm cn cmb cnb missing_json
  if [ "$up_ok" = true ] && [ "$m_state" != error ]; then
    touch "$tw/mirror.tsv"
    read -r cn cm cnb cmb <<< "$(awk -F '\t' -v miss="$tw/missing.txt" '
      FILENAME == ARGV[1] { have[$1 SUBSEP $5] = 1; next }
      { n++; nb += $6; if (($1 SUBSEP $5) in have) { m++; mb += $6 } else print $1 > miss }
      END { close(miss); printf "%d %d %.0f %.0f\n", n, m, nb, mb }
    ' "$tw/mirror.tsv" "$tw/up.tsv")"
    touch "$tw/missing.txt"
    missing_json="$(LC_ALL=C sort "$tw/missing.txt" | awk 'NR <= 20' | jq -R . | jq -sc .)"
    cov="$(jq -nc --argjson m "$cm" --argjson n "$cn" --argjson mb "$cmb" --argjson nb "$cnb" \
      --argjson names "$missing_json" \
      '{files: $m, of_files: $n, ratio_files: (if $n > 0 then $m / $n else null end),
        bytes: $mb, of_bytes: $nb, ratio_bytes: (if $nb > 0 then $mb / $nb else null end),
        missing: ($n - $m), missing_names: $names}')"
  fi

  #-------------------------------------------------------------------------#
  # The Worker, with no redirect followed
  #-------------------------------------------------------------------------#
  local w_db=null w_pkg=null expect="" pkg
  if [ -n "$WORKER_URL" ]; then
    case "$m_state" in
      promoted) expect=302 ;;
      absent) expect=404 ;;
    esac
    w_db="$(probe db "$WORKER_URL/$arch/$repo/$repo.db" "$expect" "$tw")"
    if [ "$m_state" = promoted ]; then
      # One package by a plain name: the first by name, so the probe is the
      # same file from run to run while the database stays the same.
      pkg="$(awk -F '\t' '$1 ~ /^[a-z0-9][a-z0-9._-]*[.]pkg[.]tar[.][a-z0-9]+$/ { print $1 }' "$tw/mirror.tsv" |
        LC_ALL=C sort | awk 'NR == 1')"
      if [ -n "$pkg" ]; then
        w_pkg="$(probe package "$WORKER_URL/$arch/$repo/$pkg" 302 "$tw")"
      fi
    fi
  fi

  jq -nc \
    --arg target "$name" --arg arch "$arch" --arg repo "$repo" \
    --arg repository "$MIRROR_REGISTRY/$repo_path" \
    --argjson up_ok "$up_ok" --arg up_server "$up_server" --arg up_sha "$up_sha" \
    --argjson up_n "$(num "$up_n")" --argjson up_b "$(num "$up_b")" --argjson up_nb "$(num "$up_nb")" \
    --argjson tried "$tried" --arg up_err "$up_err" \
    --arg m_state "$m_state" --arg m_err "$m_err" --argjson m_code "$m_code" \
    --argjson m_secs "$(num "${m_secs:-}")" --arg fetched "$fetched" --arg created "$created" --arg run "$run" \
    --arg m_sha "$m_sha" --argjson m_n "$(num "$m_n")" --argjson m_b "$(num "$m_b")" \
    --argjson m_nb "$(num "$m_nb")" --argjson cov "$cov" --argjson now "$now" \
    --argjson w_db "$w_db" --argjson w_pkg "$w_pkg" '
    def nul: if . == "" then null else . end;
    {
      target: $target, arch: $arch, repo: $repo, repository: $repository,
      upstream: {ok: $up_ok, server: ($up_server | nul), sha256: ($up_sha | nul),
        files: $up_n, bytes: $up_b, newest_builddate: $up_nb, tried: $tried, error: ($up_err | nul)},
      mirror: {state: $m_state, error: ($m_err | nul), manifest_code: $m_code, manifest_seconds: $m_secs,
        fetched: ($fetched | nul), created: ($created | nul), run: ($run | nul), db_sha256: ($m_sha | nul),
        files: $m_n, bytes: $m_b, newest_builddate: $m_nb},
      current: (if $up_sha != "" and $m_sha != "" then $up_sha == $m_sha
                elif $m_state == "absent" and $up_ok then false else null end),
      coverage: $cov,
      age_seconds: (if $fetched != "" then $now - ($fetched | fromdateiso8601) else null end),
      lag_seconds: (if $up_nb != null and $m_nb != null then $up_nb - $m_nb else null end),
      worker: {db: $w_db, package: $w_pkg}
    }' > "$work/t/$name.json"

  printf '%-20s upstream %-5s %6s files  mirror %-8s coverage %s  worker %s\n' "$name" \
    "$up_ok" "${up_n:-?}" "$m_state" \
    "$(jq -r 'if .coverage == null then "unknown" else "\(.coverage.files)/\(.coverage.of_files)" end' "$work/t/$name.json")" \
    "$(jq -r '[.worker.db, .worker.package] | map(select(. != null) | "\(.code)\(if .ok == false then "!" else "" end)") | join(",") | if . == "" then "-" else . end' "$work/t/$name.json")" >&2
}

left="$#"
for conf in "$@"; do
  share=$(((run_deadline - SECONDS) / left))
  if [ "$share" -lt 0 ]; then
    share=0
  fi
  left=$((left - 1))
  collect_target "$conf" "$share"
done
log "the targets took $((SECONDS + STATUS_BUDGET - run_deadline))s; STATUS_BUDGET=${STATUS_BUDGET}s bounds their upstream reads"

#---------------------------------------------------------------------------#
# Once per run, the whole file a consumer gets: the smallest database of a
# target with latest, downloaded through the Worker. It must be the database
# latest names. The result is that target's worker.download probe.
#---------------------------------------------------------------------------#
if [ -n "$WORKER_URL" ]; then
  best="" best_size="" best_arch="" best_repo="" best_sha=""
  for f in "$work"/t/*.json; do
    read -r t_name t_arch t_repo t_sha <<< "$(jq -r 'select(.mirror.state == "promoted" and .mirror.db_sha256 != null)
      | "\(.target) \(.arch) \(.repo) \(.mirror.db_sha256)"' "$f")"
    [ -n "${t_sha:-}" ] || continue
    size="$(wc -c < "$work/$t_name/mirror.db" | tr -d ' ')"
    if [ -z "$best" ] || [ "$size" -lt "$best_size" ]; then
      best="$t_name" best_size="$size" best_arch="$t_arch" best_repo="$t_repo" best_sha="$t_sha"
    fi
  done
  if [ -n "$best" ]; then
    d="$(download "$WORKER_URL/$best_arch/$best_repo/$best_repo.db" "$best_sha" "$work/$best")"
    jq -c --argjson d "$d" '.worker.download = $d' "$work/t/$best.json" > "$work/t/$best.json.new"
    mv -f "$work/t/$best.json.new" "$work/t/$best.json"
    log "worker download of $best_repo.db of $best ($best_size bytes): $(jq -r 'if .ok then "ok" else .error end' <<< "$d")"
  fi
fi

#---------------------------------------------------------------------------#
# The Worker's failure streak, from the previous run's line
#---------------------------------------------------------------------------#
prev_f=0
prev_s=""
if [ -s "$out/history.jsonl" ]; then
  last="$(tail -n 1 "$out/history.jsonl")"
  rc=0
  parsed="$(jq -r '[(.w.f // 0 | tostring), (.w.s // "")] | join(" ")' <<< "$last" 2> "$work/jq.err")" || rc=$?
  if [ "$rc" -eq 0 ] && [[ "$parsed" =~ ^([0-9]+)\ ?(.*)$ ]]; then
    prev_f="${BASH_REMATCH[1]}"
    prev_s="${BASH_REMATCH[2]}"
    if [ -n "$prev_s" ] && ! [[ "$prev_s" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
      warn "the last line of $out/history.jsonl names a failing time '$prev_s' that is not ISO 8601 UTC; the Worker failure time starts again" \
        "reproduce: tail -n 1 $out/history.jsonl | jq .w"
      prev_s=""
    fi
  else
    warn "the last line of $out/history.jsonl does not read; the Worker failure count starts again" \
      "$(cat "$work/jq.err")" "reproduce: tail -n 1 $out/history.jsonl | jq ."
  fi
fi

jq -s \
  --arg generated "$generated" --argjson now "$now" --arg source "$SOURCE_URL" \
  --arg site "$SITE_URL" --arg registry "$MIRROR_REGISTRY" --arg ns "$MIRROR_NAMESPACE" \
  --arg worker "$WORKER_URL" --argjson interval "$(num "$interval")" \
  --argjson tolerance "$(num "${tolerance:-}")" \
  --argjson prev_f "$prev_f" --arg prev_s "$prev_s" \
  --argjson down_runs "$WORKER_DOWN_RUNS" --argjson down_secs "$WORKER_DOWN_SECONDS" '
  def median: sort | if length == 0 then null elif length % 2 == 1 then .[length / 2 | floor]
    else (.[length / 2 - 1] + .[length / 2]) / 2 end;
  # A sum over the measured targets; null when none was measured, not 0.
  def total(f): if length == 0 then null else map(f // 0) | add end;
  . as $t
  | ([$t[] | .worker.db, .worker.package, .worker.download | select(. != null)]) as $probes
  | ([$probes[] | select(.ok == false)] | length) as $fail
  | (if ($probes | length) == 0 then null
     elif $fail > 0 then false
     elif ([$probes[] | select(.ok == true)] | length) > 0 then true
     else null end) as $wok
  | (if $wok == false then $prev_f + 1 else 0 end) as $f_runs
  | (if $wok == false then (if $prev_f > 0 and $prev_s != "" then $prev_s else $generated end) else null end) as $f_since
  | (if $f_since == null then null else $now - ($f_since | fromdateiso8601) end) as $f_secs
  | ([$t[] | select(.coverage != null)]) as $cov
  | ($cov | total(.coverage.of_files)) as $nf
  | ($cov | total(.coverage.files)) as $mf
  | ($cov | total(.coverage.of_bytes)) as $nb
  | ($cov | total(.coverage.bytes)) as $mb
  | ([$t[] | .age_seconds | select(. != null)]) as $ages
  | {
      schema: 1,
      generated: $generated,
      generated_epoch: $now,
      source: $source,
      site_url: $site,
      registry: $registry,
      namespace: $ns,
      worker_url: (if $worker == "" then null else $worker end),
      sync: {workflow: ".github/workflows/sync.yml", interval_minutes: $interval, tolerance_days: $tolerance},
      summary: {
        targets: ($t | length),
        promoted: ([$t[] | select(.mirror.state == "promoted")] | length),
        current: ([$t[] | select(.current == true)] | length),
        measured: ($cov | length),
        mirror_unread: ([$t[] | select(.mirror.state == "error")] | length),
        upstream_files: $nf,
        upstream_bytes: $nb,
        mirrored_files: $mf,
        mirrored_bytes: $mb,
        coverage_files: (if ($nf // 0) > 0 then $mf / $nf else null end),
        coverage_bytes: (if ($nb // 0) > 0 then $mb / $nb else null end),
        oldest_age_seconds: ($ages | max),
        newest_age_seconds: ($ages | min),
        # One ISO 8601 UTC form for both, so the largest string is the newest.
        last_synced: ([$t[] | .mirror.created // .mirror.fetched | select(. != null)] | max)
      },
      worker: {
        probed: ($worker != ""),
        ok: $wok,
        probes: ($probes | length),
        failures: $fail,
        failed_runs: $f_runs,
        failing_since: $f_since,
        failing_seconds: $f_secs,
        down: ($wok == false and $f_runs >= $down_runs and $f_secs >= $down_secs),
        down_after: {runs: $down_runs, seconds: $down_secs},
        # The answers of the Worker only: a download also moves the file.
        median_seconds: ([$probes[] | select(.want_sha256 == null) | .seconds | select(. != null)] | median)
      },
      ghcr: {median_manifest_seconds: ([$t[] | .mirror.manifest_seconds | select(. != null)] | median)},
      targets: ($t | sort_by(.target))
    }' "$work"/t/*.json > "$work/status.json"
mv "$work/status.json" "$out/status.json"

#---------------------------------------------------------------------------#
# History: one compact line per run, the last HISTORY_LINES kept
#---------------------------------------------------------------------------#
# The last measured files and bytes of each target, from the lines before.
# A line that does not read is left out here, and counted.
known='{"x":{},"bad":0}'
if [ -s "$out/history.jsonl" ]; then
  rc=0
  known="$(jq -c -n -R '
    reduce (inputs | try fromjson catch "unreadable") as $l ({x: {}, bad: 0};
      if ($l | type) != "object" then .bad += 1
      else reduce (($l.x // {}) | if type == "object" then to_entries[] else empty end
                   | select((.value | type) == "object" and (.value.n | type) == "number"
                            and (.value.m | type) == "number")) as $e (.;
             .x[$e.key] = ($e.value | {n, m, b, mb}))
      end)' "$out/history.jsonl" 2> "$work/known.err")" || rc=$?
  [ "$rc" -eq 0 ] || die "could not read $out/history.jsonl for the last measured files (jq ended $rc)" \
    "$(cat "$work/known.err")" "reproduce: jq -R 'fromjson? | .x' $out/history.jsonl"
  bad="$(jq -r .bad <<< "$known")"
  if [ "$bad" -gt 0 ]; then
    warn "$bad line(s) of $out/history.jsonl do not read as JSON objects; they give no last measured files" \
      "reproduce: jq -c . $out/history.jsonl"
  fi
fi
jq -c --argjson known "$known" '{
    t: .generated,
    w: {ok: .worker.ok, f: .worker.failed_runs, s: .worker.failing_since,
        ms: (if .worker.median_seconds == null then null else (.worker.median_seconds * 1000 | round) end)},
    g: {ms: (if .ghcr.median_manifest_seconds == null then null else (.ghcr.median_manifest_seconds * 1000 | round) end)},
    x: (.targets | map({key: .target, value: (
          (if .coverage != null then
             {n: .coverage.of_files, m: .coverage.files, b: .coverage.of_bytes, mb: .coverage.bytes}
           elif $known.x[.target] != null then $known.x[.target] + {k: 1}
           else {n: null, m: null, b: null, mb: null} end)
          + {a: .age_seconds, l: .lag_seconds,
             c: (if .current == true then 1 elif .current == false then 0 else null end)})}) | from_entries)
  }' "$out/status.json" > "$work/line.json"
if [ -f "$out/history.jsonl" ]; then
  cat "$out/history.jsonl" "$work/line.json" > "$work/history.all"
else
  cp "$work/line.json" "$work/history.all"
fi
tail -n "$HISTORY_LINES" "$work/history.all" > "$work/history.jsonl"
mv "$work/history.jsonl" "$out/history.jsonl"

#---------------------------------------------------------------------------#
# The worker-down issue body
#---------------------------------------------------------------------------#
# shellcheck disable=SC2016 # Markdown backticks inside a jq program
jq -r '
  def cell: if . == null then "-" else tostring end;
  "<!-- written by scripts/status-collect on \(.generated) -->",
  (if .worker.ok == false then
     "The Worker fails its probe in \(.worker.failed_runs) run(s) in a row, since \(.worker.failing_since). worker-down opens at \(.worker.down_after.runs) runs in a row over \(.worker.down_after.seconds / 60 | floor) minutes or more."
   elif .worker.ok == true then "The Worker passes every probe."
   else "The Worker was not probed, or no probe could be judged." end),
  "",
  "Worker: \(.worker_url // "not set"). Each probe is a GET with no redirect followed. A target with `latest` must answer 302 to an https URL, and that signed URL must answer a GET of one byte (`Range: bytes=0-0`), with no credential, with 206 or 200. A target with no `latest` must answer 404. Once per run, the smallest database of a target with `latest` is downloaded through the Worker, redirects followed: it must have the sha256 that `latest` names.",
  "",
  "| target | probe | HTTP | expected | signed URL | seconds | result |",
  "| --- | --- | --- | --- | --- | --- | --- |",
  (.targets[] as $t | [["db", $t.worker.db], ["package", $t.worker.package], ["download", $t.worker.download]][]
    | select(.[1] != null)
    | "| \($t.target) | \(.[0]) | \(.[1].code) | \(.[1].expect | cell) | \(.[1].signed_code | cell) | \(.[1].seconds | cell) | \(if .[1].ok == true then "ok" elif .[1].ok == false then .[1].error else "not judged" end) |"),
  "",
  ([.targets[] | .worker.db, .worker.package, .worker.download | select(. != null and .ok == false)] | first // null
   | if . == null then empty
     elif .want_sha256 != null then
       "reproduce:\n\n```bash\ncurl --connect-timeout 10 --max-time 60 -sSL \"\(.url)\" | sha256sum\n```\n"
     elif (.error // "") | startswith("the signed URL") then
       "reproduce:\n\n```bash\nloc=\"$(curl --connect-timeout 10 --max-time 30 -sS -o /dev/null -w \"%{redirect_url}\" \"\(.url)\")\"\ncurl --connect-timeout 10 --max-time 30 -sS -o /dev/null -r 0-0 -w \"%{http_code}\\n\" \"$loc\"\n```\n"
     else
       "reproduce:\n\n```bash\ncurl --connect-timeout 10 --max-time 30 -sS -o /dev/null -w \"%{http_code} %{redirect_url}\\n\" \"\(.url)\"\n```\n"
     end),
  "This issue closes itself when the Worker passes its probes again."
' "$out/status.json" > "$work/worker.md"
mv "$work/worker.md" "$out/worker.md"

jq -r '"status-collect: \(.summary.targets) target(s), \(.summary.promoted) promoted, \(.summary.mirror_unread) not read from the registry, coverage \(if .summary.coverage_files == null then "unknown" else (.summary.coverage_files * 1000 | floor / 10 | tostring) + "%" end) over \(.summary.measured) measured, worker \(.worker.ok | if . == null then "not judged" else tostring end), failed runs \(.worker.failed_runs), down \(.worker.down)"' "$out/status.json" >&2
