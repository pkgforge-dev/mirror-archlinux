#!/usr/bin/env bash
#
# Mirror every file of one shard, several at a time, and account for each one.
#
#   scripts/mirror-shard SHARD.tsv OUT
#
# OUT/results.tsv gets one line per work line of SHARD.tsv (scripts/mirror-file
# describes it), and OUT/summary.txt a count by status.
#
# ⭐ Every work line ends with exactly one result. xargs is handed line numbers,
# never the lines themselves, so a tab or a quote in a field cannot split or
# change an argument; and after xargs returns, a line with no result file is
# counted as failed, so an item that died without writing one, or one xargs
# never started because it gave up early, is not silently missing.
#
# Each item writes its result to OUT/lines/LINE.tsv the moment it ends. A shard
# killed before results.tsv is written (the job ran out of time) still leaves
# those, and scripts/stage reads them: what was pushed counts.
#
# Every mirror-file of the shard shares one pull token, kept in a file in the
# work directory (lib.sh REGISTRY_TOKEN_CACHE), and one record of the servers
# that failed (lib.sh down_mark): a server that fails for one file is asked
# last for every file after it.
#
# OUT/plan-id is the id of the plan the shard comes from, read from
# SHARD.tsv's plan directory (scripts/plan writes PLAN/<target>/plan-id and
# PLAN/<target>/shards/<n>.tsv). It is written first, so even a shard that is
# killed leaves it. scripts/stage reads no result of another plan.
#
# ⛔ The re-run guard. A re-run of the job (GITHUB_RUN_ATTEMPT above 1)
# mirrors from an older plan, and a newer run can have written the index
# since. A tag that a row of the index vouches for must not be written. So,
# before the first file, a re-run reads the live index once (lib.sh
# index_guard): the tag INDEX_TAG of the plan directory's meta.env, in the
# repository of its TARGET, with the workflow's token. It writes one of:
#   $WORK/index-listed.txt  the filenames of its m rows; empty when there is
#                           no index tag. scripts/mirror-file writes no tag
#                           of a file it lists.
#   $WORK/index-unread      why the live index did not read. Then
#                           scripts/mirror-file writes no tag in this shard.
# Attempt 1 reads nothing. When plan read the index (INDEX_STATE ok), it
# withdrew the rows of the files it gives the shards. When it did not
# (unread, ignored), scripts/mirror-file writes no repush, and a push goes
# only to an absent tag, which no valid row vouches for. The sync concurrency
# group lets no other run write between.
#
# INDEX_STATE comes from the plan directory's meta.env, read as data, as
# index_guard reads TARGET and INDEX_TAG. It is exported for
# scripts/mirror-file, which writes a repush only when it is ok, absent or
# invalid. A missing meta.env or key gives unknown.
#
# The work goes in the directory with the most free space among $RUNNER_TEMP,
# /mnt and /tmp, counting each filesystem once. scripts/debloat-runner runs
# only when the PARALLEL largest files of the shard would not fit; if they
# still do not fit after it, PARALLEL comes down until they do.
#
# Environment: PARALLEL (default 4), SHARD_INDEX, DEBLOAT (auto, always or
# never; default auto), MIRROR_NAMESPACE, REGISTRY_USER, REGISTRY_TOKEN,
# ORAS_CACHE (scripts/install-oras), GITHUB_RUN_ATTEMPT (default 1),
# MIRROR_REPAIR (0 or 1, default 1; scripts/mirror-file).
#
# Exit status: 0 every file is on the registry, 1 otherwise.
set -euo pipefail
SCRIPT_NAME=mirror-shard
# shellcheck source=lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need curl jq awk sha256sum base64 xargs timeout

shard="${1:-}"
out="${2:-}"
if [ ! -f "$shard" ] || [ -z "$out" ]; then
  die "usage: scripts/mirror-shard SHARD.tsv OUT"
fi
[ -n "$MIRROR_NAMESPACE" ] || die "MIRROR_NAMESPACE is not set"
if [ "$MIRROR_REGISTRY_AUTH" != none ] && [ -z "${REGISTRY_TOKEN:-}" ]; then
  die "REGISTRY_TOKEN is not set; pushing needs one"
fi
PARALLEL="${PARALLEL:-4}"
case "$PARALLEL" in
  '' | *[!0-9]* | 0) die "PARALLEL must be a positive integer, not '$PARALLEL'" ;;
esac
DEBLOAT="${DEBLOAT:-auto}"
case "$DEBLOAT" in
  auto | always | never) ;;
  *) die "DEBLOAT must be auto, always or never, not '$DEBLOAT'" ;;
esac
GITHUB_RUN_ATTEMPT="${GITHUB_RUN_ATTEMPT:-1}"
case "$GITHUB_RUN_ATTEMPT" in
  '' | *[!0-9]* | 0) die "GITHUB_RUN_ATTEMPT must be a positive integer, not '$GITHUB_RUN_ATTEMPT'" ;;
esac
MIRROR_REPAIR="${MIRROR_REPAIR:-1}"
case "$MIRROR_REPAIR" in
  0 | 1) ;;
  *) die "MIRROR_REPAIR must be 0 or 1, not '$MIRROR_REPAIR'" ;;
esac
mkdir -p "$out"
plan_dir="$(dirname "$(dirname "$shard")")"
plan_id_file="$plan_dir/plan-id"
plan_id=""
if [ -f "$plan_id_file" ]; then
  plan_id="$(cat "$plan_id_file")"
else
  warn "$plan_id_file does not exist, so these results name no plan, and scripts/stage reads them only with a plan that names none"
fi
printf '%s\n' "$plan_id" > "$out/plan-id"
# The plan's INDEX_STATE, for the repush rule of scripts/mirror-file
INDEX_STATE=""
if [ -f "$plan_dir/meta.env" ]; then
  INDEX_STATE="$(awk 'index($0, "INDEX_STATE=") == 1 { v = substr($0, 13) } END { print v }' "$plan_dir/meta.env")"
fi
if [[ ! "$INDEX_STATE" =~ ^[a-z]+$ ]]; then
  INDEX_STATE=unknown
fi

lines="$(awk 'END { print NR + 0 }' "$shard")"
[ "$lines" -gt 0 ] || die "$shard has no work line"

#---------------------------------------------------------------------------#
# Where to work
#---------------------------------------------------------------------------#
free_of() {
  df --output=avail -B1 "$1" | awk 'NR == 2 { print $1 }'
}

best_dir=""
best_free=0
seen_devices=" "
for d in "${RUNNER_TEMP:-}" /mnt /tmp; do
  [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ] || continue
  dev="$(stat -c %d "$d")"
  case "$seen_devices" in
    *" $dev "*) continue ;;
  esac
  seen_devices="$seen_devices$dev "
  f="$(free_of "$d")"
  if [ "$f" -gt "$best_free" ]; then
    best_dir="$d"
    best_free="$f"
  fi
done
[ -n "$best_dir" ] || die "no writable work directory among \$RUNNER_TEMP, /mnt and /tmp"

# need_for P -> bytes the P largest files take at once, plus 1 GiB of room
need_for() {
  sort -t $'\t' -k5,5nr "$shard" | awk -F '\t' -v p="$1" 'NR <= p { s += $5 } END { printf "%.0f\n", s * 1.05 + 1073741824 }'
}

need="$(need_for "$PARALLEL")"
case "$DEBLOAT" in
  always) "$REPO_ROOT/scripts/debloat-runner" --dir "$best_dir" ;;
  auto)
    if [ "$best_free" -lt "$need" ]; then
      "$REPO_ROOT/scripts/debloat-runner" --need "$need" --dir "$best_dir"
    fi
    ;;
  never) ;;
esac
best_free="$(free_of "$best_dir")"
while [ "$PARALLEL" -gt 1 ] && [ "$best_free" -lt "$(need_for "$PARALLEL")" ]; do
  PARALLEL=$((PARALLEL - 1))
done
if [ "$best_free" -lt "$(need_for 1)" ]; then
  die "$best_dir has $((best_free / 1048576)) MiB free, and the largest file of this shard needs $(($(need_for 1) / 1048576)) MiB"
fi
log "$lines file(s), $PARALLEL at a time, in $best_dir ($((best_free / 1073741824)) GiB free); the plan's INDEX_STATE is $INDEX_STATE"

WORK="$(mktemp -d "$best_dir/mirror.XXXXXX")"
RESULTS="$out/lines"
rm -rf "$RESULTS"
mkdir -p "$RESULTS" "$WORK/items" "$WORK/bin"
REGISTRY_TOKEN_CACHE="$WORK/tokens"
mkdir -m 0700 "$REGISTRY_TOKEN_CACHE"
cleanup() {
  rm -rf "$WORK"
}
trap cleanup EXIT

#---------------------------------------------------------------------------#
# oras, logged in through a configuration file of its own that dies with the
# work directory, so the token never lands in ~/.docker.
#---------------------------------------------------------------------------#
ORAS="$("$REPO_ROOT/scripts/install-oras" "$WORK/bin")"
ORAS_CONFIG="$WORK/oras-auth.json"
oras_login "$ORAS" "$ORAS_CONFIG"
export RESULTS WORK ORAS ORAS_CONFIG SHARD_INDEX MIRROR_NAMESPACE REGISTRY_TOKEN_CACHE GITHUB_RUN_ATTEMPT MIRROR_REPAIR INDEX_STATE

#---------------------------------------------------------------------------#
# ⛔ The re-run guard: on a re-run, the live index, read once before the
# first file
#---------------------------------------------------------------------------#
if [ "$GITHUB_RUN_ATTEMPT" -gt 1 ] && ! index_guard "$plan_dir" "$WORK"; then
  log "attempt $GITHUB_RUN_ATTEMPT of this run: scripts/mirror-file writes no tag in this shard"
fi

rc=0
seq 1 "$lines" | xargs -d '\n' -n 1 -P "$PARALLEL" "$REPO_ROOT/scripts/mirror-file" "$shard" || rc=$?
case "$rc" in
  0 | 123) ;;
  124 | 125) warn "xargs stopped early (status $rc); the items it never started are counted as failed below" ;;
  *) warn "xargs ended with status $rc" ;;
esac

#---------------------------------------------------------------------------#
# Reconcile: one result per work line.
#---------------------------------------------------------------------------#
bad_count="$(reconcile_results "$shard" "$RESULTS" "$out/results.tsv")"
cp "$shard" "$out/work.tsv"
awk -F '\t' '{ n[$3]++ } END { for (s in n) printf "%s %d\n", s, n[s] }' "$out/results.tsv" | sort > "$out/summary.txt"
log "results: $(tr '\n' ' ' < "$out/summary.txt")"

if [ "$bad_count" -gt 0 ]; then
  # "absent" is not a failure (gone from upstream, 404 everywhere; skipped), so
  # it is left out of this list of the files that did fail.
  awk -F '\t' '$3 != "pushed" && $3 != "present" && $3 != "absent"' "$out/results.tsv" | sed -n 1,20p >&2
  die "$bad_count of $lines file(s) are not on the registry"
fi
